	{
		targetplayer = instance_nearest(x, y, obj_player);
		if ((targetplayer.x > (x - 1900) && targetplayer.x < (x + 1900)) && (y <= (targetplayer.y + 540) && y >= (targetplayer.y - 540)))
		{
			chasing = true;
			if (x != targetplayer.x)
				image_xscale = -sign(x - targetplayer.x);
			image_index = 0;
