					xscale *= -1;
				input_buffer_jump = 0;
				movespeed = hsp;
				jumpAnim = true;
				state = states.ratmountjump;
				vsp = -11;
				jumpstop = false;
			}
			if (((input_buffer_slap > 0 && key_up) || key_shoot2))
			{
				input_buffer_slap = 0;
				stick_popgun();
				movespeed = -movespeed;
				hsp = movespeed;
				ratmount_movespeed = 8;
				stickmach3 = false;
			}
			if (input_buffer_slap > 0 && !key_up)
			{
				particle_set_scale(particle.jumpdust, xscale, 1);
				create_particle(x, y, particle.jumpdust, 0);
