towershot.shake = 0;␀␀␀␀è␀␀live_auto_call;
switch state
{
	case states.normal:
		if buffer > 0
			buffer--;
		else
		{
			state++;
			doise.sprite_index = spr_playerD_finalattack2;
			doise.image_index = 0;
			pizzahead.image_xscale = -1;
			pizzahead.sprite_index = spr_pizzahead_phase3_intro3;
			pizzahead.image_index = 1;
			fmod_event_one_shot("event:/sfx/playerN/finale_outbomb");
			buffer = 100;
		}
		break;
	
	case states.revolver:
		with doise
		{
			if (sprite_index == spr_playerD_finalattack2 && anim_end())
				sprite_index = spr_playerD_finalattack3
			if (sprite_index == spr_playerD_finalattack3 && anim_end())
				sprite_index = spr_playerD_finalattack4
			if (sprite_index == spr_playerD_finalattack4 && anim_end())
				sprite_index = spr_playerD_finalattack5
		}
		
		if buffer > 0 && doise.sprite_index == spr_playerD_finalattack5
			buffer--;
		else if buffer <= 0
		{
			rock = instance_create(doise.x, doise.y, obj_finaleD_prop)
			rock.sprite_index = spr_playerD_giantrock
			state++;
			fmod_event_one_shot("event:/sfx/playerN/giantbombthrow");
			doise.sprite_index = spr_playerD_finalattack6;
			doise.image_index = 0;
			doise_hsp = -4
			doise_vsp = -6
			if global.swapmode
			{
				spr_swapplayerprop();
				peppinoID.sprite_index = spr_move;
				peppinoID.image_xscale = -1;
				peppinoID.image_index = 0;
				peppinoID.hsp = -6;
			}
			rock.vsp = -6.5;
			rock.hsp = 2;
			rock.count = 0;
			rock.grav = 0.07;
			whitefade = -0.5;
		}
		break;
	
	case states.dynamite:
		if (floor(doise.image_index) == doise.image_number - 1)
			doise.image_index = doise.image_number - 1;
		doise_vsp += doise_grav
		doise.collide = true;
		doise.x += doise_hsp
		doise.y += doise_vsp
		whitefade = Approach(whitefade, 1, 0.009);
		with rock
		{
			vsp += grav
			x += hsp;
			y += vsp;
			if vsp > 0 && alarm[0] == -1
			{
				alarm[0] = 12 - min(floor(count), 8);
				count++;
			}
			if (vsp >= 0 && x > ((room_width / 2) + 50))
			{
				with other
				{
					state++;
					pizzaheadshot = instance_create(0, 0, obj_finaleD_prop);
					pizzaheadshot.sprite_index = bg_pizzaheadshotD;
					pizzaheadshot.depth = -100;
					pizzaheadshot.image_speed = 1;
					fmod_event_instance_play(pizzaheadshot_snd);
					with obj_music
					{
						if music != noone
							fmod_event_instance_stop(music.event, false);
					}
				}
				layer_set_visible("Backgrounds_rain", false);
			}
		}
		break;
		
	case states.boots:
		shake = Approach(shake, shake_max, 0.1);
		if (floor(pizzaheadshot.image_index) < 24)
			whitefade = Approach(whitefade, 0, 0.05);
		if (floor(pizzaheadshot.image_index) >= 24)
		{
			whitefadeaccel = (sprite_get_speed(bg_pizzaheadshotD) / 60) / (sprite_get_number(bg_pizzaheadshotD) - pizzaheadshot.image_index);
			if whitefade <= 1
				whitefade += whitefadeaccel;
		}
		if (floor(pizzaheadshot.image_index) == pizzaheadshot.image_number - 1)
		{
			instance_destroy(pizzaheadshot);
			with obj_music
			{
				if music != noone
					fmod_event_instance_stop(music.event, true);
			}
			bg1.visible = true;
			bg2.visible = true;
			bg3.visible = true;
			bg4.visible = true;
			towershot.visible = true;
			buffer = 90;
			state++;
			shake = 0;
			whitefade = 1;
		}
		break;
	
	case states.grabbed:
		whitefade = Approach(whitefade, 0, 0.05);
		if buffer > 0
			buffer--;
		else
		{
			fmod_event_one_shot("event:/sfx/playerN/finale_explosion");
			buffer = 120;
			state++;
			towershot.sprite_index = bg_towershotN;
			shake = shake_max;
		}
		break;
	
	case states.tumble:
		if buffer > 0
			buffer--;
		else if whitefade <= 1
			whitefade += 0.07;
		else
		{
			with instance_create(0, 0, obj_pizzahead_whitefade)
			{
				persistent = true;
				whitefade = 1.3;
				deccel = 0.005;
			}
			room = boss_pizzafacehub;
		}
		break;
}

bg1.x += bg1.hsp;
bg2.x += bg2.hsp;
bg3.x += bg3.hsp;
