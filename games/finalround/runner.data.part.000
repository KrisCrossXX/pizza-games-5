			if (sprite_index != obj_player1.spr_land)
			{
				if (x != xprevious)
					sprite_index = spr_doug_walk;
				else
					sprite_index = spr_doug_idle;
			}
			else if (floor(image_index) == (image_number - 1))
				sprite_index = spr_doug_idle;
			if (sprite_index == obj_player1.spr_move)
			{
				if (!steppy && (floor(image_index) == 2 || floor(image_index) == 7))
				{
					steppy = true;
					create_particle(x, y + 38, particle.cloudeffect, 0);
				}
				if (steppy && floor(image_index) != 2 && floor(image_index) != 7)
					steppy = false;
			}
			if (!grounded)
			{
				state = states.jump;
				if (vsp < 0)
				{
					with (instance_create(x, y, obj_highjumpcloud1))
					{
						if (scr_solid(x, y + 64))
						{
							while (!scr_solid(x, y + 1))
								y++;
						}
					}
					sprite_index = obj_player1.spr_jump;
					image_index = 0;
				}
				else
				{
					sprite_index = obj_player1.spr_fall;
					image_index = 0;
				}
			}
			break;
		
		case states.jump:
			if (floor(image_index) == (image_number - 1))
			{
				if (sprite_index == obj_player1.spr_jump)
					sprite_index = obj_player1.spr_jump;
				else if (sprite_index == obj_player1.spr_jump)
					sprite_index = obj_player1.spr_fall;
			}
			if (grounded && vsp > 0)
			{
				create_particle(x, y, particle.landcloud, 0);
				sprite_index = obj_player1.spr_fall;
				image_index = 0;
				state = states.normal;
			}
			break;
			
		case states.crouch:
			if (sprite_index != obj_player1.spr_couchstart)
