			sprite_index = spr_lonegustavofall;
		if (sprite_index != spr_lonegustavokick)
			sprite_index = spr_lonegustavo_mushroom;
		state = states.ratmount;
	}
	image_speed = 0.35;
	if (punch_afterimage > 0)
		punch_afterimage--;
	else
	{
		punch_afterimage = 5;
		with (create_mach3effect(x, y, sprite_index, image_index, true))
			image_xscale = other.xscale;
	}
}
