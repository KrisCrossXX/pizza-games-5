					scr_player_addslopemomentum(slopeaccel, slopedeccel);
			}
			if (move == xscale && grounded)
			{
				if (movespeed < mach4movespeed)
				{
					if !mach4mode
						movespeed += accel;
					else
						movespeed += mach4accel;
				}
			}
			mach2 = 100;
			momemtum = true;
			move = key_right + key_left;
			move2 = key_right2 + key_left2;
			if fightball
			{
				if (object_index == obj_player1)
				{
					x = obj_player2.x;
					y = obj_player2.y;
				}
				if (object_index == obj_player2)
				{
					x = obj_player1.x;
					y = obj_player1.y;
				}
			}
			if (sprite_index == spr_crazyrun)
			{
				if (flamecloud_buffer > 0)
					flamecloud_buffer--;
				else
				{
					flamecloud_buffer = 10;
					with (instance_create(x, y, obj_dashcloud))
					{
						image_xscale = other.xscale;
						sprite_index = spr_flamecloud;
					}
				}
			}
			crouchslideAnim = true;
			if (!key_jump2 && jumpstop == 0 && vsp < 0.5)
			{
				vsp /= 20;
				jumpstop = true;
			}
			if (grounded && vsp > 0)
				jumpstop = false;

			if input_buffer_jump > 0 && sprite_index != spr_mach3jump && can_jump && !(move == 1 && xscale == -1) && !(move == -1 && xscale == 1)
			{
				if sprite_index == spr_playerM_diveland
				{

					//global.coop_cancelgroundpound = false;
					input_buffer_jump = 0
					sprite_index = spr_playerM_rolling
					image_index = 0
					fmod_event_one_shot_3d("event:/sfx/playerM/groundpoundjump", x, y);
					particle_set_scale(particle.highjumpcloud2, xscale, 1);
					create_particle(x, y, particle.highjumpcloud2, 0);
					vsp = -20
					movespeed = 15*xscale
					hsp = movespeed
					if (place_meeting(x, y + 1, obj_railparent))
						railmomentum = true;
					freefallstart = 0;
					state = states.pepperbounce
					pepperman_sjumptimer = 78;
					exit;
					
				}
				input_buffer_jump = 0;
				scr_fmod_soundeffect(jumpsnd, x, y);
				particle_set_scale(particle.jumpdust, xscale, 1);
				create_particle(x, y, particle.jumpdust, 0);
				if sprite_index != spr_fightball && sprite_index != spr_playerM_diveland
				{
					image_index = 0;
					sprite_index = spr_mach3jump;
				}
				vsp = jumpspeed;
			}
			
			if !fightball
			{
				if anim_end() && sprite_index == spr_playerM_BintoSBtrans
					sprite_index = spr_mach3jump;
				if sprite_index == spr_mach3jump && anim_end()
					sprite_index = mach3_spr;
				if sprite_index == spr_playerM_wallboost && anim_end()
					sprite_index = spr_playerM_wallboostloop;
				if sprite_index == spr_playerV_longkick && anim_end()
					sprite_index = spr_playerV_longkickend;
				if (sprite_index == spr_superjumpcancel || sprite_index == spr_playerM_wallboost || sprite_index == spr_playerM_wallboostloop || sprite_index == spr_playerV_Sjumpcancelfall) && grounded
					sprite_index = mach3_spr;
				if anim_end() && (sprite_index == spr_rollgetup || sprite_index == spr_mach3hit || sprite_index == spr_dashpadmach || sprite_index == spr_playerV_diverollgetup)
					sprite_index = mach3_spr;
				if sprite_index == spr_mach2jump && grounded && vsp > 0
					sprite_index = mach3_spr;
				if sprite_index == spr_rockethitwall && grounded
					sprite_index = mach3_spr;
				if sprite_index == spr_playerN_sidewayspin && anim_end()
					sprite_index = spr_playerN_sidewayspinend;
				if grounded && (sprite_index == spr_playerN_sidewayspin || sprite_index == spr_playerN_sidewayspinend)
					sprite_index = mach3_spr;
				if anim_end() && sprite_index == spr_playerD_mach3doublejump
					sprite_index = spr_playerD_mach3doublejumpfall;
				if anim_end() && sprite_index == spr_playerM_diveland
					sprite_index = spr_playerM_shoulderloop;
				
				if (movespeed > mach3movespeed && sprite_index != spr_crazyrun && sprite_index != spr_playerM_diveland && sprite_index != spr_superjumpcancelstart && sprite_index != spr_taunt && sprite_index != spr_playerM_grabintorolltrans && sprite_index != spr_playerV_Sjumpcancelfall)
				{
					mach4mode = true;
					flash = true;
					sprite_index = spr_crazyrun;
				}
				else if (movespeed <= mach3movespeed && sprite_index == spr_crazyrun)
					sprite_index = mach3_spr;
			}
			if (sprite_index == spr_crazyrun && !instance_exists(crazyruneffectid))
			{
				with (instance_create(x, y, obj_crazyrunothereffect))
				{
					playerid = other.object_index;
					other.crazyruneffectid = id;
				}
			}
			if (sprite_index == spr_mach4 || sprite_index == spr_fightball)
				image_speed = 0.4;
			else if (sprite_index == spr_crazyrun)
				image_speed = 0.75;
			else if (sprite_index == spr_rollgetup || sprite_index == spr_mach3hit || sprite_index == spr_dashpadmach || sprite_index == spr_playerV_diverollgetup)
				image_speed = 0.4;
			if (!key_attack && !fightball && !launched) && sprite_index != spr_dashpadmach && sprite_index != spr_rockethitwall && grounded && vsp > 0
			{
				sprite_index = spr_machslidestart;
				if character != "N" && character != "D"
					fmod_event_one_shot_3d("event:/sfx/pep/break", x, y);
				else
					fmod_event_one_shot_3d("event:/sfx/playerN/break", x, y);
				state = states.machslide;
				image_index = 0;
				launched = false;
			}
			if (move == -xscale && grounded && vsp > 0 && !launched && !fightball && sprite_index != spr_dashpadmach && sprite_index != spr_rockethitwall)
			{
				if character != "N" && character != "M" && character != "D"
					fmod_event_one_shot_3d("event:/sfx/pep/machslideboost", x, y);
				else if character == "N" || character == "D"
					fmod_event_one_shot_3d("event:/sfx/playerN/machslide", x, y);
				else
					fmod_event_one_shot_3d("event:/sfx/pepperman/turn", x, y);
				sprite_index = spr_mach3boost;
				state = states.machslide;
				image_index = 0;
			}
			if sprite_index != spr_playerM_diveland || sprite_index == spr_playerM_diveland && !grounded
			{
				if ((scr_mach_check_dive() && !fightball && sprite_index != spr_dashpadmach && !(sprite_index == spr_playerV_longkick && image_index < 4) && character != "S") || (scr_mach_check_dive() && !fightball && sprite_index != spr_dashpadmach && character == "S" && !grounded) && sprite_index != spr_playerM_diveland)
				{
					particle_set_scale(particle.jumpdust, xscale, 1);
					create_particle(x, y, particle.jumpdust, 0);
					flash = false;
					state = states.tumble;
					image_index = 0;
					vsp = machrollspeed;
					if sprite_index == spr_playerV_longkick || sprite_index == spr_playerV_longkickend
						movespeed = 13
					if character != "M" 
					{
						if (!grounded)
							sprite_index = spr_mach2jump;
						else
							sprite_index = character == "V" ? spr_playerV_divekickstart : spr_machroll;
					}
					if character == "M"
					{
						if movespeed < 8
							movespeed = 12;
						if sprite_index != spr_playerM_wallboost && sprite_index != spr_playerM_wallboostloop && grounded
							sprite_index = spr_playerM_shoulderslidedown;
						else if (sprite_index == spr_playerM_wallboost || sprite_index == spr_playerM_wallboostloop) && !grounded
							sprite_index = spr_playerM_wallboostdive;
						else if sprite_index == spr_playerM_grabintorolltrans
							sprite_index = spr_playerM_dive;
						else
							sprite_index = spr_playerM_superdive;
						vsp = 13;
						pepperman_groundpoundjump = true;
					}
				}
			}
			if (character != "M" && ((!grounded && (place_meeting(x + hsp, y, obj_solid) || scr_solid_slope(x + hsp, y)) && !place_meeting(x + hsp, y, obj_destructibles) && !place_meeting(x + hsp, y, obj_mach3solid) && !place_meeting(x + hsp, y, obj_metalblock)) || (grounded && (place_meeting(x + sign(hsp), y - 16, obj_solid) || scr_solid_slope(x + sign(hsp), y - 16)) && !place_meeting(x + hsp, y, obj_destructibles) && !place_meeting(x + hsp, y, obj_mach3solid) && !place_meeting(x + hsp, y, obj_metalblock) && place_meeting(x, y + 1, obj_slope))) || character == "M" && ((!grounded && (place_meeting(x + hsp, y, obj_solid) || scr_solid_slope(x + hsp, y)) && !place_meeting(x + hsp, y, obj_destructibles) && !place_meeting(x + sign(hsp), y, obj_asteroid) && !place_meeting(x + sign(hsp), y, obj_timedgate) && !place_meeting(x + sign(hsp), y, obj_iceblock_breakable) && !place_meeting(x + hsp, y, obj_mach3solid) && !place_meeting(x + hsp, y, obj_metalblock)) || (grounded && (place_meeting(x + sign(hsp), y - 16, obj_solid) || scr_solid_slope(x + sign(hsp), y - 16)) && !place_meeting(x + hsp, y, obj_destructibles) && !place_meeting(x + sign(hsp), y, obj_asteroid) && !place_meeting(x + sign(hsp), y, obj_timedgate) && !place_meeting(x + sign(hsp), y, obj_iceblock_breakable) && !place_meeting(x + hsp, y, obj_mach3solid) && !place_meeting(x + hsp, y, obj_metalblock) && place_meeting(x, y + 1, obj_slope))))
			{
				var _climb = true;
				if character == "N" || character == "D" || character == "M"
					_climb = ledge_bump(40, abs(hsp) + 1);
				if _climb
				{
					if mach4mode && character == "D"
					{
						with obj_camera
						{
							shake_mag = 20;
							shake_mag_acc = 40 / room_speed;
						}
						state = states.slipbanan;
						sprite_index = spr_rockethitwall;
						hsp = -4.5 * xscale;
						vsp = -7;
						instance_create(x, y, obj_playerexplosion);
						if input_buffer_jump > 0
							state = states.climbwall;	
					}
					else 
					{
						wallspeed = movespeed;
						grabclimbbuffer = 0;
						if movespeed < 1
							wallspeed = 1;
						else
							movespeed = wallspeed;
						state = states.climbwall;
					}
