			l_i=0;
			with (l_ctx) {
				l_arr[@l_i]=self;
				l_i++;
			}
			l_scope[@7]=new gml_with_scope({length:l_i,items:l_arr,refc:1},l_scope[7]);
		}
	} else {
		l_arr=vm__gml_with_data_gml_with_data_impl__alloc(1);
		l_i=0;
		with (l_ctx) {
			l_arr[@l_i]=self;
			l_i++;
		}
		l_scope[@7]=new gml_with_scope({length:l_i,items:l_arr,refc:1},l_scope[7]);
	}
	var l_inst=l_scope[6];
	var l_i=l_inst[0]+1;
	if(l_i>=array_length(l_inst))l_inst[@array_length(l_inst)*2]=0;
