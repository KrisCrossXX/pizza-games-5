tutorial17 = "Essaie de tourner avant de tomber dans un trou, cela te permettra de garder ta vitesse une fois au sol."
tutorial18 = "Maintiens [s] appuyÃ© lorsque tu as atteint une vitesse Ã©levÃ©e pour effectuer un super saut ! Tu peux Ã©galement ajuster ta position avec [L][R] tout en maintenant [s] appuyÃ©."
tutorial19 = "Une fois le super saut lancÃ©, tu peux te ruer vers l'avant dans les airs en appuyant sur [G]. Essaie pour voir !"
tutorial20 = "Autre astuce : Appuie sur [G] suivi immÃ©diatement de [D] pour traverser plus rapidement les trous."
tutorial21 = "Tu peux attraper des choses avec l'empoigne et les jeter en rappuyant sur [G]."
tutorial22 = "Si tu maintiens [U] appuyÃ© avant un jet, ce que tu as attrapÃ© sera jetÃ© vers le haut."
tutorial23 = "Ramasse ceci pour obtenir un meilleur rang. Certains ne peuvent Ãªtre rÃ©cupÃ©rÃ©s que pendant la fuite..."
tutorial24 = "Tu dois sauver la plupart des petits gars enfermÃ©s dans les cages pour passer Ã  l'Ã©tage suivant. Ils te donneront de l'argent pour payer M. Stick. Si tu en oublies trop, il te faudra recommencer certains niveaux !"
tutorial25 = "DÃ©truis John le pilier pour ouvrir la porte de sortie : cela solidifiera les blocs qui Ã©taient jusqu'alors transparents et inversement !"
