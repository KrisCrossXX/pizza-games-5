//buffers
if (optionbuffer > 0)
	optionbuffer--;
if (quitbuffer > 0)
	quitbuffer--;	
	
//animating tvs
frame += 0.35
if frame >= 2
	frame = 0;

savegame = global.game[file];

if !tvstatic && state != states.victory
{
	if (fmod_event_instance_is_playing(staticsnd))
		fmod_event_instance_stop(staticsnd, true);
	if savegame.started = true
	{
		ini_open(concat("saves/saveData",file + 1, ".ini"));
		characterselected = ini_read_string("Game", "character", "P");
		ini_close();
	}
	switch characterselected
	{
		case "P":
			tvsprite = spr_tvmm_idleP
			spr_palette = spr_peppalette;
			spr_tvselect = spr_tvmm_selectP;
			break;
			
		case "M":
			tvsprite = spr_tvmm_idleM;
			spr_palette = spr_peppermanpalette
			spr_tvselect = spr_tvmm_selectM;
			break;
			
		case "V":
			tvsprite = spr_tvmm_idleV;
			spr_palette = spr_vigilantepalette
			spr_tvselect = spr_tvmm_selectV;
			break;
			
		case "N":
			tvsprite = spr_tvmm_idleN;
			spr_palette = spr_noisepalette;
			spr_tvselect = spr_tvmm_selectN;
			break;
			
		case "S":
			tvsprite = spr_tvmm_idleS;
			spr_palette = spr_snickpalette;
			spr_tvselect = spr_tvmm_selectS;
			break;
			
		case "NS":
			tvsprite = spr_tvmm_idleNS;
			spr_palette = spr_noisettepalette;
			spr_tvselect = spr_tvmm_selectNS;
			break;
			
		case "D":
			tvsprite = spr_tvmm_idleD;
			spr_palette = spr_doisepalette;
			spr_tvselect = spr_tvmm_selectD;
			break;
			
		case "FP":
			tvsprite = spr_tvmm_idleFP;
			spr_palette = spr_peppalette;
			spr_tvselect = spr_tvmm_selectP;
			break;
	}
}
else
{
	if state != states.victory
		tvsprite = spr_tvmm_static;
}

switch state
{
	/*case 1000000:
		lockedinputs = true;
		if (global.loginAccepted)
		{
			obj_mainmenu_FR.state = states.titlescreen;
			fmod_event_one_shot("event:/sfx/misc/kashing");
			global.loginAccepted = true;
			return;
		}
		create_textinput();
		state = 1000001;
		break;*/
	case 1000001:
		break;
	case states.normal:
		fadealpha = approach(fadealpha, 1, 0.1)
		if (!lockedinputs)
		{
			// opens option menu
			if (key_start && optionbuffer <= 0 && !instance_exists(obj_option))
			{
				state = states.titlescreen
				lockedinputs = true;
				with (instance_create(0, 0, obj_option))
					backbuffer = 2;
			}
			else if instance_exists(obj_option)
				quitbuffer = 3;
			
			// GO IN THE GAME !!!!
			if (key_jump2 && !startup && !tvstatic && state != states.transition)
			{
				state = states.victory;
				tvsprite = spr_tvselect;
				fmod_event_instance_stop(obj_music.music.event, true);
				alarm[3] = 250;
				if tvsprite == spr_tvmm_selectN || tvsprite == spr_tvmm_selectD
				{
					if tvsprite == spr_tvmm_selectD
					{
						fmod_event_one_shot("event:/sfx/playerN/supernoiseeffect");
						with(instance_create_unique(0, 0, obj_doisebg))
						{
							image_alpha = 0;
							depth = -100;
						}
					}
					else
					{
						fmod_event_one_shot("event:/sfx/ui/fileselectN");
						alarm[4] = 5;
						timermax = 15;
						explosionsnum = 1;
						fmod_event_one_shot("event:/sfx/ui/menuexplosions");
					}
				}
				else
					fmod_event_one_shot("event:/sfx/ui/fileselect");
					
				fmod_event_one_shot("event:/sfx/misc/collectpizza");
			}
			
			// leave... video game...
			else if key_quit2
			{
				if (quitbuffer <= 0)
				{
					state = states.ending;
					lockedinputs = true;
					exitselect = 1;
				}
			}
			
			// actual like tv controls
			function transition(dir, target_x1, target_y1, target_x2, target_y2, target_x3, target_y3, target_x4, target_y4) {
				fmod_event_instance_play(flipsnd);
				state = states.transition;
				x1 = target_x1;
				y1 = target_y1;
				x2 = target_x2;
				y2 = target_y2;
				x3 = target_x3;
				y3 = target_y3;
				x4 = target_x4;
				y4 = target_y4;
				alarm[0] = 15;
			}
			if !tvstatic
			{
				if (key_right2)
				{
					dir = "right";
					transition(dir, xlft, ylft, xcur, ycur, xrght, yrght, 1080, yrght);
					if (file == 9)
						file = 0;
					else
						file++;
				}
				else if (key_left2 == -1)
				{
					dir = "left";
					transition(dir, 164, -460, xlft, ylft, xcur, ycur, xrght, yrght);
					if (file == 0)
						file = 9;
					else
						file--;
				}
			}
			
			// change characters
			// if this gets changed again i may consider skinning whoever does -Compwnter
			if !savegame.started
			{
				if (key_down2)
				{
					if !(fmod_event_instance_is_playing(staticsnd))
						fmod_event_instance_play(staticsnd);
					tvstatic = true;
					alarm[1] = 12;
					/*switch characterselected // for demo
					{
						case "P": characterselected = "N"; break;
						case "N": characterselected = "D"; break;
						case "D": characterselected = "P"; break;
					}*/
					switch characterselected
					{
						case "P":
							characterselected = "N"
							break
						case "N":
							characterselected = "D"
							break
						case "D":
							characterselected = "M"
							break
						case "M":
							characterselected = "V"
							break
						case "V":
							characterselected = "FP"
							break
						case "FP":
							characterselected = "NS"
							break
						case "NS":
							characterselected = "S"
							break
						case "S":
							characterselected = "P"
							break
					}
				}
				else if (key_up2)
				{
					if !(fmod_event_instance_is_playing(staticsnd))
						fmod_event_instance_play(staticsnd);
					tvstatic = true;
					alarm[1] = 12;
					/*switch characterselected // for demo
					{
						case "P": characterselected = "D"; break;
						case "N": characterselected = "P"; break;
						case "D": characterselected = "N"; break;
					}*/
					switch characterselected
					{
						case "P":
							characterselected = "S"
							break
						case "N":
							characterselected = "P"
							break
						case "D":
							characterselected = "N"
							break
						case "M":
							characterselected = "D"
							break
						case "V":
							characterselected = "M"
							break
						case "FP":
							characterselected = "V"
							break
						case "NS":
							characterselected = "FP"
							break
						case "S":
							characterselected = "NS"
							break
					}
				}
			}
			
			// DELETE YOUR SAVE FILE!!!!!!!!
			if keyboard_check_pressed(ord("C"))
			{
				state = states.dead;
				delselect = 1;
				lockedinputs = true;
			}
			
			// import your save file... ... ...
			if keyboard_check_pressed(ord("V"))
			{
				state = states.portal;
				lockedinputs = true;
			}
		}
	break;
	
	case states.transition:
		var target_x1 = dir = "right" ? 164 : xlft;
		var target_y1 = dir = "right" ? -300 : ylft;
		var target_x2 = dir = "right" ? xlft : xcur;
		var target_y2 = dir = "right" ? ylft : ycur;
		var target_x3 = dir = "right" ? xcur : xrght;
		var target_y3 = dir = "right" ? ycur : yrght;
		var target_x4 = dir = "right" ? xrght : 1080;
		var target_y4 = yrght; // same thing ig
		
		x1 = lerp(x1, target_x1, 0.4);
		y1 = lerp(y1, target_y1, 0.4);
		x2 = lerp(x2, target_x2, 0.4);
		y2 = lerp(y2, target_y2, 0.4);
		x3 = lerp(x3, target_x3, 0.4);
		y3 = lerp(y3, target_y3, 0.4);
		x4 = lerp(x4, target_x4, 0.4);
		y4 = lerp(y4, target_y4, 0.4);
	break;
		
	case states.ending:
		exitselect += (key_left2 + key_right2)
		exitselect = clamp(exitselect, 0, 1)
		if key_jump
		{
			if (exitselect == 0)
				game_end()
			else
			{
				alarm[5] = 30;
				state = states.normal
			}
		}
	break;
	
	case states.dead:
		delselect += (key_left2 + key_right2)
		delselect = clamp(delselect, 0, 1)
		if key_jump
		{
			if (delselect == 0)
			{
				fmod_event_one_shot("event:/sfx/misc/collectpizza");
				var file2 = concat(get_save_folder(), "/saveData", file + 1, ".ini");
				if file_exists(file2)
					file_delete(file2);
				global.game[file + 1] = game_empty();
				alarm[5] = 30;
				state = states.normal
			}
			else
			{
				fmod_event_one_shot("event:/sfx/ui/back");
				alarm[5] = 30;
				state = states.normal
			}
		}
	break;
	
	case states.portal:
		if (!almost)
		{
			if (key_up2 && cursel != 0)
				cursel--;
			else if (key_down2 && cursel != 5)
				cursel++;
				
			if (key_jump)
			{
				fmod_event_one_shot("event:/sfx/misc/collectpizza");
				fileselected = cursel;
				cursel = 0;
				almost = true;
			}
		}
		else
		{
			if (key_up2 && cursel != 0)
				cursel--;
			else if (key_down2 && cursel != 9)
				cursel++;
			if (key_jump)
			{
				fmod_event_one_shot("event:/sfx/misc/collectpizza");
				if (file_exists(get_save_folder() + "/saveData" + string(cursel+1) + ".ini"))
					file_delete(get_save_folder() + "/saveData" + string(cursel+1) + ".ini");
				file_copy(environment_get_variable("APPDATA") + "/PizzaTower_GM2/saves/saveData" + string(fileselected+1) + ".ini", get_save_folder() + "/saveData" + string(cursel+1) + ".ini");
				ini_open(get_save_folder() + "/saveData" + string(cursel+1) + ".ini");
				ini_write_string("Game", "character", (fileselected <= 2 ? "P" : "N"));
				ini_close();
				alarm[5] = 30;
				state = states.normal;
			}
		}
		if (key_back) 
		{
			if (!almost)
			{
				fmod_event_one_shot("event:/sfx/ui/back");
				alarm[5] = 30;
				state = states.normal;
			}
			else
			{
				fmod_event_one_shot("event:/sfx/ui/back");
				almost = false;
				cursel = 0;
			}
		}
	break;
}

if (state != states.titlescreen && state != states.transition)
	obj_newmenu.extrauialpha = Approach(obj_newmenu.extrauialpha, 1, 0.1);
␀␀␀␀‚␀␀if state != states.titlescreen
{
