				image_index = 0;
			}
			ratmount_dotaunt();
			break;
		#endregion
		#region Ratmountpunch (Punch)
		case states.ratmountpunch:
			image_speed = .35;
			hsp = movespeed;
			move = key_left + key_right;
			landAnim = false;
