		if (_switch)
		{
			scene++;
			scenebuffer = 60;
			instance_destroy(obj_introprop);
			peppino = instance_create(200, 386, obj_playerprop);
			peppino.fake_hsp = 12;
			peppino.alarm[0] = 1;
			peppino.sprite_index = spr_player_mach;
