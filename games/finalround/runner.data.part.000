	ds_map_set(global.lang_sprite_map, language, ds_map_create());
	var jsonsarr = []
	for (var filer = file_find_first($"lang/graphics/{language}/*.json", fa_none); filer != ""; filer = file_find_next())
		array_push(jsonsarr, $"lang/graphics/{language}/{filer}")
	file_find_close()
	var customs = []
	for (var filere = file_find_first($"lang/graphics/{language}/custom/*.json", fa_none); filere != ""; filere = file_find_next())
	{
		array_push(jsonsarr, $"lang/graphics/{language}/custom/{filere}")
		array_push(customs, array_last(jsonsarr))
	}
	file_find_close()
	for (var readed = 0; readed < array_length(jsonsarr); readed++)
	{
		var file = file_text_open_read(jsonsarr[readed]), str = "";
    
		while (!file_text_eof(file))
		{
			str += file_text_readln(file);
			str += "\n";
		}
		
		file_text_close(file)
		var laststr = array_last(string_split(jsonsarr[readed], "/"))
		var struct = json_parse(str), name = string_trim(laststr, [".json"]), asset = asset_get_index(name);
		struct.name = name
		struct.custom = array_contains(customs, jsonsarr[readed])
		if asset <= -1
			continue;
		ds_map_set(ds_map_find_value(global.lang_sprite_map, language), asset, struct);
		if (ds_list_find_index(global.lang_textures_to_load, $"{language}/{struct.custom ? "custom/" : "/"}{name}.png") == -1)
            ds_list_add(global.lang_textures_to_load, $"{language}/{struct.custom ? "custom/" : "/"}{name}.png");
	}
}

function lang_draw_sprite_ext(sprite, img, X, Y, xscale, yscale, rot, blend, alpha)
{
    var spr, frame, texture, w, h, offset;
    
    spr = lang_get_sprite(sprite);
    
    if (spr != -4)
    {
        img = floor(img);
        frame = lang_get_frame(spr, img);
        texture = lang_get_texture($"{global.lang}/{spr.custom ? "custom/" : "/"}{spr.name}.png");
        
        if !is_undefined(texture)
        {
            w = frame.width;
            h = frame.height;
            offset = frame.offset;
            
            if (w == -1)
                w = sprite_get_width(texture);
            
            if (h == -1)
                h = sprite_get_height(texture);
            
            draw_sprite_part_ext(texture, 0, frame.x, frame.y, w, h, X - offset.x, Y - offset.y, xscale, yscale, blend, alpha);
        }
    }
    else
        draw_sprite_ext(sprite, img, X, Y, xscale, yscale, rot, blend, alpha);
}

function lang_draw_sprite(spr, img, X, Y)
{
    var color, alpha;
    
    color = draw_get_color();
    alpha = draw_get_alpha();
    lang_draw_sprite_ext(spr, img, X, Y, 1, 1, 0, color, alpha);
}

function lang_get_sprite(sprite)
{
    var g;
    
    if (lang_get_value("custom_graphics"))
    {
        g = ds_map_find_value(ds_map_find_value(global.lang_sprite_map, global.lang), sprite);
        
        if (!is_undefined(g))
            return g;
    }
    
    return -4;
}

function lang_get_frame(sprite, frame)
{
    if (sprite == noone || array_length(sprite.frames) == 0)
        return noone;
    
    frame = floor(frame);
    frame %= array_length(sprite.frames);
	
    frame = clamp(frame, 0, array_length(sprite.frames) - 1)
    
    return sprite.frames[frame];
}

function lang_get_texture(tex)
{
    var g;
    
    g = ds_map_find_value(global.lang_texture_map, tex);
    
    if (!is_undefined(g))
        return g;
    
    return noone;
}
