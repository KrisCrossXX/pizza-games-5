			ds_list_add(l_start,l_thing);
		} else if(l_cur!=l_val1){
			ds_map_set(l_map,l_thing,l_val1);
			l_i=ds_list_find_index(l_stop,l_thing);
			if(l_i<0)ds_list_add(l_stop,l_thing);
