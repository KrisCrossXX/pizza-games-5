{
	case states.normal:
		x = lerp(x, tx, acc);
		y = lerp(y, ty, acc);
		if (alarm[0] == -1 && x > (tx - 8) && x < (tx + 8) && y > (ty - 8) && y < (ty + 8))
		{
			alarm[0] = 50;
			x = tx;
			y = ty;
			state = states.transition;
		}
		break;
	
	case states.transition:
		x = lerp(x, tx, 0.2);
		y = lerp(y, ty, 0.2);
		break;
	
	case states.jump:
		x += 4;
		y -= 8;
		if (!bbox_in_camera(view_camera[0], 10))
			instance_destroy();
		break;
}
