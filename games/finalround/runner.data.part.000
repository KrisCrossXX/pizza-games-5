␀›␀␀function scr_player_handstandjump()
{
	landAnim = false;
	hsp = xscale * movespeed;
	move = key_left + key_right;
	momemtum = true;
	dir = xscale;
	if global.attackstyle != 3
	{
		if movespeed < 10
		{
			if (sprite_index == spr_pistolshot || sprite_index == spr_playerD_pistolshot || sprite_index == spr_shotgun_shot) && movespeed < 8
				movespeed += 0.25;
			else if sprite_index == spr_player_lunge && movespeed < 12
				movespeed += 0.8;
			else if movespeed < 10
				movespeed += 0.5;
		}
	}
	else
	{
		if movespeed < 10
		{
			if (sprite_index == spr_pistolshot || sprite_index == spr_playerD_pistolshot || sprite_index == spr_shotgun_shot) && movespeed < 8
				movespeed += 0.25;
			else if movespeed < 10
				movespeed += 0.5;
		}
		if global.pummeltest && !instance_exists(lungeattackID)
		{
			with instance_create(x, y, obj_lungehitbox)
			{
				playerid = other.id;
				other.lungeattackID = id;
			}
		}
	}
	if shoot
		var attackdash = character == "D" && room == boss_vigilante ? spr_playerD_pistolshot :  spr_pistolshot;
	else
		attackdash = spr_suplexdash;
	if sprite_index == spr_player_lungestart && anim_end()
		sprite_index = spr_player_lunge;
	var airattackdash = spr_suplexdashjump;
	var airattackdashstart = spr_suplexdashjumpstart;
	if global.attackstyle == 2
		vsp = 0;
	if !key_jump2 && jumpstop == 0 && vsp < 0.5 && !stompAnim
	{
		vsp /= 20;
		jumpstop = true;
	}
	if (input_buffer_jump > 0 && can_jump && !key_down && global.attackstyle != 2 && character != "M")
	{
		fmod_event_instance_play(rollgetupsnd);
		input_buffer_jump = 0;
		particle_set_scale(particle.jumpdust, xscale, 1);
		create_particle(x, y, particle.jumpdust, 0);
		jumpstop = false;
		image_index = 0;
		if movespeed < 10
			movespeed = 10;
		vsp = -11;
		state = states.mach2;
		sprite_index = spr_longjump;
	}
	if (input_buffer_jump > 0 && can_jump && !key_down && global.attackstyle != 2 && character == "M")
	{
		fmod_event_instance_play(rollgetupsnd);
		input_buffer_jump = 0;
		particle_set_scale(particle.jumpdust, xscale, 1);
		create_particle(x, y, particle.jumpdust, 0);
		jumpstop = false;
		image_index = 0;
		vsp = -11;
		if movespeed < 10
			movespeed = 10;
		movespeed = movespeed*xscale
		pepperman_grounded = false;
		state = states.pepperbounce;
		sprite_index = spr_playerM_longjump;
	}
	if (sprite_index == attackdash && !grounded)
	{
		image_index = 0;
		sprite_index = airattackdashstart;
	}
	if grounded && sprite_index == airattackdash && (!key_attack || character == "N" || character == "D") && global.attackstyle != 2
	{
		if (global.attackstyle != 3)
		{
			state = states.normal;
			if (move != xscale)
				movespeed = 2;
		}
		else
		{
			sprite_index = attackdash;
			image_index = image_number - 6;
		}
	}
	if grounded && sprite_index == airattackdash && key_attack && global.attackstyle != 2
		state = states.mach2;
	if (floor(image_index) == image_number - 1 && sprite_index == attackdash)
		state = states.normal;
	if (floor(image_index) == image_number - 1 && sprite_index == airattackdashstart)
		sprite_index = airattackdash;
	if (floor(image_index) == image_number - 1 && key_attack && sprite_index == attackdash)
	{
		image_speed = 0.35;
		state = states.mach2;
		grav = 0.5;
	}
	if anim_end() && sprite_index == attackdash
	{
		if character != "V"
			state = states.normal;
		else if grabduration = 0
		{
			state = states.normal;
			grabduration = 14;
			grabstart = 10;
		}
	}
	if scr_mach_check_dive() && grounded && global.attackstyle != 2 && !pistol
	{
		with (instance_create(x, y, obj_jumpdust))
			image_xscale = other.xscale;
		movespeed = 12;
		crouchslipbuffer = 25;
		grav = 0.5;
		sprite_index = character != "M" ? spr_crouchslip : spr_playerM_shoulderslidedown;
		image_index = 0;
		machhitAnim = false;
		state = states.tumble;
		fmod_event_instance_play(snd_crouchslide);
	}
	mask_index = spr_player_mask;
	if character == "S"
		mask_index = spr_crouchmask;
	if ((!grounded && (place_meeting(x + hsp, y, obj_solid) || scr_solid_slope(x + hsp, y)) && !place_meeting(x + hsp, y, obj_destructibles)) || (grounded && (place_meeting(x + sign(hsp), y - 16, obj_solid) || scr_solid_slope(x + sign(hsp), y - 16)) && !place_meeting(x + hsp, y, obj_destructibles) && !place_meeting(x + hsp, y, obj_metalblock) && scr_slope()))
	{
		var _climb = true;
		if character == "N" || character == "D"
			_climb = ledge_bump(32, abs(hsp) + 1);
		if (_climb)
		{
			wallspeed = 6;
			grabclimbbuffer = 10;
			state = states.climbwall;
		}
	}
	if (grounded && scr_solid(x + xscale, y) && !place_meeting(x + sign(hsp), y, obj_destructibles) && (!place_meeting(x + sign(hsp), y, obj_slope) || scr_solid_slope(x + sign(hsp), y)))
	{
		var _bump = ledge_bump((vsp >= 0) ? 32 : 22);
		if (_bump)
		{
			fmod_event_one_shot_3d("event:/sfx/pep/splat", x, y);
			jumpstop = true;
			state = states.jump;
			vsp = noone;
			sprite_index = spr_suplexbump;
			instance_create(x + (xscale * 10), y + 10, obj_bumpeffect);
		}
	}
	if (!instance_exists(obj_slidecloud) && grounded && movespeed > 5)
	{
		with (instance_create(x, y, obj_slidecloud))
			image_xscale = other.xscale;
	}
	image_speed = 0.35;
	if (state != states.bump && move != xscale && move != 0)
	{
		image_index = 0;
		if (!grounded)
		{
			fmod_event_one_shot_3d("event:/sfx/pep/grabcancel", x, y);
			sprite_index = spr_suplexcancel;
			jumpAnim = true;
			grav = 0.5;
			state = states.jump;
			pepperman_skipstartup = true;
		}
		else
		{
			state = states.normal;
			movespeed = 2;
			grav = 0.5;
			pepperman_skipstartup = true;
		}
	}
}
␀“␀␀␀function scr_player_gottreasure()
{
	sprite_index = isgustavo ? spr_player_ratmounttreasuregot : spr_gottreasure;
	mach2 = 0;
	image_speed = 0.2;
}␀Œ␀␀function scr_player_ratmountbounce()
{
	if character == "N" || character == "D"
	{
		isgustavo = false;
		scr_player_noisecrusher();
		exit;
	}
	if sprite_index == spr_ratmountwalljump && vsp > 0
	{
		vsp += 0.5;
		image_speed = abs(vsp) / 10;
		if (!instance_exists(superslameffectid))
		{
			with (instance_create(x, y, obj_superslameffect))
			{
				playerid = other.object_index;
				other.superslameffectid = id;
			}
		}
	}
	else
		image_speed = 0.35;
	if (sprite_index == spr_player_ratmountbounce)
	{
		move = key_left + key_right;
		hsp = movespeed;
		movespeed = Approach(movespeed, 0, 1);
		if (floor(image_index) == (image_number - 1))
		{
			if (hsp != 0)
				xscale = sign(hsp);
			state = states.ratmount;
		}
	}
	else
	{
		hsp = movespeed;
		move = key_left + key_right;
		if move != 0
			movespeed = Approach(movespeed, move * 8, 0.5);
		else
			movespeed = Approach(movespeed, 0, 0.5);
		if (((input_buffer_slap > 0 && key_up) || key_shoot2) && brick)
		{
			input_buffer_slap = 0;
			ratmount_kickbrick();
		}
		if input_buffer_slap > 0 && !key_up
		{
			particle_set_scale(particle.jumpdust, xscale, 1);
			create_particle(x, y, particle.jumpdust, 0);
			input_buffer_slap = 0;
			if brick == 1
			{
				with (instance_create(x, y, obj_brickcomeback))
					wait = true;
			}
			brick = false;
			state = states.ratmountpunch;
			gustavohitwall = false;
			ratmountpunchtimer = 25;
			image_index = 0;
			if move != 0
				xscale = move;
			movespeed = xscale * 12;
			sprite_index = spr_lonegustavopunch;
		}
		ratmount_fallingspeed += 0.5;
		if (brick && scr_solid(x + sign(hsp), y) && (!place_meeting(x + sign(hsp), y, obj_slope) || scr_solid_slope(x + sign(hsp), y)))
		{
			if (move != 0 && move == sign(hsp) && key_jump2)
			{
				fmod_event_one_shot_3d("event:/sfx/ratmount/walljump1", x, y);
				state = states.ratmountclimbwall;
				sticktime = 15;
				xscale = sign(hsp);
				landAnim = false;
			}
		}
		if (grounded && vsp > 0 && !place_meeting(x, y + vsp, obj_destructibles) && !place_meeting(x, y + 15, obj_destructibles) && !place_meeting(x, y + 15, obj_metalblock) && !place_meeting(x, y + 15, obj_grindrail) && brick)
		{
			with (instance_create(x - 10, y, obj_parryeffect))
			{
				sprite_index = spr_ratdust;
				hspeed = -5;
			}
			with (instance_create(x + 10, y, obj_parryeffect))
			{
				image_xscale = -1;
				sprite_index = spr_ratdust;
				hspeed = 5;
			}
			with obj_baddie
			{
				if (shakestun && grounded && point_in_camera(x, y, view_camera[0]) && grounded && vsp > 0 && !invincible && groundpound)
				{
					state = states.stun;
					if stunned < 60
						stunned = 60;
					vsp = -11;
					image_xscale *= -1;
					hsp = 0;
					momentum = 0;
				}
			}
			with obj_camera
			{
				shake_mag = 10;
				shake_mag_acc = 30 / room_speed;
			}
			fmod_event_one_shot_3d("event:/sfx/pep/groundpound", x, y);
			sprite_index = spr_player_ratmountbounce;
			image_index = 0;
		}
	}
	ratmount_dotaunt();
}
␀␀␀␀ñ	␀␀function scr_player_grabbing()
{
	landAnim = false;
	hsp = xscale * movespeed;
	move = key_left + key_right;
	momemtum = true;
	dir = xscale;
	if (sprite_index != spr_player_Sjump)
	{
		if (movespeed < 12 && grounded)
			movespeed += 1;
		else if (!grounded)
			movespeed = 12;
	}
	var attackdash = spr_player_suplexdash;
	var airattackdash = spr_player_suplexgrabjump;
	var airattackdashstart = spr_player_suplexgrabjumpstart;
	if (sprite_index == attackdash && !grounded)
	{
		image_index = 0;
		sprite_index = airattackdashstart;
	}
	if (grounded && key_chainsaw2)
	{
		fmod_event_instance_play(suplexdashsnd);
		state = states.grabbing;
		image_index = 0;
		vsp = 0;
		sprite_index = spr_player_suplexdash;
		movespeed = 8;
