					tv_do_expression(mach4tvspr);
				else if (state == states.mach3 && !mach4mode || sprite_index == spr_mach3boost || ratmount_movespeed >= 12 && ratmount_movespeed <= 16 && character == "G" && !isstick && !mach4mode)
					tv_do_expression(mach3tvspr);
			}
		}
		switch (sprite_index)
		{
			case offtvspr:
			case offtvspr2:
				if (visible)
				{
					sprite_index = opentvspr;
					image_index = 0;
				}
				break;
			case opentvspr:
			case opentvspr2:
				if anim_end()
					sprite_index = idlespr;
				break;
			case idletvspr:
			case idletvspr2:
				if (idleanim > 0)
					idleanim--;
				if (sprite_index != idlespr)
					sprite_index = idlespr;
				if (idleanim <= 0 && floor(image_index) == (image_number - 1))
				{
					sprite_index = choose(idleanim1tvspr, idleanim2tvspr);
					image_index = 0;
				}
				break;
			case idleanim1tvspr:
			case idleanim2tvspr:
			case idleanim1tvspr2:
			case idleanim2tvspr2:
				if (floor(image_index) == (image_number - 1))
				{
					sprite_index = idletvspr;
					idleanim = 240 + (60 * irandom_range(-1, 2));
				}
				if (idlespr != idletvspr)
					sprite_index = idletvspr;
				break;
			default:
				sprite_index = idlespr;
		}
		if (sprite_index != opentvspr)
		{
			if (!ds_list_empty(tvprompts_list))
			{
				var b = ds_list_find_value(tvprompts_list, 0);
				prompt_buffer = prompt_max;
				if (b[0] != "" && b[0] != noone)
				{
					bubblespr = spr_tv_bubbleopen;
					bubbleindex = 0;
					prompt = b[0];
					promptspd = b[3];
					promptx = promptxstart;
				}
				else
				{
					if (bubblespr != noone && bubblespr != spr_tv_bubbleclosed)
						bubblespr = spr_tv_bubbleclose;
					if (bubblespr == spr_tv_bubbleclosed)
						bubblespr = noone;
					bubbleindex = 0;
					promptx = promptxstart;
					prompt = noone;
				}
				if (b[1] == tvprompt.normal)
				{
					sprite_index = opentvspr;
					image_index = 0;
					tvsprite = b[2];
				}
				else
				{
					tvsprite = b[2];
					sprite_index = tvsprite;
					image_index = 0;
				}
				state = states.transition;
			}
			else
				bubblespr = noone;
		}
		break;
	
	case states.transition:
		if (sprite_index == opentvspr && floor(image_index) == (image_number - 1))
			sprite_index = tvsprite;
		if (sprite_index == tvsprite)
		{
			if (prompt_buffer > 0)
				prompt_buffer--;
			else
			{
				promptx = promptxstart;
				ds_list_delete(tvprompts_list, 0);
				state = states.normal;
			}
		}
		break;
	
	case states.tv_whitenoise:
		if (tv_trans >= sprite_get_number(whitenoisetvspr))
		{
			if (expressionsprite != noone)
			{
				state = states.tv_expression;
				sprite_index = expressionsprite;
			}
			else
				state = states.normal;
			image_index = 0;
		}
		break;
	
	case states.tv_expression:
		var s = state;
		var es = expressionsprite;
		_transfospr = scr_tv_get_transfo_sprite();
		switch (expressionsprite)
		{
			case hurttvspr:
			case hurt1tvspr:
			case hurt2tvspr:
			case hurt3tvspr:
			case hurt4tvspr:
			case hurt5tvspr:
			case hurt6tvspr:
			case hurt7tvspr:
			case hurt8tvspr:
			case hurt9tvspr:
			case hurt10tvspr:
			case hurttvspr2:
			case hurt1tvspr2:
			case hurt2tvspr2:
			case hurt3tvspr2:
			case hurt4tvspr2:
			case hurt5tvspr2:
			case hurt6tvspr2:
			case hurt7tvspr2:
			case hurt8tvspr2:
			case hurt9tvspr2:
			case hurt10tvspr2:
				if (playerid.state != states.hurt)
				{
					if (expressionbuffer > 0)
						expressionbuffer--;
					else
					{
						state = states.tv_whitenoise;
						expressionsprite = noone;
					}
				}
				break;
			case hurtGtvspr:
			case hurtGtvspr2:
				if (playerid.state != states.ratmounthurt)
				{
					if (expressionbuffer > 0)
						expressionbuffer--;
					else
					{
						state = states.tv_whitenoise;
						expressionsprite = noone;
					}
				}
				break;
			case combotvspr:
			case combotvspr2:
				if (global.combo < 3 || _transfospr != noone || playerid.isgustavo || playerid.state == states.hurt || playerid.state == states.mach3 || playerid.sprite_index == playerid.spr_mach3boost)
				{
					scr_tvspr();
					state = states.tv_whitenoise;
					expressionsprite = noone;
					if (playerid.state == states.hurt && !global.swapmode)
						tv_do_expression(hurttvspr);
				}
				break;
			case happytvspr:
			case happyGtvspr:
			case happytvspr2:
			case happyGtvspr2:
				scr_tvspr();

				if (expressionbuffer > 0)
					expressionbuffer--;
				else
				{
					state = states.tv_whitenoise;
					expressionsprite = noone;
				}
				break;
			case mach3tvspr:
			case mach3tvspr2:
				with playerid
				{
					if state != states.mach3 && !mach4mode && state != states.climbwall && sprite_index != spr_mach3boost && !(ratmount_movespeed >= 12 || gustavodash >= 51) && (state != states.chainsaw || (tauntstoredstate != states.mach3 && tauntstoredstate != states.climbwall)) 
					{
						other.state = states.tv_whitenoise;
						other.expressionsprite = noone;
					}
					if mach4mode
						tv_do_expression(mach4tvspr);
				}
				break;
			case mach4tvspr:
			case mach4tvspr2:
				with (playerid)
				{
					if (!mach4mode && !(ratmount_movespeed >= 16) && (state != states.chainsaw || (tauntstoredstate != states.mach3 && tauntstoredstate != states.climbwall)))
					{
						other.state = states.tv_whitenoise;
						other.expressionsprite = noone;
					}
				}
				break;
			case heattvspr:
			case heattvspr2:
				_transfo = false;
				with (playerid)
				{
					if (_transfospr != noone)
						_transfo = true;
					if (isgustavo)
						_transfo = true;
				}
				if (_transfo || playerid.mach4mode || playerid.state == states.hurt || playerid.state == states.mach3 || playerid.sprite_index == playerid.spr_mach3boost)
				{
					state = states.tv_whitenoise;
					expressionsprite = noone;
				}
				break;
			case escapetvspr:
			case escapetvspr2:
				_transfo = false;
				with (playerid)
				{
					if (_transfospr)
						_transfo = true;
					if (isgustavo)
						_transfo = true;
				}
				if (!global.panic || _transfo || playerid.mach4mode || playerid.state == states.hurt || playerid.state == states.mach3 || playerid.sprite_index == playerid.spr_mach3boost)
				{
					state = states.tv_whitenoise;
					expressionsprite = noone;
				}
				break;
		}
		if (!ds_list_empty(tvprompts_list))
		{
			state = states.tv_whitenoise;
			tv_trans = 0;
			expressionsprite = noone;
		}
		break;
}
