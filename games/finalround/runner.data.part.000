			bg.depth = -14;
			bg2 = instance_create(0, -100, obj_tiledintroprop);
			bg2.sprite_index = spr_intro_skyfrombottom2;
			bg2.hspeed = -1;
			bg2.vspeed = 1;
			bg2.depth = -13;
			with (instance_create(0, 0, obj_genericfade))
			{
