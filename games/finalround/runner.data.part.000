function doise_vomitsnowball()
{
	var _pad = 32;
	fmod_event_one_shot_3d("event:/sfx/playerD/snowballvomit", x + (image_xscale * _pad), y); 
	with (instance_create(x + (image_xscale * _pad), y, obj_brickball))
	{
		image_xscale = other.xscale;
		xoffset = _pad;
		sprite_index = spr_playerD_snowball;
		vsp = -5;
		playerid = self;
	}
	state = states.bump;
	sprite_index = spr_playerD_snowballvomit;
	image_index = 0;
	image_speed = 0.35;
}

function scr_change_doise_timer(amount)
{
	if global.character = "D" && !is_bossroom()
	{
		if obj_camera.visible = true
		{	
			obj_camera.karma_bar_activate = true;
			if obj_camera.karma_bar_activate
			{
				if obj_camera.karma_bar_timer < obj_camera.karma_bar_max
					obj_camera.karma_bar_timer += amount
				else
					obj_camera.karma_bar_timer = obj_camera.karma_bar_max
				if obj_camera.karma_bar_timer <= 0
					obj_camera.karma_bar_timer = 0
			}
		}
	}
