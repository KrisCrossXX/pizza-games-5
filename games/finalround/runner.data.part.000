}␀'␀␀function scr_playerV_mort() 
{
	move = key_left + key_right;
	mask_index = spr_crouchmask;
	switch state 
	{
		#region Mort Normal
		case states.ratmount:
			hsp = movespeed
			image_speed = 0.35;
			if (global.swapmode && key_attack && key_fightball && ratmount_movespeed >= 12 && !instance_exists(obj_swapmodegrab) && !instance_exists(obj_swapdeatheffect) && !instance_exists(obj_noiseanimatroniceffect) && obj_swapmodefollow.animatronic <= 0)
			{
				sprite_index = spr_fightball;
				jump_p2 = false;
				instance_create_unique(x, y, obj_swapgusfightball);
				state = states.mach3;
				movespeed = abs(hsp);
				if movespeed < 12
					movespeed = 12;
				if hsp != 0
					xscale = sign(hsp);
				exit;
			}		
			var front = scr_solid(x + sign(hsp), y) && !place_meeting(x + sign(hsp), y, obj_slope);
			if abs(movespeed) < 8
				ratmount_movespeed = 8;
			if key_attack
				ratmount_movespeed = Approach(ratmount_movespeed, 12, 0.15);
			if move != 0
				movespeed = Approach(movespeed, move * ratmount_movespeed, 0.5);
			else
				movespeed = Approach(movespeed, 0, 0.5);
			if (scr_solid(x + sign(movespeed), y) && !place_meeting(x + sign(movespeed), y, obj_slope) && !place_meeting(x + hsp, y, obj_destructibles))
				movespeed = 0;
			if ratmount_movespeed >= 12
			{
				if (!instance_exists(chargeeffectid))
				{
					with (instance_create(x, y, obj_chargeeffect))
					{
						playerid = other.object_index;
						other.chargeeffectid = id;
					}
				}
			}
			if sprite_index != spr_mortland || anim_end()
			{
				if abs(movespeed) > 0 
				{
					xscale = sign(movespeed);
					if ratmount_movespeed >= 12
						sprite_index = spr_playerV_mortmach3;
					else if key_attack
						sprite_index = spr_playerV_mortdash;
					else
						sprite_index = spr_mortwalk;
				}
				else
					sprite_index = spr_mortidle;
			}
			if (hsp != 0 && grounded && vsp > 0 && !front)
			{
				if (steppybuffer > 0)
					steppybuffer--;
				else
				{
					create_particle(x, y + 43, particle.cloudeffect, 0);
					steppybuffer = 18;
					fmod_event_one_shot_3d("event:/sfx/pep/step", x, y);
				}
			}
			if input_buffer_jump > 0 && can_jump
			{
				vsp = -11;
				input_buffer_jump = 0;
				state = states.ratmountjump;
				if ratmount_movespeed >= 12 && key_attack
					sprite_index = spr_playerV_mortdashjump;
				else
					sprite_index = spr_mortspawn;
				image_index = 0;
				jumpstop = false;
				sound_play_3d(sfx_jump, x, y);
				instance_create(x, y, obj_highjumpcloud2);
			}
			else if !grounded
			{
				state = states.ratmountjump;
				sprite_index = spr_mortfall;
			}
			if (input_buffer_slap > 0 && key_up) || key_shoot2 && !key_up
			{
				input_buffer_slap = 0;
				mort_eggshoot();
			}
			if input_buffer_slap > 0
			{
				particle_set_scale(particle.jumpdust, xscale, 1);
				create_particle(x, y, particle.jumpdust, 0);
				input_buffer_slap = 0;
				state = states.ratmountpunch;
				gustavohitwall = false;
				ratmountpunchtimer = 25;
				image_index = 0;
				if (move != 0)
					xscale = move;
				if (movespeed < xscale * 12)
					movespeed = xscale * 12
				sprite_index = spr_lonegustavopunch;
			}
			image_speed = 0.35;
			ratmount_dotaunt();
			break;
		#endregion
			
		#region Mort Peck
		case states.ratmountpunch:
			image_speed = 0.45;
			hsp = movespeed;
			move = key_left + key_right;
			landAnim = false;
			sprite_index = spr_lonegustavopunch;
			if (grounded)
				movespeed = Approach(movespeed, xscale * 4, 0.1);
			if sprite_index == spr_lonegustavopunch && anim_end()
			{
				sprite_index = spr_lonegustavowalk;
				state = states.ratmount;
				if (hsp != 0)
				{
					dir = sign(hsp);
					xscale = dir;
				}
			}
			if (punch_afterimage > 0)
				punch_afterimage--;
			else
			{
				punch_afterimage = 5;
				with (create_mach3effect(x, y, sprite_index, image_index, true))
					image_xscale = other.xscale;
			}
			if (instance_place(x, y, obj_morthook) != noone)
			{
				fmod_event_one_shot_3d("event:/sfx/mort/hook", other.x, other.y);	
				with (instance_create(other.x, other.y + 10, obj_parryeffect))
					sprite_index = spr_morthookgrabeffect;
				state = states.morthook;
			}
			if ((!grounded && key_slap && (place_meeting(x + hsp, y, obj_solid) || scr_solid_slope(x + hsp, y)) && !place_meeting(x + hsp, y, obj_destructibles)) || (grounded && (place_meeting(x + sign(hsp), y - 16, obj_solid) || scr_solid_slope(x + sign(hsp), y - 16)) && !place_meeting(x + hsp, y, obj_destructibles) && !place_meeting(x + hsp, y, obj_metalblock) && place_meeting(x, y + 1, obj_slope)))
			{
				movespeed = 0
				hsp = 0
				vsp = 0
				sprite_index = spr_playerV_mortwallstart
				image_index = 0
				state = states.mortwall
			}
			break;
		#endregion

		#region Mort Jump/Flap
		case states.ratmountjump:
			hsp = movespeed;
			image_speed = 0.35;
			if abs(movespeed) < 8
				ratmount_movespeed = 8;
			if key_attack
				ratmount_movespeed = Approach(ratmount_movespeed, 12, 0.15);
			if move != 0
				movespeed = Approach(movespeed, move * ratmount_movespeed, 0.5);
			else
				movespeed = Approach(movespeed, 0, 0.5);
			if !jumpstop && !key_jump2 && vsp < 0
			{
				vsp /= 3;
				jumpstop = true;
			}
			vsp -= grav / 3;
			if abs(movespeed) > 0
				xscale = sign(movespeed);
			if ratmount_movespeed >= 12
			{
				if (!instance_exists(chargeeffectid))
				{
					with (instance_create(x, y, obj_chargeeffect))
					{
						playerid = other.object_index;
						other.chargeeffectid = id;
					}
				}
			}
			if (scr_solid(x + sign(movespeed), y) && !place_meeting(x + sign(movespeed), y, obj_slope) && !place_meeting(x + hsp, y, obj_destructibles))
				movespeed = 0;
			if input_buffer_jump > 0 
			{
				vsp = -8.5;
				input_buffer_jump = 0;
				state = states.ratmountjump;
				sprite_index = spr_mortspawn;
				repeat 2
					create_debris(x, y, spr_feather);
				image_index = 0;
				jumpstop = false;
				sound_play_3d(sfx_mortdoublejump, x, y);
			}
			if key_jump2
				vsp = min(vsp, 5);
			if sprite_index == spr_mortspawn && anim_end()
				sprite_index = spr_mortfall;
			if ((input_buffer_slap > 0 && key_up) || key_shoot2 && !key_up)
			{
				input_buffer_slap = 0;
				mort_eggshoot();
			}
			if (grounded && vsp >= 0)
			{
				if ratmount_movespeed < 12
					sprite_index = spr_mortland;
				state = states.ratmount;
				sound_play_3d(sfx_playerstep, x, y);
				instance_create(x, y, obj_landcloud);
			}
			if input_buffer_slap > 0
			{
				particle_set_scale(particle.jumpdust, xscale, 1);
				create_particle(x, y, particle.jumpdust, 0);
				input_buffer_slap = 0;
				state = states.ratmountpunch;
				gustavohitwall = false;
				ratmountpunchtimer = 25;
				image_index = 0;
				if (move != 0)
					xscale = move;
				movespeed = xscale * 12
				sprite_index = spr_lonegustavopunch;
			}
			if scr_check_groundpound()
			{
				state = states.ratmountgroundpound
				sprite_index = spr_playerV_mortegg;
				image_index = 0;
				image_speed = 0.35;
				movespeed = hsp;
				vsp = -8;
				with (instance_create(x, (y + 50), obj_ratmountgroundpound))
				{
					spdh = -24;
					image_xscale = other.xscale;
					sprite_index = spr_playerV_mortbombegg;
					image_index = 0;
				}
			}
			ratmount_dotaunt();
			break;
		#endregion
			
		#region Mort After Egg Drop
		case states.ratmountgroundpound:
			image_speed = 0.35;
			hsp = movespeed;
			if abs(movespeed) < 8
				ratmount_movespeed = 8;
			if key_attack
				ratmount_movespeed = Approach(ratmount_movespeed, 12, 0.15);
			if move != 0
				movespeed = Approach(movespeed, move * ratmount_movespeed, 0.5);
			else
				movespeed = Approach(movespeed, 0, 0.5);
			if (anim_end() && (sprite_index == spr_playerV_mortegg || sprite_index == spr_playerV_morteggside))
			{
				sprite_index = spr_mortfall;
				image_index = 0;
				state = states.ratmount;
			}
			if (grounded && vsp >= 0 && sprite_index != spr_playerV_morteggside)
			{
				if(ratmount_movespeed < 12)
					sprite_index = spr_mortland;
				state = states.ratmount;
				sound_play_3d(sfx_playerstep, x, y);
				instance_create(x, y, obj_landcloud);
			}
			if (punch_afterimage > 0)
				punch_afterimage--;
			else
			{
				punch_afterimage = 5;
				with (create_mach3effect(x, y, sprite_index, image_index, true))
					image_xscale = other.xscale;
			}
			break;	
		#endregion
			
		#region Mort Hurt
		case states.ratmounthurt:
			image_speed = 0.35;
			hsp = -xscale * movespeed;
			hurted = true;
			landAnim = false;
			jumpAnim = false;
			if (check_solid(x + sign(hsp), y) && !check_slope(x, y + sign(hsp)))
				movespeed = 0;
			alarm[5] = 2;
			alarm[7] = 80;
			if (grounded && vsp > 0)
			{
				state = states.ratmount;
				movespeed = 0;
			}
			sprite_index = spr_playerV_morthurt;
			image_speed = 0.35;
			break;
		#endregion

		#region // Mort Wall Stick
		case states.mortwall:
			image_speed = 0.35
			movespeed = 0
			hsp = 0
			vsp = 0
			if (input_buffer_jump > 0)
			{
				vsp = -13
				input_buffer_jump = 0
				state = states.ratmountjump
				if ratmount_movespeed >= 12 && key_attack
					sprite_index = spr_playerV_mortdashjump
				else
					sprite_index = spr_mortspawn
				image_index = 0
				jumpstop = false
				sound_play_3d(sfx_jump, x, y)
				instance_create(x, y, obj_highjumpcloud2)
			}
			if sprite_index == spr_playerV_mortwallstart && anim_end()
				sprite_index = spr_playerV_mortwall
			break
		#endregion
			
		default:
			state = states.ratmount;
			break;
	}
}

function mort_eggshoot()
{
	var _pad = 32;
	fmod_event_one_shot_3d("event:/sfx/enemies/killingblow", x + (image_xscale * _pad), y);
	with (instance_create(x + (image_xscale * _pad), y, obj_brickball))
	{
		vsp = 0
		grav = 0;
		mort = true;
		sprite_index = spr_playerV_mortbombeggside;
		image_index = 0;
		if (other.state == states.ratmountjump || other.state == states.ratmountbounce)
			up = true;
		image_xscale = other.xscale;
		xoffset = _pad;
		playerid = self;
	}
	state = states.ratmountgroundpound;
	sprite_index = spr_lonegustavokick;
	image_index = 0;
	image_speed = 0.35;
	gustavokicktimer = 12;
}␀␀␀␀c␀␀function PlaceObject(_inst) : Command() constructor
{
	static execute = function()
	{
		placed = true;
		instance_activate_object(inst);
		inst.xscale = 1.5;
		inst.yscale = 1.5;
	};
	static undo = function()
	{
		placed = false;
		instance_deactivate_object(inst);
	};
	static destroy = function()
	{
		if (!placed)
		{
			instance_destroy(inst);
			with (global.current_level.current_room)
			{
				for (var i = 0; i < array_length(instances); i++)
				{
					if (instances[i] == other.inst)
					{
						array_delete(instances, i, 1);
						break;
					}
				}
			}
		}
	};
	inst = _inst;
	placed = false;
}
␀H␀␀//if nothingday
function scr_escapeBlock_init()
{
	saveX = x
}

function scr_escapeBlock_step()
{
	if global.panic
	{
		x = saveX
		mask_index = spr_bigbreakableescape
		image_alpha = 1
		visible = true
	}
	else
	{
		x = saveX
		saveX = x
		with (obj_player1)
			other.x = (x - 3000)
		visible = false
		image_alpha = 0.5
	}
}

␀␀␀␀	␀␀function toggle_panel(_id)
{
    var _closed = false;
    with (obj_panel)
    {
        if (ID == _id && state == comp_state.docked)
            _closed = true;
    }
    if _closed
    {
        with (obj_panel)
        {
            if (ID == _id)
                state = comp_state.undocked
            else if (ID != -4)
                state = comp_state.docked
        }
    }
    else
    {
        with (obj_panel)
        {
            if (ID != -4)
                state = comp_state.docked
        }
    }
}

␀␀␀¬␀␀function scr_dograb() 
{
	if key_slap2
	{
		if character != "V" 
		{
			image_index = 0
			var uppercut = grounded && key_up || key_up && !suplexmove && global.attackstyle != 1
			if uppercut 
			{
				state = states.punch
				sprite_index = spr_uppercut
				if grounded
					vsp = -14;
				else
					vsp = -10;
				movespeed = hsp
				particle_set_scale(particle.highjumpcloud2, xscale, 1)
				create_particle(x, y, particle.highjumpcloud2, 0)	
			} 
			else 
			{
				sprite_index = spr_suplexdash;
				state = states.handstandjump
				if (movespeed < 5)
					movespeed = 5;
				if (global.attackstyle == 1)
				{
					if grounded
						sprite_index = spr_player_attackdash;
					else
						sprite_index = spr_player_airattackstart;
				}
				else if (global.attackstyle == 3) 
				{
					sprite_index = spr_player_lungestart;
					if movespeed < 8
						movespeed = 8;
				}
			}
			suplexmove = 1;
			flash = 1;
		} 
		else 
		{
			if !grounded 
			{
				sprite_index = spr_playerV_airrevolver
				image_index = 0
				vsp = -5
				state = states.revolver
				shootcounter++;
				with (instance_create((x + (xscale * 20)), (y + 25), obj_vigilanteshotplay))
				{
					is_solid = false
					image_xscale = other.xscale
				}
				scr_soundeffect(sfx_killingblow)
			} 
			else 
			{ 
				if (move == 0)
					movespeed = 0
				sprite_index = spr_playerV_revolverstart
				image_index = 0
				state = states.revolver	
				shootcounter++;
			}
		}
	}		
}␀␀␀␀/
