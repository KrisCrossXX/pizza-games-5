			if grounded && vsp > 0 && key_attack
			{
				sprite_index = spr_mrstick_mach2;
				image_index = 0;
				if ratmount_movespeed < 7
					ratmount_movespeed = 7;
				landAnim = false;
				state = states.ratmount;
				xscale = move != 0 ? move : xscale;
			}
			if (scr_check_groundpound())
