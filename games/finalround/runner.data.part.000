		#endregion
		#region Ratmountskid (Skid)
		case states.ratmountskid:
			hsp = xscale * -movespeed;
			sprite_index = !stickmach3 ? spr_mrstick_skid : spr_mrstick_mach3skid;
			movespeed = Approach(movespeed, 0, 0.8);
			gustavodash = 0;
			ratmount_movespeed = 8;
			image_speed = 0.4;
			if (abs(movespeed) <= 0 || abs(hsp) <= 0)
			{
				movespeed = 0;
				state = states.ratmount;
				stickmach3 = false;
			}
			if (input_buffer_jump > 0 && can_jump)
