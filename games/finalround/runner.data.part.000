tutorial1 = "Premi [J] per saltare! Tieni premuto [D] e una direzione per strisciare!"
tutorial2 = "Puoi eseguire una Panciata per rompere i blocchi di marmo e di metallo sottostanti! Premi [g] mentre sei in aria!"
tutorial3 = "Inizia a eseguire la Panciata da ancora piÃ¹ in alto per distruggere i blocchi di metallo!"
tutorial4 = "Alcuni blocchi potrebbero essere nascosti, quindi tieni sempre gli occhi aperti! Premi [G] per distruggerli!"
tutorial5 = "Premi [G] per eseguire uno Scatto manesco! Puoi usarlo per distruggere i blocchi di marmo!"
tutorial6 = "Tieni premuto [M] per cominciare una Corsa folle! Se tieni premuto [M] e poi salti su un muro, correrai su di esso!"
tutorial7 = "Premi [J] mentre corri su un muro per saltare via! Tieni premuto [M] per attaccarti agli altri muri! Consiglio: puoi anche usare lo Scatto manesco per cominciare una corsa su un muro mentre sei in aria, devi solo tenere premuto [M]!"
tutorial8 = "Premi [G] e tieni premuto [M] per cominciare velocemente una Corsa folle! Provaci!"
tutorial9 = "Salta dopo aver premuto [G] per eseguire un balzo ancora piÃ¹ lungo!"
tutorial10 = "Puoi anche correre su una rampa vicina a un muro per iniziare a correre automaticamente su di esso!"
tutorial11 = "Durante una Corsa folle, tieni premuto [D] per distruggere i blocchi in un passaggio stretto!"
tutorial12 = "Rilascia [D] e tieni premuto [M] per continuare la Corsa folle!"
tutorial13 = "Tieni premuto [D] durante una Corsa folle in aria per lanciarti in picchiata!"
tutorial14 = "Per distruggere i blocchi di metallo, devi guadagnare velocitÃ  con una Corsa folle. Puoi tenere premuto [F] per andare ancora piÃ¹ forte!"
tutorial15 = "Correre giÃ¹ per una rampa ti farÃ  andare ancora piÃ¹ veloce!"
tutorial16 = "Per voltarti senza perdere velocitÃ  durante una Corsa folle, vai nella direzione opposta."
tutorial17 = "Prova a voltarti prima di cadere in un buco, cosÃ¬ non perderai velocitÃ  una volta a terra."
tutorial18 = "Quando stai andando molto veloce, tieni premuto [s] e rilascialo per realizzare un Super salto! Puoi anche metterti in posizione con [L][R] mentre tieni premuto [s]!"
tutorial19 = "Dopo aver cominciato un Super salto, puoi premere [G] per scattare in avanti! Provaci!"
tutorial20 = "Ecco un altro trucchetto: premi [G] e poi subito [D] per attraversare i passaggi piÃ¹ velocemente!"
tutorial21 = "Puoi afferrare gli oggetti con lo Scatto manesco e lanciarli premendo di nuovo [G]!"
tutorial22 = "Se tieni premuto [U] prima di lanciare un oggetto, lo scaraventerai in aria!"
tutorial23 = "Trova e raccogli queste cose per ottenere un grado migliore! Alcune sono disponibili solo durante la fuga..."
tutorial24 = "Devi salvare la maggior parte dei tizi nelle gabbie per passare al piano successivo! Ti daranno i soldi per pagare il signor Stick! Se ne lasci troppi indietro, dovrai riaffrontare alcuni livelli!"
tutorial25 = "Distruggi John Pilastro per aprire l'uscita e trasformare i blocchi solidi!"
tutorial_lapunlock = "{s}Sono stati aperti tutti i portali del Giro 2!/"
getout = "VATTENE SUBITO!!!"
forest1 = "Tieni premuto [M] per muoverti piÃ¹ velocemente e distruggere i blocchi di metallo!"
forest2 = "Premi [U][G] per prendere a calci il ratto!"
forest3 = "Premi [J] in aria per eseguire un Doppio salto! Puoi anche interromperlo con un'altra mossa!"
forest4 = "Premi [D] a mezz'aria per scendere velocemente!"
forest5 = "Il Doppio salto puÃ² anche distruggere i blocchi di metallo sottostanti!"
forest6 = "Durante un Doppio salto, tieni premuto [J] mentre ti dirigi verso un muro per scalarlo!"
hubtips1 = "Sai che puoi eseguire un Montante volante premendo [U] e poi [G]? PuÃ² essere una sorta di Doppio salto ed Ã¨ utile anche per liberarti dei nemici volanti!"
hubtips2 = "Probabilmente avrai notato l'effetto elettrico che ti circonda dopo aver eliminato un po' di nemici. Quando Ã¨ attivo, premi [U] e poi [T] per fare fuori tutti i nemici presenti sullo schermo!"
hubtips3 = "Sai che puoi bloccare e parare qualsiasi proiettile o danno premendo [T] prima di essere colpito?"
hubtips4 = "Presta attenzione alla valutazione finale. Verrai giudicato per ogni tua mossa."
hubtips5 = "Dopo aver superato un livello, puoi rivisitarlo: vicino all'entrata, troverai un portale per il Giro 2. Otterrai un punto bonus, ma dovrai anche a rifare la sezione di fuga un'altra volta..."
hubtips6 = "Sai che puoi eseguire un Piledriver afferrando un nemico e premendo [D] mentre sei in aria? Se invece premi [U] prima di afferrarlo, eseguirai un piledriver che ti lancerÃ  verso l'alto."
hubtips7 = "Ecco una tecnica oscura: se premi [J] mentre sei in picchiata, ti lancerai immediatamente verso il suolo con una Panciata. Ãˆ comodo solo se vuoi risparmiare tempo!"
hubtips8 = "Sai che puoi far reagire i nemici piÃ¹ in fretta premendo [T] quando sei vicino a loro?"
hubtips9 = "L'irraggiungibile grado P... Puoi ottenerlo completando tutto quello che c'Ã¨ da fare in un livello. Il problema Ã¨ che dovrai anche mantenere attiva una combo per tutta la durata del livello! Ãˆ una sfida molto impegnativa, quindi non prendertela troppo se non riesci a superarla!"
garbage1 = "Sai che il tuo nome completo Ã¨ Peppino Spaghetti? Mi dispiace per te."
garbage2 = "Se fai troppo male a Peppino, potresti finire all'inferno!"
garbage3 = "Che cosa sai di questa torre? Chi sei? Ah, non chiederlo a me!"
garbage4 = "Sai come si dice... una mano lava l'altra!"
garbage5 = "Non mi fiderei troppo di questo Gustavo... Sembra un po' troppo amichevole..."
garbage6 = "Senti, ora ti parlerÃ² di qualcosa che ho detto a chi conosce questo luogo di culto che lo hai fatto. Beh, siamo scesi nella tua pizzeria e siamo scesi da questa torre. Ci sono dei clienti e vogliono vedere una di queste cose. E poi c'Ã¨ questo mio amico che Ã¨ sceso da uno dei piani e un tizio si Ã¨ avvicinato a me e abbiamo pensato, perchÃ© nella parte di sopra della torre c'Ã¨ questo personaggio Pizzaface e poi c'Ã¨ un tipo dalla vita precedente che fa strada? C'Ã¨ una pizza nella tua torre che sa tutto questa roba."
garbage7 = "Offerta videopizza istantanea della Torre della Pizza! Digita /pizza per ordinare una pizza gratuita gentilmente offerta dalla Pizzeria Peppino!"
garbage8 = "Ricorda di non fare troppe pause, continua a giocare! ChissÃ  quando avrai di nuovo un po' di tempo libero!"
garbage9 = "Ho perso di nuovo le mie medicine. Oggi farÃ  davvero schifo!"
garbage10 = "Non penso che tu abbia bisogna del mio aiuto oggi."
garbage11 = "Pensi davvero che ti aiuterÃ² di nuovo dopo il casino che hai appena combinato?"
garbage12 = "Non ti sembra che il tuo frigo abbia un odore strano? Hai controllato la data di scadenza?"
garbage13 = "Sai, dovresti fare attenzione a quello che mangi."
garbage14 = "Hai intenzione di giocare o vuoi rimanere lÃ¬ con le mani in mano?"
garbage15 = "Baciami il culo!"
