var player = instance_nearest(x, y, obj_player);
if (state == states.walk && substate != states.turn)
{
	if ((player.x > (x - 400) && player.x < (x + 400)) && (y <= (player.y + 60) && y >= (player.y - 60)) && ragecooldown == 0)
	{
