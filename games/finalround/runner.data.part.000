# ---- DOISE GRANNY MSGS ----
garbage1D = "Did you know that your full name is Theodore Doise? That's original."
garbage2D = "If you hurt The Doise too much, he shall rise!"
garbage5D = "I wouldn't trust this Doisette gal... She seems a bit too quiet..."
garbage7D = "I don't believe in the paranormal, but I would watch my back if I were you!"
hubtips4D = "Be wary of your final judgement. Your fate is in your hands."
