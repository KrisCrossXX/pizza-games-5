			scenebuffer = 100;
			scene++;
		}
		break;
	case 16:
		if (floor(peppino.image_index) == (peppino.image_number - 1))
			peppino.image_index = peppino.image_number - 1;
		if (_switch)
		{
			gustavo = instance_create(0, 300, obj_introprop);
			gustavo.sprite_index = spr_intro_styleshot2;
			gustavo.depth = -1;
			scenebuffer = 100;
			scene++;
		}
		break;
	case 17:
		if (floor(peppino.image_index) == (peppino.image_number - 1))
