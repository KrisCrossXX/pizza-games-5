			if (savedmove != 0)
				xscale = savedmove;
			scr_shotgunshoot();
		}
		return true;
	}
	return false;
}
function scr_pepperman_machcancel_grab()
{
	if (character != "M")
		exit;
	image_speed = 0.5;
	move = key_left + key_right;
	if (input_buffer_slap > 0 && !key_up)
	{
		if (!shotgunAnim || move != 0)
		{
			//flash = true
			input_buffer_shoot = 0;
			pepperman_jump = false;
			if (move != 0)
				xscale = move;
			input_buffer_slap = 0;
			key_slap = false;
			key_slap2 = false;
			jumpstop = true;
			if vsp > -4
				vsp = -4
			if movespeed < 13
				movespeed = 13;
			sprite_index = spr_playerM_wallboost;
			state = states.mach3;
