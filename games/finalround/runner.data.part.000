tutorial14 = "Um MetallblÃ¶cke zu zerstÃ¶ren, musst du durch den Mach-Lauf an Geschwindigkeit gewinnen. Du kannst auch [F] gedrÃ¼ckt halten, um noch schneller zu werden!"
tutorial15 = "Wenn du einen schrÃ¤ge hinunterlÃ¤ufst, wirst du noch schneller!"
tutorial16 = "Um dich zu drehen, wÃ¤hrend du mitten im Mach-Lauf bist, drÃ¼cke die entgegengesetzte Richtung."
tutorial17 = "Versuche, deine Laufrichtung zu Ã¤ndern bevor du von einer Kante fÃ¤llst! dann behÃ¤ltst du dein Momentum, sobald du wieder auf dem Boden landest."
tutorial18 = "Wenn du bei hoher Geschwindigkeit [s] gedrÃ¼ckt hÃ¤ltst und dann loslÃ¤sst, kannst du den Supersprung ausfÃ¼hren! Du kannst deine Position auch mit [L][R] anpassen, wÃ¤hrend du [s] gedrÃ¼ckt hÃ¤ltst."
tutorial19 = "Nachdem du einen Supersprung gestartet hast, kannst du auch in der Luft vorwÃ¤rts sprinten, indem du [G] drÃ¼ckst! Probier's aus!"
tutorial20 = "Und noch ein Trick: DrÃ¼cke [G] und dann sofort [D], um schneller durch LÃ¼cken durchzukommen!"
tutorial21 = "Du kannst Dinge mit dem Grabsch greifen und werfen, indem du erneut [G] drÃ¼ckst!"
tutorial22 = "Wenn du wÃ¤hrend dem Werfen [U] gedrÃ¼ckt hÃ¤ltst, kannst du dinge nach oben schmeiÃŸen!"
tutorial23 = "Sammle diese ein um einen besseren Rang zu erreichen! Einige kann man nur wÃ¤hrend der Flucht einsammeln..."
tutorial24 = "Du musst diese Burschen aus ihren KÃ¤figen befreien, um ins nÃ¤chste Stockwerk zu kommen! Sie werden dir mÃ¤chtig kohle einschaffen mit der du Mr. Stick bezahlen kannst! Falls du zu viele von ihnen verpasst musst du ein paar level nochmal spielen!"
tutorial25 = "ZerstÃ¶re Pfeiler-John Um die AusgangstÃ¼r zu Ã¶ffnen, aber pass auf, dadurch werden die transparenten John-BlÃ¶cke sichtbar!"
tutorial_lapunlock = "{s}Alle Runde-2-Portale freigeschaltet!/"
getout = "NICHTS WIE RAUS!!!"
forest1 = "Halte [M] gedrÃ¼ckt, um dich schneller zu bewegen und MetallblÃ¶cke zu zerstÃ¶ren!"
forest2 = "DrÃ¼cke [U][G], um die Ratte zu treten!"
forest3 = "DrÃ¼cke [J] in der Luft, um einen Doppelsprung auszufÃ¼hren! Du kannst den Sprung auch durch eine andere Bewegung abbrechen!"
forest4 = "DrÃ¼cke [D], wÃ¤hrend du in der Luft bist, um schnell nach unten zu kommen!"
forest5 = "Der Doppelsprung kann auch MetallblÃ¶cke unter dir zerstÃ¶ren!"
forest6 = "Halte wÃ¤hrend des Doppelsprungs [J] in Richtung einer Wand gedrÃ¼ckt, um sie zu erklimmen!"
hubtips1 = "Wusstest du, dass du einen fliegenden AufwÃ¤rtshaken ausfÃ¼hren kannst, indem du [U] und dann [G] drÃ¼ckst? Das ist dann wie ein Pseudo-Doppelsprung und kann auch Feinde in der Luft erledigen!"
hubtips2 = "Nachdem du ein paar Feinde erledigt hast, hast du vielleicht den elektrischen Effekt um dich herum bemerkt. WÃ¤hrend der Effekt aktiv ist, kannst du [U] und dann [T] drÃ¼cken, um alle Feinde auf dem Bildschirm zu erledigen!"
hubtips3 = "Wusstest du, dass du jedes Projektil oder jeden Schaden abblocken und parieren kannst, indem du [T] drÃ¼ckst, bevor du getroffen wirst?"
hubtips4 = "Denk immer an deine endgÃ¼ltige Bewertung. Deine Leistung wird dafÃ¼r immer berÃ¼cksichtigt."
hubtips5 = "Wenn du einen Level geschafft hast, kannst du ihn nochmal spielen, um in der NÃ¤he des Eingangs ein Portal der Runde 2 zu finden. Das gibt dir einen Punktebonus, zwingt dich aber auch dazu, erneut flÃ¼chten zu mÃ¼ssen ..."
hubtips6 = "Wusstest du, dass du eine Dampframme ausfÃ¼hren kannst, indem du einen Gegner festhÃ¤ltst und [D] drÃ¼ckst, wÃ¤hrend du in der Luft bist? Du kannst auch eine Dampframme ausfÃ¼hren, die dich nach oben befÃ¶rdert, wenn du [U] gedrÃ¼ckt hÃ¤ltst, bevor du einen Gegner greifst."
hubtips7 = "Eine obskure Technik: Wenn du in der Luft hechtest und [J] drÃ¼ckst, gehst du sofort mit einem Bauchklatscher nach unten. Nur nÃ¼tzlich, wenn du Zeit sparen willst!"
hubtips8 = "Wusstest du, dass du Feinde schneller auf dich reagieren lassen kannst, wenn du in ihrer NÃ¤he [T] drÃ¼ckst?"
hubtips9 = "Der schwer definierbare P-RangÂ ... Du kannst ihn bekommen, wenn du alles erledigst, was es in einem Level zu tun gibt. Das Problem ist nur, dass du eine Kombo fÃ¼r die gesamte Dauer des Levels aufrecht erhalten musst! Das ist kein leichtes Unterfangen, also fÃ¼hl dich nicht schlecht, wenn du das nicht in Angriff nehmen mÃ¶chtest!"
garbage1 = "Wusstest du, dass dein vollstÃ¤ndiger Name Peppino Spaghetti ist? Du bist wirklich zu bedauern."
garbage2 = "Wenn du Peppino zu sehr verletzt, kannst du gleich zur HÃ¶lle fahren!"
garbage3 = "Was weiÃŸt du Ã¼ber diesen Turm? Und wer bist du eigentlich? Ich weiÃŸ gar nichts!"
garbage4 = "Eine Hand wÃ¤scht die andere!"
garbage5 = "Diesem Gustavo wÃ¼rde ich nicht Ã¼ber den Weg trauenÂ ... Er kommt ein bisschen zu freundlich rÃ¼berÂ ..."
garbage6 = "Ich werde jetzt Ã¼ber etwas sprechen, das ich anderen erzÃ¤hlt habe, die von dieser KultstÃ¤tte wissen, dass du das getan hast. Nun, wir sind von deiner Pizzeria heruntergekommen, und wir sind von diesem Turm heruntergekommen. Es gibt Kunden, und die wollen eins von beidem sehen. Also habe ich mich mit jemandem angefreundet, der ging eines der Stockwerke hinunter und dieser Typ kam zu mir, und die Idee war: Warum gibt es diesen Pizzaface-Charakter, wenn man im oberen Teil des Turms ist? Ein Typ aus deinem frÃ¼heren Leben, der dir den Weg weist? In deinem Turm gibt es eine Pizza mit all diesen Informationen."
garbage7 = "Sofort-Pizza-Gewinnspiel des Pizzaturms! Gib /pizza ein, um eine kostenlose Pizza zu bestellen, die uns freundlicherweise von Peppinos Pizza zur VerfÃ¼gung gestellt wird!"
garbage8 = "Denk daran, nicht zu viele Pausen zu machen, spiel weiter! Deine Zeit hier ist begrenzt!"
garbage9 = "Ich habe mal wieder meine Medikamente verloren. Was fÃ¼r ein ScheiÃŸtag!"
garbage10 = "Ich glaube nicht, dass du heute irgendwelche Tipps brauchst."
garbage11 = "Glaubst du ernsthaft, dass ich dir noch mehr RatschlÃ¤ge geben werde, nachdem du gerade so einen Mist gebaut hast?"
garbage12 = "Riecht dein KÃ¼hlschrank irgendwie komisch? Hast du mal auf das Ablaufdatum geguckt?"
garbage13 = "WeiÃŸt du, etwas weniger auf den Rippen wÃ¼rde dir gut tun."
garbage14 = "Willst du auch spielen oder nur dumm rumstehen?"
garbage15 = "Leck mich doch am Arsch!"
