			with (hitboxID)
			{
				ID = other.id;
				sprite_index = spr_weeniesquire_hitbox;
			}
		}
		if (floor(image_index) > 23)
			instance_destroy(hitboxID);
		if (floor(image_index) == (image_number - 1))
		{
			state = states.walk;
			instance_destroy(hitboxID);
			cooldown = 100;
		}
		break;
	case states.land:
		scr_enemy_land();
		break;
	case states.hit:
		scr_enemy_hit();
		break;
	case states.stun:
		scr_enemy_stun();
