			palette_info = get_pepman_palette_info();
			sprite_index = spr_palettedresserM;
			break;	
		case "V": // vigilante
			palettes = player_palettes[4];
			palette_info = get_vigi_palette_info();
			sprite_index = spr_palettedresser;
			break;
	}
	with obj_player1
	{
		if paletteselect > 2
		{
			for (var i = 0; i < array_length(other.palettes); i++)
			{
				var pal = other.palettes[i][2];
				var info = other.palette_info;
				if pal == info.paletteselect && (array_length(other.palettes[i]) <= 3 || (array_length(other.palettes[i]) > 3 && other.palettes[i][3] == info.patterntexture))
				{
					other.paletteselect = i;
					break;
				}
				else
					i++;
			}
		}
	}
	palettetitle = lang_get_value(concat("dresser_", palettes[paletteselect][dresser_info.name], "title"));
	palettedesc = lang_get_value_newline(concat("dresser_", palettes[paletteselect][dresser_info.name]));
}
