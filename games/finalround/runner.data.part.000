␀␀␀␀—␀␀function scr_player_spiderweb()
{
	hsp = (movespeed * xscale);
	if (movespeed != 0)
		vsp = (movespeed * flung_dir_speed)
	else
		vsp = flung_dir_speed;
	if (flinging)
	{
		movespeed -= 1;
		image_speed = movespeed / 13;
		if image_speed <= 2
		image_speed = 2;
		if (place_meeting(x,y,webID) && movespeed <= 0)
		{
			if (instance_exists(webID))
			{
				with (webID)
					event_user(0);
			}
			//movespeed = 0;
			flinging = false;
			image_index = 0;
			image_speed = 0.4;
			hsp = webstoredhsp
			vsp = webstoredvsp * -1
			image_xscale = xscale
			xscale = -xscale
			movespeed = hsp * -xscale
			state = states.mach2;
		}
	}
	/*
	if (instance_exists(webID))
	{
		x = webID.x;
		y = webID.y;
	}
	if (key_jump)
	{
		if (instance_exists(webID))
