				pal_swap_set(spr_tvmm_pal, mid_tvpal, false);
				draw_sprite_ext(spr_tvmm_off, 0, x2, y2, 1, 1, 0, c_white, 1)
			
				pal_swap_set(spr_tvmm_pal, right_tvpal, false);
				draw_sprite_ext(spr_tvmm_off, 0, x3, y3, 1, 1, 0, c_white, 1)
			
				pal_swap_set(spr_tvmm_pal, farright_pal);
				draw_sprite_ext(spr_tvmm_off, 0, x4, y4, 1, 1, 0, c_white, 1)
			}
			else
			{
				pal_swap_set(spr_tvmm_pal, farleft_pal, false);
				draw_sprite_ext(spr_tvmm_off, 0, x1, y1, 1, 1, 0, c_white, 1)
			
				pal_swap_set(spr_tvmm_pal, left_tvpal, false);
				draw_sprite_ext(spr_tvmm_off, 0, x2, y2, 1, 1, 0, c_white, 1)
			
				pal_swap_set(spr_tvmm_pal, mid_tvpal, false);
				draw_sprite_ext(spr_tvmm_off, 0, x3, y3, 1, 1, 0, c_white, 1)
			
				pal_swap_set(spr_tvmm_pal, right_tvpal, false);
				draw_sprite_ext(spr_tvmm_off, 0, x4, y4, 1, 1, 0, c_white, 1)
			}
		break;
	}
	reset_shader_fix();
}
if (state == states.ending)
{
	draw_set_alpha(0.5);
	draw_rectangle_color(0, 0, room_width, room_height, 0, 0, 0, 0, false);
	draw_set_alpha(1);
	draw_set_font(lang_get_font("bigfont"));
	draw_set_halign(fa_center);
	draw_set_valign(fa_middle);
	draw_sprite(spr_menu_byebye, index, (SCREEN_WIDTH / 2) + 210, SCREEN_HEIGHT / 2);
	draw_sprite(spr_menu_byebye, index, (SCREEN_WIDTH / 2) - 210, SCREEN_HEIGHT / 2);
	tdp_draw_text_color(SCREEN_WIDTH / 2, (SCREEN_HEIGHT / 2) - 30, lang_get_value("menu_exit"), c_white, c_white, c_white, c_white, 1);
	c2 = (exitselect == 0) ? c_white : c_gray;
	c2 = (exitselect == 1) ? c_white : c_gray;
	tdp_draw_text_color((SCREEN_WIDTH / 2) - 100, (SCREEN_HEIGHT / 2) + 30, lang_get_value("option_yes"), c_white, c_white, c_white, c_white, 1);
	tdp_draw_text_color((SCREEN_WIDTH / 2) + 100, (SCREEN_HEIGHT / 2) + 30, lang_get_value("option_no"), c2, c2, c2, c2, 1);
	tdp_text_commit(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT);
}

if (state == states.dead)
{
	draw_set_alpha(0.5);
	draw_rectangle_color(0, 0, room_width, room_height, 0, 0, 0, 0, false);
	draw_set_alpha(1);
	draw_set_font(lang_get_font("bigfont"));
	draw_set_halign(fa_center);
	draw_set_valign(fa_middle);
	draw_sprite(spr_menu_filedelete, index, (SCREEN_WIDTH / 2) + 210, SCREEN_HEIGHT / 2);
	draw_sprite(spr_menu_filedelete, index, (SCREEN_WIDTH / 2) - 210, SCREEN_HEIGHT / 2);
	tdp_draw_text_color(SCREEN_WIDTH / 2, (SCREEN_HEIGHT / 2) - 30, lang_get_value("menu_delete"), c_red, c_red, c_red, c_red, 1);
	c1 = (delselect == 0) ? c_white : c_gray;
	c2 = (delselect == 1) ? c_white : c_gray;
	tdp_draw_text_color((SCREEN_WIDTH / 2) - 100, (SCREEN_HEIGHT / 2) + 30, lang_get_value("option_yes"), c1, c1, c1, c1, 1);
	tdp_draw_text_color((SCREEN_WIDTH / 2) + 100, (SCREEN_HEIGHT / 2) + 30, lang_get_value("option_no"), c2, c2, c2, c2, 1);
	tdp_text_commit(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT);
}
if (state == states.portal)
{
	draw_set_alpha(0.5);
	draw_rectangle_color(0, 0, room_width, room_height, 0, 0, 0, 0, false);
	draw_set_alpha(1);
	draw_set_font(lang_get_font("bigfont"));
	draw_set_halign(fa_center);
	draw_set_valign(fa_middle);
	tdp_draw_text_color(SCREEN_WIDTH / 2, (SCREEN_HEIGHT / 2) - 130, almost ? lang_get_value("menu_importalmost") : lang_get_value("menu_import"), c_white, c_white, c_white, c_white, 1);
	var filepathpt = environment_get_variable("APPDATA") + "/PizzaTower_GM2/saves/saveData";
	var filepathfr = get_save_folder() + "/saveData";
	for (var i = 0; i < 6; i++)
	{
		if (!almost)
		{
			if (i <= 2)
			{
				var _c = file_exists(filepathpt + string(i+1) + ".ini") ? c_white : c_gray;
				show_debug_message(filepathpt + string(i+1) + ".ini");
			}
			else
			{
				var _c = file_exists(filepathpt + string(i - 2) + "N.ini") ? c_white : c_gray;
				show_debug_message(filepathpt + string(i - 2) + "N.ini");
			}	
		}
		else
			var _c = fileselected == i ? c_yellow : c_gray;
		tdp_draw_text_color((SCREEN_WIDTH / 2) - 300, (SCREEN_HEIGHT / 2) - 80 + (40 * i), "FILE " + string(i+1), _c, _c, _c, _c, 1);
	}
	if (!almost)
	{
		var arrowy = (SCREEN_HEIGHT / 2) - 80 + (cursel * 40);
		draw_sprite_ext(spr_uparrow, 0, (SCREEN_WIDTH / 2) - 400, arrowy, 1, 1, 270, c_white, 1);
		tdp_text_commit(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT);
		
		//little chungus text...
		if (cursel <= 2)
			ini_open(filepathpt + string(cursel+1) + ".ini");
		else
			ini_open(filepathpt + string(cursel-2) + "N.ini");
		var fileinfo =
		{
			status : ini_read_real("Game", "percent", 0),
			rank : ini_read_string("Game", "finalrank", "none"),
			john : ini_read_real("Game", "john", false),
			snotty : ini_read_real("Game", "finalsnotty", false),
			minutes : ini_read_real("Game", "minutes", 0),
			seconds : ini_read_real("Game", "seconds", 0)
		};
		ini_close();
		draw_set_font(global.font_small);
		draw_text((SCREEN_WIDTH / 2), (SCREEN_HEIGHT / 2), "Percentage: " + string(fileinfo.status));
		draw_text((SCREEN_WIDTH / 2), (SCREEN_HEIGHT / 2) + 40, "Final Rank : " + fileinfo.rank);
		var time = (fileinfo.minutes * 60000) + (round(fileinfo.seconds) * 1000);
		draw_text((SCREEN_WIDTH / 2), (SCREEN_HEIGHT / 2) + 80, "Playtime : " + get_time(time));
	}
	else
	{
		if (cursel <= 3)
			var arrowy = (SCREEN_HEIGHT / 2) - 80 + (cursel * 40);
		else
			var arrowy = (SCREEN_HEIGHT / 2) + 80;
		draw_sprite_ext(spr_uparrow, 0, (SCREEN_WIDTH / 2) + 400, arrowy, 1, 1, 90, c_white, 1);
		var charaarr;
		for(var i = 0; i < 10; i++)
		{
			if (file_exists(filepathfr + string(i+1) + ".ini"))
			{
				ini_open(filepathfr + string(i+1) + ".ini");
				var charatemp = ini_read_string("Game", "character", "noone");
				switch (charatemp)
				{
					case "P":
						charaarr[i] = 0;
						break;
					case "N":
						charaarr[i] = 1;
						break;
					default:
						charaarr[i] = 2;
						break;
				}
			}
			else
				charaarr[i] = 2;
		}
		if (file_exists(filepathfr + string(cursel+1) + ".ini"))
		{
			draw_set_font(global.font_small);
			draw_text((SCREEN_WIDTH / 2), (SCREEN_HEIGHT / 2), "WARNING! You have a file saved in this slot!");
		}
		draw_set_font(global.bigfont);
		for (var i = 0; i < 10; i++)
		{
			var texty = (40 * i);
			tdp_draw_text_color((SCREEN_WIDTH / 2) + 300, ((SCREEN_HEIGHT / 2) - 80) + texty, "FILE " + string(i+1), c_white, c_white, c_white, c_white, 1);
			draw_sprite(spr_saveicon, charaarr[i], (SCREEN_WIDTH / 2) + 150, ((SCREEN_HEIGHT / 2) - 80) + texty);
		}
	}
}

