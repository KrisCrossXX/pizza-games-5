		alarm[0] = 8;
		image_xscale = _xscale;
		hsp = 0;
		vsp = _velocity;
		image_blend = global.afterimage_color1;
	}
	with (create_afterimage(_x, _y, _sprite, _image_index))
	{
		identifier = afterimage.heatattack;
		alarm[1] = -1;
		alarm[2] = -1;
		alarm[0] = 8;
		image_xscale = _xscale;
		hsp = 0;
		vsp = -_velocity;
		image_blend = global.afterimage_color1;
