					movespeed = approach(movespeed, 16*xscale, 0.5)
				if place_meeting(x + sign(hsp), y, obj_solid) && sprite_index != spr_mrstick_airdashbump && !place_meeting(x + sign(hsp), y, obj_metalblock) && !place_meeting(x + sign(hsp), y, obj_destructibles)
				{
					sprite_index = spr_mrstick_airdashbump;
