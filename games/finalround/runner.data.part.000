				}
			}
			if (((sprite_index == spr_playerM_rocketrun || sprite_index == spr_playerM_rocket || sprite_index == spr_playerM_rocketrun) && !key_attack) and grounded)
			{
				if (movespeed > 6)
				{
					fmod_event_one_shot_3d("event:/sfx/pep/break", x, y);
					sprite_index = spr_machslidestart;
					state = states.machslide;
					image_index = 0;
				}
			}
			image_speed = .35;
		break;
	}
