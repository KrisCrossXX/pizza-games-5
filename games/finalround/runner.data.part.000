		sprite_index = spr_machslideboost;
	}
	else if (move == -xscale && movespeed < 8 && grounded && vsp > 0 && skateboarding == 0)
	{
		xscale *= -1;
		movespeed = 6;
	}
	if (clowntimer > 0 && skateboarding == 1)
