draw_set_alpha(bgAlpha);
draw_rectangle(0, 0, obj_screensizer.actual_width, obj_screensizer.actual_height, false);
draw_set_font(global.smallfont);
draw_set_color(c_white);
draw_set_alpha(1);
draw_set_valign(fa_top);
draw_set_halign(fa_left);

if ((state == STATE_LOADING) || (state == STATE_NOTHING)) {
	draw_set_valign(fa_middle);
	draw_set_halign(fa_center);
	draw_text((obj_screensizer.actual_width * 0.5), (obj_screensizer.actual_height * 0.5), "...");

} else if ((state == STATE_READY)) {
	var pageMax = ds_map_find_value(scores, "pageMax");
	if ((pageMax == "") || is_undefined(pageMax))
		pageMax = "1";
		
	var rankings = ds_map_find_value(scores, "scores");
	var textY = 53;
	
	for (var i = 0; i < ds_list_size(rankings); i++) {
		var listing = ds_list_find_value(rankings, i);
		var place = ds_map_find_value(listing, "place");
		if ((place == "1"))
			draw_set_color(c_yellow);
		else
			draw_set_color(c_white);
			
		draw_text(16, textY, concat(place, "."));
		
		var username = ds_map_find_value(listing, "username");
		if ((username == "") || is_undefined(username))
			username = "NONE";
			
		draw_text(64, textY, string_upper(username));
		
		var timeRaw = ds_map_find_value(listing, "time");
		if ((timeRaw == "") || is_undefined(timeRaw))
			timeRaw = "0";
			
		timeRaw = int64(timeRaw);
		var ms = (timeRaw % 10);
		var ss = (timeRaw / 10);
		var mm = (ss / 60);
		var hh = (mm / 60);
		ss -= (floor(mm) * 60);
		mm -= ((floor(hh) * 60) * 60);
		ms = floor(ms);
		ss = floor(ss);
		mm = floor(mm);
		hh = floor(hh);
		hh = ((hh < 1) ? "" : concat(hh, ":"));
		mm = ((floor(mm) < 1) ? "00" : ((mm <= 9) ? concat("0", mm) : mm));
		ss = ((floor(ss) < 1) ? "00" : ((ss <= 9) ? concat("0", ss) : ss));
		
		draw_text(300, textY, concat(hh, mm, ":", ss, ".", ms));
		
		var scorre = ds_map_find_value(listing, "score");
		if ((scorre == "") || is_undefined(scorre))
			scorre = "NO DATA";
		
		draw_text(400, textY, scorre);
		
		var charText = ds_map_find_value(listing, "char");
		if ((charText == "") || is_undefined(charText))
			charText = "N/A";
			
		charText = string_upper(scr_char_name(charText));

		draw_text(550, textY, string_upper(charText));
		
		var rankText = ds_map_find_value(listing, "rank");
		if ((rankText == "") || is_undefined(rankText))
			rankText = "N/A";
			
		switch(rankText) {
			case "p":
				draw_set_color(c_purple);
				break
			case "s":
				draw_set_color(c_yellow);
				break
			case "a":
				draw_set_color(c_red);
				break
			case "b":
				draw_set_color(c_teal);
				break
			case "c":
				draw_set_color(c_green);
				break
			
		}
		
		draw_text(500, textY, string_upper(rankText));
		
		textY += 29;
		
	}
	
	draw_set_color(c_white);
	draw_text(16, 495, concat("PAGE ", string(page), " OF ", pageMax));
	
}

