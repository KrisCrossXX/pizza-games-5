				notification_push(notifs.interact_granny, [lang_name]);
			}
		}
		break;
	
	case states.fall:
		text_y += text_vsp;
		if (text_vsp < 20)
			text_vsp += 0.5;
		if (text_y > text_ystart)
			text_state = states.normal;
		break;
	
	case states.normal:
		text_y = Approach(text_y, text_ystart, 2);
		if (!place_meeting(x, y, obj_player) || _hide)
			text_state = states.titlescreen;
		break;
}
