tutorial1 = "Â¡Pulsa [J] para saltar! Â¡MantÃ©n pulsada [D] y una direcciÃ³n para arrastrarte!"
tutorial2 = "Puedes romper bloques de mÃ¡rmol y metal por debajo de ti con un barrigazo. Â¡Pulsa [g] mientras estÃ©s en el aire!"
tutorial3 = "Inicia el barrigazo desde mÃ¡s altura para destruir los bloques de metal."
tutorial4 = "Puede que algunos bloques estÃ©n ocultos; Â¡intenta localizarlos! Pulsa [G] para destruirlos."
tutorial5 = "Pulsa [G] para hacer el agarrÃ³n veloz. Â¡Puede destruir los bloques de mÃ¡rmol!"
tutorial6 = "MantÃ©n pulsada [M] para iniciar un carrerÃ³n. Si mantienes pulsada [M] y saltas hacia una pared, Â¡empezarÃ¡s a correr por ella!"
tutorial7 = "Pulsa [J] mientras corres por la pared para saltar hacia el lado opuesto. MantÃ©n pulsada [M] para seguir por otras paredes. Un consejo: TambiÃ©n puedes usar el agarrÃ³n veloz para iniciar una carrera por la pared mientras estÃ¡s en el aire, Â¡solo tienes que mantener pulsada [M]!"
tutorial8 = "Â¡Pulsa [G] y, a continuaciÃ³n, mantÃ©n pulsada [M] para empezar un carrerÃ³n al instante! Â¡Haz la prueba!"
tutorial9 = "TambiÃ©n puedes saltar tras pulsar [G] para dar un gran salto."
tutorial10 = "TambiÃ©n puedes correr por una pendiente adyacente a una pared para seguir corriendo por esta automÃ¡ticamente."
tutorial11 = "Mientras haces un carrerÃ³n, mantÃ©n pulsada [D] para destruir los bloques de los huecos pequeÃ±os."
tutorial12 = "Suelta [D] y mantÃ©n pulsada [M] para continuar el carrerÃ³n."
tutorial13 = "MantÃ©n pulsada [D] durante un carrerÃ³n, y mientras estÃ¡s en el aire, para hacer un picado."
tutorial14 = "Para destruir los bloques de metal, necesitas acelerar; para eso, usa el carrerÃ³n. TambiÃ©n puedes mantener pulsada [F] para acelerar aÃºn mÃ¡s."
tutorial15 = "Â¡Correr pendiente abajo te harÃ¡ ir mÃ¡s rÃ¡pido!"
tutorial16 = "Para girar durante un carrerÃ³n, pulsa la direcciÃ³n opuesta."
tutorial17 = "Intenta girar antes de caer por un agujero; conservarÃ¡s la velocidad una vez caigas al suelo."
tutorial18 = "A gran velocidad, mantÃ©n pulsada [s] y suÃ©ltala para dar un Â¡supersalto! TambiÃ©n puedes corregir tu posiciÃ³n con [L][R] mientras mantienes pulsada [s]."
tutorial19 = "DespuÃ©s de iniciar un supersalto, tambiÃ©n puedes impulsarte hacia adelante en el aire pulsando [G]. Â¡IntÃ©ntalo!"
tutorial20 = "Otro truco: Pulsa [G] y luego [D] inmediatamente para pasar mÃ¡s rÃ¡pido por los huecos."
tutorial21 = "Puedes agarrar objetos con el agarrÃ³n veloz y lanzarlos pulsando [G] otra vez."
tutorial22 = "Si mantienes pulsada [U] antes de lanzar, Â¡tirarÃ¡s las cosas hacia arriba!"
tutorial23 = "Hazte con ellas para conseguir un mejor rango. Algunas solo podrÃ¡s conseguirlas durante la huida."
tutorial24 = "Tienes que salvar a la mayorÃ­a de los tipos de las jaulas para pasar a la siguiente planta. Â¡Te darÃ¡n dinero para pagar al Sr. Stick! Si dejas por detrÃ¡s a demasiados, Â¡tendrÃ¡s que volver a jugar algunos niveles!"
tutorial25 = "Destruye a John el pilar para abrir la puerta de salida. Â¡Eso invertirÃ¡ los bloques de columna sÃ³lidos!"
tutorial_lapunlock = "{s}Â¡Todos los portales de la vuelta 2 desbloqueados!/"
getout = "Â¡SAL YA!"
forest1 = "MantÃ©n pulsada [M] para moverte mÃ¡s rÃ¡pido y destruir los bloques de metal."
forest2 = "Pulsa [U][G] para patear a la rata."
forest3 = "Pulsa [J] en el aire para hacer un salto doble. TambiÃ©n puedes anularlo haciendo otro movimiento."
forest4 = "Pulsa [D] en el aire para bajar rÃ¡pido."
forest5 = "El salto doble tambiÃ©n puede destruir los bloques de metal que hay debajo."
forest6 = "Mientras das el salto doble, mantÃ©n pulsada [J] en direcciÃ³n a una pared para escalarla."
hubtips1 = "Â¿Sabes que puedes asestar un gancho mientras vuelas pulsando [U] y luego [G]? Â¡Puede funcionar como una especie de salto doble y tambiÃ©n puede despachar a los enemigos en el aire!"
hubtips2 = "DespuÃ©s de liquidar a unos cuantos enemigos, notarÃ¡s un efecto electroestÃ¡tico a tu alrededor. Â¡Mientras ese efecto estÃ© activo, pulsa [U] y luego [T] para eliminar a todos los enemigos de la pantalla!"
hubtips3 = "Â¿Sabes que puedes bloquear y parar cualquier proyectil o daÃ±o pulsando [T] antes de que te daÃ±en?"
hubtips4 = "No te fÃ­es de tu juicio final. Tu desempeÃ±o siempre se tiene en cuenta."
hubtips5 = "Una vez superado un nivel, puedes volver a visitarlo y encontrar un portal de vuelta 2 cerca de la entrada. Estos portales te darÃ¡n una bonificaciÃ³n de puntos, pero tambiÃ©n te obligarÃ¡n a dar una vuelta alrededor de la zona de huida otra vez."
hubtips6 = "Â¿Sabes que puedes hacer un rompecuellos sujetando a un enemigo y pulsando [D] mientras estÃ¡is en el aire? TambiÃ©n puedes llevar a cabo un rompecuellos que te impulsarÃ¡ hacia arriba si mantienes pulsada [U] antes de agarrar a un enemigo."
hubtips7 = "Una tÃ©cnica oscura: Si haces un picado en el aire y, mientras, pulsas [J], caerÃ¡s directamente dando un barrigazo. Â¡Solo es Ãºtil si quieres ahorrar tiempo!"
hubtips8 = "Â¿Sabes que puedes hacer que los enemigos reaccionen mÃ¡s rÃ¡pido ante ti pulsando [T] cerca de ellos?"
hubtips9 = "El escurridizo rango P... Puedes conseguirlo haciendo todo lo que hay que hacer en un nivel. Â¡El problema es que tienes que mantener un combo durante todo el nivel! Es un reto difÃ­cil, asÃ­ que no te sientas mal si no quieres afrontarlo."
garbage1 = "Â¿Sabes que tu nombre completo es Peppino Spaghetti? QuÃ© mala pata."
garbage2 = "Si haces mÃ¡s daÃ±o de la cuenta a Peppino, Â¡te pudriras en el infierno!"
garbage3 = "Â¿QuÃ© sabes de esta torre? Â¿QuiÃ©n eres? Â¡No sÃ© nada!"
garbage4 = "Â¡Hoy por ti, maÃ±ana por mÃ­!"
garbage5 = "Yo no me fiarÃ­a de ese tal Gustavo. Demasiado amistoso para mi gusto."
garbage6 = "Voy a seguir adelante y hablar de algo que he estado diciendo a otros que saben acerca de este lugar de culto que has hecho esto. Bueno, estamos abajo de tu pizzerÃ­a, y estamos abajo de esta torre. Hay clientes y quieren ver una de estas cosas. AsÃ­ que cogÃ­ a un amigo, Ã©l bajÃ³ una de las plantas y este tipo subiÃ³ a mi lado; y la idea era: Â¿por quÃ© cuando estÃ¡s en la parte superior de la torre estÃ¡ este personaje, Pizzaface, y luego hay un hombre de tu vida anterior que va en cabeza? Hay una pizza en tu torre con toda esta informaciÃ³n."
garbage7 = "Â¡Pizza de regalo por jugar a Pizza Tower! Â¡Escribe Â«/pizzaÂ» para pedir una pizza gratis cortesÃ­a de Pizzas Peppino!"
garbage8 = "Recuerda no descansar mucho, Â¡sigue jugando! Â¡AquÃ­, tienes un tiempo limitado!"
garbage9 = "He vuelto a saltarme la medicaciÃ³n, Antonia. Â¡Vaya asco de dÃ­a me espera!"
garbage10 = "No creo que necesites ninguna pista hoy."
garbage11 = "Â¿En serio crees que voy a darte mÃ¡s consejos despuÃ©s de cÃ³mo acabas de meter la pata?"
garbage12 = "Tu nevera huele un poco raro. Â¿Has comprobado la fecha de caducidad?"
garbage13 = "Sabes..., podrÃ­as adelgazar un poco."
garbage14 = "Â¿Vas a jugar o vas a seguir ahÃ­, tonteando?"
garbage15 = "Â¡A tomar por culo!"
