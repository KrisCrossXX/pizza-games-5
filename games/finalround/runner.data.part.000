		else if (spinsndbuffer > 0)
			spinsndbuffer--;
		if (floor(image_index) == 0)
			spinsndbuffer = 5;
		if (scr_solid(x + xscale, y) && (!place_meeting(x + sign(hsp), y, obj_slope) || scr_solid_slope(x + sign(hsp), y)) && !place_meeting(x + sign(hsp), y, obj_destructibles))
