function tools__dictionary_dictionary_impl__clear(l_this1){
	// tools__dictionary_dictionary_impl__clear(this:any)
	/// @ignore
	var l_keys=variable_struct_get_names(l_this1);
	var l__g=0;
	while(l__g<array_length(l_keys)){
