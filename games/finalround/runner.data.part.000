		}
		if sprite_index == spr_pizzahead_grabitemtransition
		{
			var ix = floor(image_index);
			with propID
			{
				hsp = 0;
				vsp = 0;
				switch ix
				{
					case 0:
						y = other.y + 300;
						break;
					case 1:
						y = other.y + 129;
						break;
					case 2:
						y = other.y + 26;
						break;
					case 3:
						y = other.y - 40;
						x = other.x + 30;
						break;
				}
			}
			if (floor(image_index) == image_number - 1)
			{
				fmod_event_one_shot_3d("event:/sfx/pizzahead/throw", x, y);
