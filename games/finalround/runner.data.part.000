			{
				movespeed = 0;
				if (targetplayer.x != x)
					image_xscale = sign(targetplayer.x - x);
				else
					image_xscale *= -1;
			}
		}
		else if (movespeed < 18)
			movespeed += 1;
		hsp = image_xscale * movespeed;
		if (grounded && vsp > 0)
			vsp = -5;
		if (instance_exists(obj_ham))
