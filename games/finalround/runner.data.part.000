␀␀␀␀␀
␀␀␀8␀␀function scr_player_grind()
{
	sprite_index = !skateboarding ? spr_grind : spr_clown;
	image_speed = 0.35;
	machhitAnim = false;
	crouchslideAnim = true;
	hsp = xscale * movespeed;
	if (movespeed < 10)
		movespeed = Approach(movespeed, 10, 0.5);
	if !place_meeting(x, y + 18, obj_grindrail) && !place_meeting(x, y + 18, obj_grindrailslope)
	{
		if character == "M"
		{
			state = states.mach3;
			sprite_index = spr_playerM_shoulderloop;
		}
		else
		{
			if movespeed < 12 || skateboarding
			{
				state = states.mach2;
				sprite_index = spr_mach2jump;
			}
			else
			{
				state = states.mach3;
				sprite_index = spr_mach4;
			}
		}
	}
	if (character == "N" || character == "D") && key_down
	{
		ignore_grind = true;
		state = states.mach2;
		sprite_index = spr_playerN_grindcancel;
		image_index = 0;
		vsp = 10;
		if (movespeed < 6)
			movespeed = 6;
		exit;
	}
	if (place_meeting(x + xscale, y, obj_solid) && !place_meeting(x, y + 18, obj_grindrailslope) && !place_meeting(x, y + 1, obj_slope))
	{
		if character != "N" && character != "D"
		{
			state = states.bump;
			hsp = -xscale * 5;
			vsp = 1;
		}
		else
			xscale *= -1;
	}
	if (input_buffer_jump > 0)
	{
		input_buffer_jump = 0;
		with (instance_create(x, y, obj_jumpdust))
			image_xscale = other.xscale;
		vsp = -11;
		jumpstop = false;
		if character == "M"
		{
			state = states.mach3;
			sprite_index = spr_playerM_shoulderloop;
		}
		else 
		{
			if (skateboarding)
			{
				sprite_index = spr_clownjump;
				image_index = 0;
			}
			if (movespeed < 12 || skateboarding)
			{
				state = states.mach2;
				sprite_index = spr_mach2jump;
			}
			else
			{
				state = states.mach3;
				sprite_index = spr_mach3jump;
			}
		}
	}
	if (!instance_exists(obj_grindeffect) && !(character == "N" || character == "D" || character == "M"))
		instance_create(x, y, obj_grindeffect);
}
