function ratmount_kickbrick()
{
	var _pad = 32;
	fmod_event_one_shot_3d("event:/sfx/enemies/killingblow", x + (image_xscale * _pad), y);
	switch global.gus_transfo
	{
		default:
			with instance_create(x + (image_xscale * _pad), y, obj_brickball)
			{
				switch global.gus_transfo
				{
					case transfos.knight:
						sprite_index = spr_knightbrick_slide;
						transformation = transfos.knight;
						break;
					case transfos.bomb:
						transformation = transfos.bomb;
						sprite_index = spr_brickbomb;
						vsp = -10;
						break;
				}
				if (other.state == states.ratmountjump || other.state == states.ratmountbounce)
					up = true;
				image_xscale = other.xscale;
				xoffset = _pad;
				playerid = self;
			}
			state = states.ratmountgroundpound;
			sprite_index = spr_lonegustavokick;
			image_index = 0;
			image_speed = 0.35;
			gustavokicktimer = 5;
			brick = false;
			break;
		case transfos.firemouth:
			with instance_create(x + (image_xscale * _pad), y, obj_playerM_firemouthproj)
			{
				sprite_index = spr_pepperpizza_projectile;
				hsp = other.xscale * -12;
				if (other.state == states.ratmountjump || other.state == states.ratmountbounce)
					up = true;
				image_xscale = other.xscale;
				xoffset = _pad;
				playerid = self;
			}
			state = !grounded ? states.ratmountjump : states.ratmount;
			sprite_index = spr_player_ratmountfiremouthspitout;
			image_index = 0;
			image_speed = .35;
			gustavokicktimer = 20;
			break;
	}
}

function scr_lonebrick_wait(_sprite = spr_lonebrick_wait)
{
	if character = "G" || isgustavo
	{
		if brick && !instance_exists(obj_brickcomeback) && !instance_exists(obj_brickball)
		{
			with instance_create(x, y, obj_brickcomeback)
			{
				wait = true;
				spr_wait = _sprite;
				sprite_index = spr_wait;
			}
		}
		brick = false;
	}
}

function ratmount_shootpowerup()
{
	if (key_shoot2 && ratpowerup != noone && ratshootbuffer <= 0)
	{
		switch (ratpowerup)
		{
			case obj_noisegoblin:
				with (instance_create(x + (20 * xscale), y, obj_playernoisearrow))
					direction = point_direction(x, y, x + (other.xscale * 4), y);
				break;
			case obj_smokingpizzaslice:
				with (instance_create(x + (20 * xscale), y + 20, obj_playersmokehitbox))
				{
					spd += (other.movespeed / 2);
					image_xscale = other.xscale;
				}
				break;
			case obj_spitcheese:
				with (instance_create(x + (20 * xscale), y, obj_playerspikecheese))
				{
					spd += other.movespeed;
					image_xscale = other.xscale;
				}
				break;
		}
		ratshootbuffer = 30;
	}
