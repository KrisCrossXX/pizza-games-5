}␀␀␀␀B␀␀function scr_start_game(slot, char)
{
	instance_create(x, y, obj_fadeout);
	with (obj_player)
	{
		targetRoom = hub_loadingscreen;
		targetDoor = "A";
	}
	with (obj_savesystem)
		character = char;
	with (obj_player1)
	{
		character = char;
		scr_characterspr()
	}
	global.currentsavefile = slot;
	gamesave_async_load();
}
␀␀ú␀␀function scr_player_wallrundown()
{
	move = (key_left + key_right);
	if key_jump
	{
		fmod_event_one_shot_3d("event:/sfx/pep/jump", x, y)
		input_buffer_jump = 0
		movespeed = wallspeed
		if (xscale < 0)
			hsp = (movespeed * -1)
		else
			hsp = (movespeed * 1)
		state = states.mach2;
	}
	else if scr_solid((x - xscale), y)
	{
		if ((!(place_meeting((x - xscale), y, obj_destructibles))) && (!(place_meeting((x - xscale), y, obj_metalblock))))
		{
			if (!(scr_solid(x, (y + 1))))
			{
				if (wallspeed < 20)
					wallspeed += 0.5;
				vsp = wallspeed;
				sprite_index = spr_playerFP_climbwalldown;
			}
			else
			{
				movespeed = wallspeed;
				hsp = ((movespeed * xscale) * -1);
				state = states.mach2;
			}
		}
		else
		{
			movespeed = wallspeed;
			hsp = ((movespeed * xscale) * -1);
			state = states.mach2;
		}
	}
	else
	{
		if (move != 0)
		{
			xscale = move * 1;
			image_xscale = move;
		}
		movespeed = wallspeed;
		hsp = (movespeed * xscale);
		state = states.mach2;
		sprite_index = spr_mach;
	}
}␀␀±	␀␀function scr_eldiegodemon_actor()
{
	if !active
	{
		x = lerp(x, startx, lerpspd);
		y = lerp(y, starty, lerpspd);
		sprite_index = spr_tacodemon_spawn;
	}
	else
	{
		x = lerp(x, startx, lerpspd);
		y = lerp(y, stagey, lerpspd);
		visible = true;
		sprite_index = spr_tacodemon_idle;
		state = states.normal;
	}
}

function scr_eldiegodemon_normal()
{
	sprite_index = spr_tacodemon_idle;
	if scr_candecideattack()
	{
		attackdir *= -1;
		state = states.pizzagoblinthrow;
	}
	else
	{
		x = lerp(x, startx, lerpspd);
		y = lerp(y, stagey, lerpspd);
		if (ceil(x) == startx || floor(x) == startx) && (ceil(y) == stagey || floor(y) == stagey)
		{
			x = startx;
			y = stagey;
		}
		if attackbuffer > 0
			attackbuffer--;
		if laughbuffer > 0
		{
			sprite_index = spr_tacodemon_laugh;
			laughbuffer--;
		}
	}
}

function scr_candecideattack()
{
	return x == startx && y == stagey && attackbuffer <= 0;
}

function scr_eldiegodemon_reset()
{
	visible = false;
	image_speed = 0.35;
	if state == states.dead
	{
		if respawnbuffer > 0
			respawnbuffer--
		else
		{
			state = states.actor;
			active = true;
			visible = true;
		}
	}
	else
	{
		respawnbuffer = 0;
		active = false;
	}
	sprite_index = spr_tacodemon_spawn;
	startx = 480;
	starty = -64;
	stagey = 64;
	x = startx;
	y = starty;
	attackx = 160;
	attacky = 128;
	attackbuffer = 180 - (obj_noiseboss.wastedhits * 15);
	laughbuffer = 0;
	attackdir = choose(1, -1);
	lerpspd = 0.1;
	tacoprojID = noone;
}

function scr_eldiegodemon_throw()
{
	var _atkx = attackdir == 1 ? room_width - attackx : attackx;
	if (ceil(x) == _atkx || floor(x) == _atkx) && (ceil(y) == attacky || floor(y) == attacky)
	{
		x = _atkx;
		y = attacky;
		if sprite_index != spr_tacodemon_throw
		{
			sprite_index = spr_tacodemon_throw;
			image_index = 0;
		}
		if anim_end(27) && tacoprojID == noone
		{
			with instance_create(x, y, obj_tacoprojectile)
			{
				var playerid = obj_player1;
				if (global.coop && instance_nearest(x, y, obj_player).object_index == obj_player2)
					playerid = obj_player2;
				var dir = point_direction(x, y, playerid.x, playerid.y);
				hsp = lengthdir_x(10, dir);
				vsp = lengthdir_y(10, dir);
				other.tacoprojID = id;
			}
		}
		if anim_end()
		{
			sprite_index = spr_tacodemon_idle;
			state = states.normal;
			attackbuffer = 180 - (obj_noiseboss.wastedhits * 15);
			tacoprojID = noone;
		}
	}
	else
	{
		x = lerp(x, _atkx, lerpspd);
		y = lerp(y, attacky, lerpspd);
	}
}

