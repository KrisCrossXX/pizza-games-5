boss_func = function()
{
	var eh = 0;
	var p = 0;
	with obj_noiseboss
	{
		eh = elitehit;
		p = phase;
		if ((p == 1 && state == states.fightball) || instance_exists(obj_noiseballooncrash)) && phase == 1
			eh = 0;
	}
	if p == 1
		boss_hp = eh;
	else if p == 2
		boss_hp = eh;
	else if p == 0
		boss_hp = 0;
}

