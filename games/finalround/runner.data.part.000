			cooldown--;
		else
		{
			shot--;
			fmod_event_one_shot_3d("event:/sfx/enemies/projectile", x, y);
			var dirs = [[1, 1], [1, -1], [-1, 1], [-1, -1]];
			cooldown = 35;
