		{
			sound_play_3d(sfx_mach2bump, x, y);
			sound_play_3d("event:/sfx/pep/jump", x, y);
			input_buffer_jump = 0;
			key_jump = false;
			if xscale == -1
				movespeed = 10;
			else
				movespeed = -10;
			railmovespeed = 0;
			state = states.kickflip;
			image_index = 0;
			sprite_index = spr_playerV_kickflipstart;
			vsp = -14.5;
