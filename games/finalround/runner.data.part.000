			state = states.normal;
		}
	}
	with obj_frontcanongoblin_trigger
		active = true;
}
else if !start
{
	with obj_frontcanongoblin
	{
		if state != states.dead && !destroyed
		{
			destroyed = false;
			destroybuffer = 50;
			state = states.dead;
			captain_sprite = other.playerid.character == "D" ? spr_captainpeddito_end : spr_captaingoblin_end;
			canon_sprite = spr_captaingoblin_canon;
			captain_index = 0;
