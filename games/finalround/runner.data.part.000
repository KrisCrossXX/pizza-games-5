	x = _playerinst.x + (_playerinst.xscale * 16);
	y = _playerinst.y;
	image_xscale = sign(_playerinst.x - x);
	with (_playerinst)
	{
		if (state != states.pummel)
		{
			with (other)
			{
				stagger_dir = -image_xscale;
				state = states.staggered;
				stagger_buffer = stagger_max;
				hsp = 0;
			}
			exit;
		}
		if (sprite_index == spr_grab)
		{
			if (key_slap2)
			{
				if (other.hp > 0)
				{
