␀␀]␀␀function editor_is_cursor_on_ui(_x, _y)
{
	var num = instance_place_list(_x, _y, obj_uiparent, global.instancelist, false);
	var found = false;
	for (var i = 0; i < num; i++)
	{
		with (ds_list_find_value(global.instancelist, i))
		{
			if (active)
			{
				found = true;
				break;
			}
		}
	}
	ds_list_clear(global.instancelist);
	return found;
}
␀␀␀␀␀global.usedpieces = []
function scr_pf_pieces()
{
	if global.laps < 2 || global.fill <= 0
		exit;	
	
	var pieces = [spr_pf_piece0, spr_pf_piece1, spr_pf_piece2, spr_pf_piece3, spr_pf_piece4, spr_pf_piece5, spr_pf_piece6, spr_pf_piece7]
	var got = -1;
	for (var i = 0; i < array_length(pieces) && got == -1; i++)
	{
		if !array_contains(global.usedpieces, pieces[i])
			got = i
	}
	if got != -1
	{
		var add = 0;
		repeat 2
		{
			with instance_create(0, 0, obj_pizzaface_pieces)
			{
				target = obj_player1
				var index = got + add++
				sprite_index = pieces[index]
				angle = 45 * index
				array_push(global.usedpieces, sprite_index)
			}
		}
	}
}␀␀J␀␀function scr_charswitch_gotostate(newstate) {
	nextstate = newstate;
	state = charstate.tvstatic;
	alarm[0] = CHARSWITCH_STATICTIME;

}

function scr_character_to_int(char) {
	switch(char) {
		case "P":
			return 0;
			break;
		
		case "M":
			return 1;
			break;
		
		case "V":
			return 2;
			break;
		
		case "N":
			return 3;
			break;
		
		case "FP":
			return 4;
			break;
			
			
	}
	
	return 0;

}

function scr_int_to_character(int) {
	switch(int) {
		case 0:
			return "P";
			break;
		
		case 1:
			return "M";
			break;
		
		case 2:
			return "V";
			break;
		
		case 3:
			return "N";
			break;
		
		case 4:
			return "FP";
			break;
		
	}
	
	return "P";

}

function scr_charswitch_changechar(nextchar) {
	scr_charswitch_gotostate(charstate.selecting);
	curchar = scr_int_to_character(scr_character_to_int(curchar)+nextchar);

}␀␀±␀␀function commands_update() //commands_update
{
    if key_redo
    {
        if (command_current < ds_list_size(commands_list))
        {
            var cmd = ds_list_find_value(commands_list, command_current++)
            cmd.execute()
        }
    }
    if key_undo
    {
        if (command_current > 0)
        {
            cmd = ds_list_find_value(commands_list, --command_current)
            cmd.undo()
        }
    }
}

