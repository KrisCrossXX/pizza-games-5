						fmod_event_one_shot_3d("event:/sfx/enemies/pizzardelectricity", x, y)
						image_xscale = other.image_xscale;
					}
				}
				break;
			case obj_swedishmonkey:
				if (elite)
				{
					with (instance_create(x, y, obj_evilbanana))
					{
						baddieID = other.id;
