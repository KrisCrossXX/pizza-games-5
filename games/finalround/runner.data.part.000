}␀š␀␀function scr_next_character(char, inclAny = false) {
	var nextChar = global.nextCharacter[$ char];
	if(nextChar == "any" && !inclAny)
		nextChar = global.nextCharacter[$ nextChar];
		
	return nextChar;

}

function scr_prev_character(char, inclAny = false) {
	var nextChar = global.prevCharacter[$ char];
	if(nextChar == "any" && !inclAny)
		nextChar = global.prevCharacter[$ nextChar];
		
	return nextChar;

}␀␀Ï␀␀function Textbox(_dialog, _textsp) constructor 
{
	scr_menu_getinput();
	x1 = 100;
	x2 = 860;
	y1 = 500;
	y2 = 600;
	dialogtxt = _dialog;
	speed = _textsp;
	finished = false;
	alarm = [speed];
	text_i = 0;
	text_line = 0;
	str = "";
	image_alpha = 0;
	
	static update = function() 
	{
		image_alpha = lerp(image_alpha, !finished, 0.1);
		y1 = lerp(y1, 400, 0.1);
		if finished
			exit;
		if (alarm[0] < 0 && text_i < string_length(dialogtxt[text_line])) 
		{
			alarm[0] = speed;
			text_i++;
			str += string_char_at(dialogtxt[text_line], text_i);
		}
		if key_jump && text_i >= string_length(dialogtxt[text_line]) 
		{
			if text_line < array_length(dialogtxt) - 1
			{
				text_i = 0;
				text_line++;
				str = "";
				alarm[0] = speed;
			}
			else
			{
				finished = true;
			}
		}
		for (var a = 0; a < array_length(alarm); a++) 
		{
			if (alarm[a] > -1) alarm[a]--;
		}
	}
	
	static draw = function() 
	{
		draw_set_alpha(image_alpha);
		draw_set_align(fa_left, fa_top);
		var width = x2 - x1;
		var height = y2 - y1;
		draw_sprite_stretched(spr_textbox, 0, x1, y1, width, height);
		draw_set_font(global.font_small);
		draw_set_color(c_white);
		draw_text_ext(x1 + 16, y1 + 16, str, 18, width);
		draw_set_alpha(1);
	}
}␀␀␀function instance_exists_with_var(obj, var_name){
	var e = false;
	if (instance_exists(obj)) {
		for (var i = 0; i < instance_number(obj); i++) {
			if (variable_instance_get(instance_find(obj, i), var_name) == id) {
				e = true;
			}
		}
	} else {
		e = false;
	}
	return e;
}
␀␀␀function tdp_draw_text(x, y, str)
{
	if !global.tdp_text_enabled
		draw_text(x, y, str);
	else
	{
		var c = draw_get_color();
		var a = draw_get_alpha();
		tdp_text_action_text(x, y, str, c, c, c, c, a);
	}
}
function tdp_draw_text_color(x, y, str, c1, c2, c3, c4, alpha)
{
	if !global.tdp_text_enabled
		draw_text_color(x, y, str, c1, c2, c3, c4, alpha);
	else
		tdp_text_action_text(x, y, str, c1, c2, c3, c4, alpha);
}
function tdp_draw_set_halign(halign)
{
	draw_set_halign(halign);
	if global.tdp_text_enabled
		tdp_text_action_halign(halign);
}
function tdp_draw_set_valign(valign)
{
	draw_set_valign(valign);
	if global.tdp_text_enabled
		tdp_text_action_valign(valign);
}
function tdp_draw_set_font(font)
{
	draw_set_font(font);
	if global.tdp_text_enabled
		tdp_text_action_font(font);
}
