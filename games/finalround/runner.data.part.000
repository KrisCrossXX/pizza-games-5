␀␀ö␀␀function scr_player_antigrav()
{
	if character == "N" || character == "D"
	{
		sprite_index = spr_playerN_bubbleidle;
		move_h = key_right_axis + key_left_axis;
		move_v = key_up_axis + key_down_axis;
		move = key_left + key_right;
		if move_h == 0
			move_h = key_right + key_left;
		if move_v == 0
			move_v = key_down - key_up;
		if target_vsp > -16 && !(key_down && character == "D")
		{
			if target_vsp > 0
				target_vsp -= character == "D" ? 1.3 : 0.3;
			else
				target_vsp -= character == "D" ? 1.2 : 0.2;
		}
		hsp = Approach(hsp, move_h * 8, 0.5);
		image_speed = abs(vsp) / 15;
		if key_up && character != "D" || key_down && character == "D"
		{
			image_speed = clamp(image_speed, 0.35, 0.65);
			sprite_index = character == "D" ? spr_playerD_bubbledown : spr_playerN_bubbleup;
			if target_vsp > -16 && target_vsp <= 0 && character != "D" || character == "D" && target_vsp < 16
				target_vsp = character == "D" ? target_vsp + 0.8 : target_vsp - 0.8;
		}
		if !key_down && grounded && character == "D"
			target_vsp = -1; // prevents doise from briefly being stuck grounded
		vsp = target_vsp;
		if input_buffer_jump > 0
		{
			input_buffer_jump = 0;
			movespeed = abs(hsp);
			state = states.jump;
			sprite_index = spr_machfreefall;
			fmod_event_one_shot_3d("event:/sfx/antigrav/end", x, y);
		}
		var grd = (grounded && character == "D");
		if scr_solid(x, y - 1) || grd
		{
			GamepadSetVibration(0, 0.6, 0.6, 0.2);
			fmod_event_one_shot_3d("event:/sfx/antigrav/bump", x, y);
			target_vsp = (grd ? -8 : 8);
			with (obj_antigravbubble)
			{
				sprite_index = spr_antigrav_bubblesquish;
				image_index = 0;
			}
			with (create_debris(x, y, spr_slapstar))
			{
				hsp = random_range(-5, 5);
				vsp = random_range(-10, 10);
			}
		}
		if (place_meeting(x + hsp, y, obj_solid) && !place_meeting(x + hsp, y, obj_slope) && !place_meeting(x + hsp, y, obj_ratblock) && !place_meeting(x + hsp, y, obj_destructibles))
		{
			GamepadSetVibration(0, 0.6, 0.6, 0.2);
			fmod_event_one_shot_3d("event:/sfx/antigrav/bump", x, y);
			hsp = -hsp * 0.8;
			repeat (3)
			{
				with (create_debris(x, y, spr_slapstar))
				{
					hsp = random_range(-5, 5);
					vsp = random_range(-10, 10);
				}
			}
		}
		if (steppybuffer > 0)
			steppybuffer--;
		else
		{
			instance_create(x + random_range(-50, 50), y + random_range(0, 50), obj_antigravbubbleeffect);
			steppybuffer = 8;
		}
		exit;
	}
	sprite_index = spr_currentplayer;
	if character == "N" || character == "D"
		sprite_index = spr_playerN_bubbleidle;
	else if character == "V"
		sprite_index = spr_playerV_bubbleidle;
	move = key_right + key_left;
	hsp = Approach(hsp, move * 8, 0.5);
	movespeed = hsp;
	if (vsp > -14)
		vsp -= 0.5;
	if scr_solid(x, y - 1) && character == "V"
		sprite_index = spr_playerV_bubbleslide;
	if (input_buffer_jump > 0)
	{
		input_buffer_jump = 0;
		movespeed = abs(hsp);
		state = isgustavo ? states.ratmountjump : states.jump;
		sprite_index = spr_machfreefall;
		fmod_event_one_shot_3d("event:/sfx/antigrav/end", x, y);
	}
	if scr_solid(x, y - 1) && character != "V"
	{
		GamepadSetVibration(0, 0.6, 0.6, 0.2);
		fmod_event_one_shot_3d("event:/sfx/antigrav/bump", x, y);
		vsp = 8;
		with (obj_antigravbubble)
		{
			sprite_index = spr_antigrav_bubblesquish;
			image_index = 0;
		}
		with (create_debris(x, y, spr_slapstar))
		{
			hsp = random_range(-5, 5);
			vsp = random_range(-10, 10);
		}
	}
	if (place_meeting(x + hsp, y, obj_solid) && !place_meeting(x + hsp, y, obj_slope) && !place_meeting(x + hsp, y, obj_ratblock) && !place_meeting(x + hsp, y, obj_destructibles))
	{
		GamepadSetVibration(0, 0.6, 0.6, 0.2);
		fmod_event_one_shot_3d("event:/sfx/antigrav/bump", x, y);
		hsp = -hsp * 0.8;
		repeat (3)
		{
			with (create_debris(x, y, spr_slapstar))
			{
				hsp = random_range(-5, 5);
				vsp = random_range(-10, 10);
			}
		}
	}
	if (steppybuffer > 0)
		steppybuffer--;
	else
	{
		instance_create(x + random_range(-50, 50), y + random_range(0, 50), obj_antigravbubbleeffect);
		steppybuffer = 8;
	}
	image_speed = abs(vsp) / 15;
	if character == "V"
		image_speed = .35;
}
␀␀Š␀␀function scr_pizzaball_thrown()
{
	if (stuntouchbuffer > 0)
		stuntouchbuffer--;
	switch (substate)
	{
		case states.thrown:
			image_speed = 0.5;
			if (sprite_index != spr_pizzaball_hitwall && sprite_index != spr_pizzaball_hitwall2)
				sprite_index = spr_pizzaball_roll;
			else if (floor(image_index) == (image_number - 1))
				sprite_index = spr_pizzaball_roll;
			hsp = image_xscale * hitspeed;
			if (grounded && vsp > 0)
			{
				if (!bounced)
				{
					fmod_event_one_shot_3d("event:/sfx/misc/golfbump", x, y);
					sprite_index = spr_pizzaball_hitwall2;
					image_index = 0;
					hitspeed *= 0.8;
					jumpspeed *= 0.25;
					vsp = -jumpspeed;
					bounced = true;
				}
				else
					substate = states.crouch;
			}
			if (scr_solid(x + hsp, y) && !place_meeting(x + hsp, y, obj_slope) && !place_meeting(x + hsp, y, obj_destructibles))
			{
				fmod_event_one_shot_3d("event:/sfx/misc/golfbump", x, y);
				sprite_index = spr_pizzaball_hitwall;
				image_index = 0;
				image_xscale *= -1;
				hitspeed *= 0.5;
			}
			break;
		case states.crouch:
			sprite_index = spr_pizzaball_roll;
			hitspeed = Approach(hitspeed, 0, 0.2);
			hsp = image_xscale * hitspeed;
			if (scr_solid(x + hsp, y) && !place_meeting(x + hsp, y, obj_slope) && !place_meeting(x + hsp, y, obj_destructibles))
				image_xscale *= -1;
			if (hitspeed == 0)
			{
				sprite_index = walkspr;
				state = states.walk;
			}
			break;
	}
}
␀␀h␀␀function cutscene_farm_middle()
{
	var _finish = false;
	with (obj_mort_inline)
	{
		sprite_index = spr_mortwalk;
		x += (dir * 5);
		if (!point_in_camera(x, y, view_camera[0]))
			_finish = true;
	}
	if (!instance_exists(obj_mort_inline))
		_finish = true;
	if (_finish)
		cutscene_end_action();
}
function cutscene_farm_end()
{
	with (obj_player)
	{
		state = states.normal;
		x = backtohubstartx;
		y = backtohubstarty;
	}
	global.levelcomplete = false;
	global.farmcutscene = true;
	global.levelcompletename = noone;
	quick_ini_write_real(get_savefile_ini(), "cutscene", "farm", true);
