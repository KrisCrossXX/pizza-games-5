		if (floor(image_index) == image_number - 1)
		{
			sprite_index = spr_pizzahead_grabitemtransition;
			image_index = 0;
			introstate++;
			var b = proparr[prop];
			prop++;
			with (instance_create(x + 42, y + 300, obj_pizzafacep3_prop))
			{
				depth = other.depth - 1;
				image_speed = 0.35;
				image_xscale = -1;
				stunspr = b[0];
				angryspr = b[1];
				mask_index = b[2];
				savedvsp = -11;
				savedhsp = b[3];
				if b[0] == spr_fakepeppino_stun
				{
					usepalette = true;
					if obj_player1.character == "P"
					{
						spr_palette = obj_player1.spr_palette;
						paletteselect = obj_player1.paletteselect;
					}
				}
				else if b[0] == spr_playerN_hurt && (obj_player1.character == "N" || obj_player1.character == "D")
				{
					usepalette = true;
					spr_palette = spr_noiseboss_palette;
					paletteselect = 1;
					stunspr = spr_doise_deadair;
