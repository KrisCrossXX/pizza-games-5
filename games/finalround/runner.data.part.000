		case "V":
			palinfo = get_vigi_palette_info();
			spr_palette = spr_vigilantepalette;
			spr_idle = spr_playerV_idle;
			spr_move = spr_playerV_move;
			spr_air = spr_playerV_spinjump2;
			spr_animatronic = spr_playerN_animatronic;
			spr_fightball = spr_playerN_fightball;
			if isgustavo
			{
				spr_palette = spr_ratmountpaletteV;
				spr_idle = spr_mortidle;
				spr_move = spr_mortwalk;
				spr_air = spr_mortspawn;
				spr_animatronic = spr_pepanimatronic;
				spr_suplexdash = spr_playerV_mortpunch;
				spr_fall = spr_mortfall;
				spr_dead = spr_playerV_morthurt;
				spr_taunt = spr_playerV_morttaunt;
