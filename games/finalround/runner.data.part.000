			case spr_tumblestart:
				sprite_index = spr_tumble;
				movespeed = 14;
				break;
			
			// Vigilante
			case spr_playerV_divekickstart:
				sprite_index = spr_crouchslip;
				break;
			case spr_playerV_longkick:
				sprite_index = spr_playerV_longkickend;
				break;
			case spr_playerV_longkickend:
			case spr_playerV_longjumpend:
				if grounded
					sprite_index = machrollspr;
				break;
			case spr_playerV_divekickslidestart:
				sprite_index = spr_playerV_divekickslide;
				break;
			case spr_playerV_longjump:
			case spr_playerV_diverolljump:
				sprite_index = spr_playerV_longjumpend;
				break;
			case spr_playerV_diverollstart:
				sprite_index = spr_playerV_diveroll;
				break;
			case spr_playerV_diverollturn:
				{
					xscale *= -1;
					image_index = 0;
					sprite_index = spr_playerV_diveroll;
				}
				break;
		}
	}
	if (sprite_index == machrollspr && !grounded)
		sprite_index = spr_mach2jump;
	if (sprite_index == spr_player_Sjumpcancel && grounded)
		sprite_index = spr_player_Sjumpcancelland;
	if ((state != states.freefall && ((place_meeting(x + xscale, y, obj_solid) || scr_solid_slope(x + xscale, y)) && (!place_meeting(x + hsp, y, obj_rattumble) || sprite_index != spr_tumble) && !place_meeting(x + hsp, y, obj_destructibles))) || place_meeting(x, y, obj_timedgate))
	{
		if character != "V" && character != "M" {
			hsp = 0;
			movespeed = 0;
		}
		if (sprite_index == spr_tumble || sprite_index == spr_tumblestart)
		{
			fmod_event_one_shot_3d(sfx_bumpwall, x, y);
			state = states.bump;
			landAnim = false;
			sprite_index = spr_tumbleend;
			image_index = 0;
			hsp = -xscale * 2;
			vsp = -3;
			jumpstop = true;
		}
