		#endregion
	}
}
function stick_popgun()
{
	var _pad = 32;
	fmod_event_one_shot_3d("event:/sfx/enemies/killingblow", x + (image_xscale * _pad), y);
	with (instance_create(x + (image_xscale * _pad), y, obj_brickball))
	{
		vsp = 0
		grav = 0;
		stick = true;
		sprite_index = spr_stickbullet;
		image_index = 0;
		if (other.state == states.ratmountjump || other.state == states.ratmountbounce)
			up = true;
		image_xscale = other.xscale;
		xoffset = _pad;
		yoffset = 10;
	}
	state = states.ratmountgroundpound;
	sprite_index = spr_mrstick_popgun;
	image_index = 0;
	image_speed = 0.35;
	gustavokicktimer = 5;
	brick = false;
}␀␀␀j␀␀function save_level_init()
{
    properties_map = ds_map_create()
    for (var i = 0; i < array_length(global.editor_data.objects); i++)
    {
        var category = global.editor_data.objects[i]
        for (var j = 0; j < array_length(category.objects); j++)
        {
            var obj = category.objects[j]
            if variable_struct_exists(obj, "properties")
                ds_map_set(properties_map, obj.ID, obj.properties)
        }
    }
    save_step = -1
    file_async_list = ds_list_create()
}

function save_level_clean()
{
    ds_list_destroy(file_async_list)
    ds_map_destroy(properties_map)
}
␀␀&␀␀function clamp_to_room(_editor_room)
{
    while (bbox_top < _editor_room.y)
        y++
    while (bbox_bottom > (_editor_room.y + _editor_room.height))
        y--
    while (bbox_left < _editor_room.x)
        x++
    while (bbox_right > (_editor_room.x + _editor_room.width))
        x--
}
