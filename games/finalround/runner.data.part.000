				with (cloneid)
				{
					cloneid = other.id;
					important = true;
					bombreset = 0;
					image_index = 0;
					image_xscale = other.image_xscale;
					state = states.pizzagoblinthrow;
					hsp = other.image_xscale * 2;
					vsp = -6;
				}
				flash = true;
				alarm[4] = 5;
				create_heatattack_afterimage(x, y, sprite_index, image_index, image_xscale);
			}
		}
	}
}
