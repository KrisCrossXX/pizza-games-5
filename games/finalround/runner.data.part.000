if image_index >= 4
{
	shader_set(global.Pal_Shader);
	pal_swap_set(spr_leaderboard_palette, (global.show_scores >= 2), false);
	draw_set_font(global.smallfont);
	draw_set_alpha(1);
	draw_set_valign(fa_top);
	draw_set_halign(fa_center);
	if !ready || !scores || !os_is_network_connected()
		draw_text(x + (sprite_width * 0.5), y + 137, "...");
	else
	{
		var regranks = ds_map_find_value(scores, "scores");
		var pranks = ds_map_find_value(scores, "pranks");
		var times = ds_map_find_value(regranks, "time");
		var highscores = ds_map_find_value(regranks, "scores");
		var ptimes = ds_map_find_value(pranks, "time");
		var pscores = ds_map_find_value(pranks, "scores");
		for (var i = 1; i <= (image_index + 1); i++)
		{
			if (i == 1)
				draw_set_color(c_yellow);
			else
				draw_set_color(c_white);
			var finalstr = "";
			if (global.show_scores == 0 || global.show_scores == 2 || level == "b_pepperman" || level == "b_vigilante" || level == "b_noise" || level == "b_fakepep" || level == "b_pizzaface")
			{
				var raw = "00:00.0";
				if (global.show_scores >= 2)
				{
					if ((i - 1) < ds_list_size(ptimes))
						raw = ds_list_find_value(ptimes, (i - 1));
				}
				else if ((i - 1) < ds_list_size(times))
					raw = ds_list_find_value(times, (i - 1));
					
				if(is_undefined(raw)) raw = "00:00.0";
				
				raw = real(raw);
				var ms = (raw % 10);
				var ss = (raw / 10);
				var mm = (ss / 60);
				var hh = (mm / 60);
				ss -= (floor(mm) * 60);
				mm -= ((floor(hh) * 60) * 60);
				ms = floor(ms);
				ss = floor(ss);
				mm = floor(mm);
				hh = floor(hh);
				hh = (hh < 1 ? "" : concat(hh, ":"));
				mm = (floor(mm) < 1 ? "00" : (mm <= 9 ? concat("0", mm) : mm));
				ss = (floor(ss) < 1 ? "00" : (ss <= 9 ? concat("0", ss) : ss));
				finalstr = string_concat(i, ". ", hh, mm, ":", ss, ".", ms);
			}
			else
			{
				var raw = "0000";
				if (global.show_scores >= 2)
				{
					if ((i - 1) < ds_list_size(pscores))
						raw = ds_list_find_value(pscores, (i - 1));
				}
				else if ((i - 1) < ds_list_size(highscores))
					raw = ds_list_find_value(highscores, (i - 1));
					
				if(is_undefined(raw)) raw = "0000";
					
				finalstr = string_concat(i, ". ", raw);
			}
			draw_text(x + (sprite_width * 0.5), y + 113 + (24 * i), finalstr);
		}
	}
}
