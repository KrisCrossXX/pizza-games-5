␀␀␀␀E␀␀function scr_player_comingoutdoor()
{
	mach2 = 0;
	jumpAnim = true;
	dashAnim = true;
	landAnim = false;
	moveAnim = true;
	stopAnim = true;
	crouchslideAnim = true;
	crouchAnim = true;
	machhitAnim = false;
	hsp = 0;
	if (c < 255)
		c += 5;
	image_blend = make_colour_hsv(0, 0, c);
	if (floor(image_index) == (image_number - 1))
	{
		movespeed = 0;
		if (isgustavo)
			state = states.ratmount;
		else
			state = states.normal;
		image_alpha = 1;
		c = 0;
		image_blend = make_colour_hsv(0, 0, 255);
		if (character == "N" || character == "D") && room == freezer_1
		{
			state = states.animation;
			sprite_index = character == "D" ? spr_playerD_freezerdeath : spr_playerN_freezerintro;
			image_index = 0;
			xscale = 1;
			fmod_event_one_shot_3d("event:/sfx/playerN/freezerintro", x, y);
			exit;
		}
	}
	if sprite_index == spr_Timesup && anim_end() && character == "G"
	{
		gusintro = true;
		if global.leveltosave == "medieval"
			scr_brickintro();
		else if global.leveltosave == "ruin"
			scr_brickintro(spr_lonebrick_bombintro, spr_lonegustavo_panicreaction, transfos.bomb, "bomb");
		else if global.leveltosave == "badland"
			scr_brickintro(spr_lonebrick_firemouthintro, spr_lonegustavo_panicreaction, transfos.firemouth, "firemouth");
	}
	if (sprite_index != spr_Timesup)
	{
		if (steppybuffer > 0)
			steppybuffer--;
		else
		{
			steppybuffer = 16;
			fmod_event_one_shot_3d(sfx_step, x, y);
		}
	}
	if (sprite_index != spr_Timesup)
	{
		if isgustavo
			sprite_index = !isstick ? spr_ratmountexitdoor : spr_mrstick_walkfront;
		else
			sprite_index = spr_walkfront;
	}
	image_speed = 0.35;
}
␀␀␀º␀␀function scr_player_Sjumpprep()
{
	switch (character)
	{
		case "D":
		case "N":
		case "NS":
		case "P":
		case "M":
		case "S":
		case "FP":
		case "G":
		default:
			if (sprite_index == spr_superjumppreplight || sprite_index == spr_superjumpright || sprite_index == spr_superjumpleft)
				move = key_left + key_right;
			else
				move = xscale;
			if character == "NS"
				move = 0;
			if pepperman_sjump
			{
				if sprite_index == spr_superjumpprep && anim_end()
					sprite_index = spr_playerM_Sjumpprep;
				if input_buffer_slap > 0 && !shotgunAnim && !key_jump
				{
					//global.coop_cancelgroundpound = false;
					sprite_index = spr_playerM_shoulderslidestart;
					image_index = 0
					input_buffer_slap = 0
					if move != 0
						xscale = move;
					movespeed = 10
					if (place_meeting(x, y + 1, obj_railparent))
						railmomentum = true;
					freefallstart = 0;
					state = states.tumble
					exit;
				}
				move = 0;
				if (!key_down && !key_groundpound2 || key_jump) && sprite_index != spr_superjumpprep && grounded
				{
					instance_create(x, y, obj_explosioneffect);
					sprite_index = spr_playerM_Sjump;
					state = states.Sjump;
					vsp = -17;
					image_index = 0;
					exit;
				}
			}
			if !place_meeting(x, y + 1, obj_railparent)
				hsp = move * movespeed;
			else
			{
				var _railinst = instance_place(x, y + 1, obj_railparent);
				hsp = (move * movespeed) + (_railinst.movespeed * _railinst.dir);
			}
			if (sprite_index == spr_superjumpprep)
				movespeed = Approach(movespeed, 0, 1);
			if anim_end() && sprite_index == spr_superjumpprep
				sprite_index = spr_superjumppreplight;
			if (sprite_index == spr_superjumppreplight)
				movespeed = 2;
			if sprite_index != spr_superjumpprep
			{
				if move != 0 && (sprite_index == spr_superjumppreplight || sprite_index == spr_superjumpright || sprite_index == spr_superjumpleft)
				{
					if (xscale == 1)
					{
						if (key_right)
							sprite_index = spr_superjumpright;
						if (-key_left)
							sprite_index = spr_superjumpleft;
					}
					if (xscale == -1)
					{
						if (key_right)
							sprite_index = spr_superjumpleft;
						if (-key_left)
							sprite_index = spr_superjumpright;
					}
				}
				else
					sprite_index = spr_superjumppreplight;
			}
			if (!scr_check_superjump() && !pepperman_sjump && (grounded || character == "S") && ((sprite_index == spr_superjumppreplight || sprite_index == spr_superjumpleft || sprite_index == spr_superjumpright)) && !scr_solid(x, y - 16) && !scr_solid(x, y - 32))
			{
				instance_create(x, y, obj_explosioneffect);
				sprite_index = spr_superjump;
				state = states.Sjump;
				vsp = -17;
				image_index = 0;
				if (character == "G")
				{
					scr_lonebrick_wait(spr_lonebrick_Sjump);
					with obj_brickcomeback
						image_xscale = other.xscale;
				}
				if character == "N" || character == "D"
					scr_fmod_soundeffect(snd_noiseSjumprelease, x, y);
			}
			if character == "G"
			{
				if (((input_buffer_slap > 0 && key_up) || key_shoot2 && !key_up) && brick && gusdashpadbuffer == 0)
				{
					input_buffer_slap = 0;
					movespeed = movespeed*xscale
					ratmount_kickbrick();
				}
			}
			image_speed = 0.35;
			break;
		case "V":
			if (sprite_index == spr_superjumpprep && image_index > 5 && image_index < 17)
				move = key_left + key_right;
			else
				move = xscale;
			if (!place_meeting(x, y + 1, obj_railparent))
				hsp = move * movespeed;
			else
			{
				var _railinst = instance_place(x, y + 1, obj_railparent);
				hsp = (move * movespeed) + (_railinst.movespeed * _railinst.dir);
			}
			if (sprite_index == spr_superjumpprep && image_index > 5 && image_index < 17)
				movespeed = 4.2;
			if (/*grounded &&*/ (floor(image_index) == (image_number - 1) && sprite_index == spr_superjumpprep) && !scr_solid(x, y - 16) && !scr_solid(x, y - 32))
			{
				instance_create(x, y, obj_dynamiteexplosion);
				sprite_index = spr_superjump;
				state = states.Sjump;
				vsp = -17;
				image_index = 0;
			}
			image_speed = 0.35;
			break;
	}
}
␀␀|␀␀function editor_input_update() //editor_input_update
{
    for (var i = 0; i < 8; i++)
    {
        var any = scr_anybutton_pressed(i)
        if (any == -2)
        {
            if (mouse_wheel_down() || mouse_wheel_up() || mouse_check_button(mb_any))
                any = -1
        }
        if (any != -2)
            input_method = any
    }
    if (input_method < 0)
    {
        key_undo = keyboard_check_pressed(ord("Z"))
        key_redo = keyboard_check_pressed(ord("Y"))
        key_zoom_out = mouse_wheel_down()
        key_zoom_in = mouse_wheel_up()
        key_place = mouse_check_button_pressed(mb_left)
        key_place_released = mouse_check_button_released(mb_left)
        key_delete = mouse_check_button_pressed(mb_right)
        key_select = false
        laxis_vertical = 0
        laxis_horizontal = 0
        raxis_vertical = (keyboard_check(ord("S")) - keyboard_check(ord("W")))
        raxis_horizontal = (keyboard_check(ord("D")) - keyboard_check(ord("A")))
    }
    else
    {
        key_select = gamepad_button_check_pressed(input_method, gp_face1)
        key_place = gamepad_button_check_pressed(input_method, gp_face1)
        key_place_released = gamepad_button_check_released(input_method, gp_face1)
        key_delete = gamepad_button_check_pressed(input_method, gp_face3)
        key_zoom_out = gamepad_button_check_pressed(input_method, gp_shoulderlb)
        key_zoom_in = gamepad_button_check_pressed(input_method, gp_shoulderrb)
        key_undo = gamepad_button_check_pressed(input_method, gp_shoulderl)
        key_redo = gamepad_button_check_pressed(input_method, gp_shoulderr)
        laxis_vertical = gamepad_axis_value(input_method, gp_axislv)
        laxis_horizontal = gamepad_axis_value(input_method, gp_axislh)
        raxis_vertical = gamepad_axis_value(input_method, gp_axisrv)
        raxis_horizontal = gamepad_axis_value(input_method, gp_axisrh)
    }
}
␀␀␀␀¬␀␀function scr_player_Sjump()
{
	live_auto_call;
	move = key_right + key_left;
	hsp = 0;
	mach2 = 0;
	jumpAnim = true;
	dashAnim = true;
	landAnim = false;
	moveAnim = true;
	stopAnim = true;
	crouchslideAnim = true;
	crouchAnim = false;
	machhitAnim = false;
	if (sprite_index == spr_superjump || sprite_index == spr_playerNS_Sjumpboost) && vsp < 0
	{
		if (steppybuffer > 0)
			steppybuffer--;
		else
		{
			create_particle(x + irandom_range(-25, 25), y + irandom_range(-10, 35), particle.cloudeffect, 0);
			steppybuffer = 8;
		}
		if (piledrivereffect > 0)
			piledrivereffect--;
		else
		{
			with (instance_create(x, y, obj_parryeffect))
			{
				sprite_index = spr_piledrivereffect;
				image_yscale = -1;
			}
			piledrivereffect = 15;
		}
	}
	if (sprite_index == spr_superjump && character != "NS" || sprite_index == spr_superspringplayer)
		vsp = sjumpvsp;
	else if character == "NS" && sprite_index == spr_superjump
		vsp -= .06;
	sjumpvsp -= .2;
	if character == "NS" && sprite_index != spr_superspringplayer && key_jump2
	{
		input_buffer_jump = 0;
		sprite_index = spr_playerNS_Sjumpboost;
		vsp = -13.5;
	}
	if anim_end()
	{
		switch (sprite_index)
		{
			case spr_playerNS_Sjumpboost:
				if !key_jump2
					sprite_index = spr_playerNS_Sjumpboostend;
				image_index = 0;
				break;
			case spr_playerNS_Sjumpboostend:
				sprite_index = spr_playerNS_Sjump;
				image_index = 0;
				break;
		}
	}
	if grounded && character == "NS" && sprite_index == spr_superjump && vsp > 0
	{
		fmod_event_one_shot_3d("event:/sfx/pep/step", x, y);
		state = states.normal;
		landAnim = true;
		instance_create(x, y - 5, obj_landcloud);
	}
	if (character == "V" && sprite_index == spr_superjumpcancel)
	{
		if ledge_bump(32) && !place_meeting(x + hsp, y, obj_destructibles) && !place_meeting(x + hsp, y, obj_metalblock)
		{
			wallspeed = abs(hsp);
			grabclimbbuffer = 0;
			movespeed = wallspeed;
			state = states.climbwall;
		}
		else
		{
			if (a < 18)
				a++;
			else
			{
				movespeed = 16;
				sprite_index = spr_playerV_Sjumpcancelfall;
				image_index = 0;
				state = states.mach3;
			}
		}
		instance_destroy(instance_place(x + hsp, y, obj_destructibles));
		instance_destroy(instance_place(x + hsp, y, obj_metalblock));
		hsp = xscale * 16;
		vsp = 0;
	}
	if scr_solid(x, y - 1) && !place_meeting(x, y - 1, obj_destructibles) && sprite_index != spr_playerNS_Sjump && sprite_index != spr_superjumpcancelstart && sprite_index != spr_superjumpcancel
	{
		pizzapepper = 0;
		a = 0;
		if (sprite_index == spr_superjump || sprite_index == spr_superspringplayer || sprite_index == spr_playerNS_Sjumpboost)
			sprite_index = spr_superjumpland;
		with (obj_camera)
		{
			shake_mag = 10;
			shake_mag_acc = 30 / room_speed;
		}
		with (obj_baddie)
		{
			if (shakestun && point_in_camera(x, y, view_camera[0]) && grounded && vsp > 0)
			{
				image_index = 0;
				if (grounded)
					vsp = -7;
			}
		}
		fmod_event_one_shot_3d("event:/sfx/pep/groundpound", x, y);
		image_index = 0;
		state = states.Sjumpland;
		machhitAnim = false;
	}
	else if (key_attack2 || input_buffer_slap > 0) && sprite_index != spr_superspringplayer && sprite_index != spr_superjumpcancelstart && sprite_index != spr_superjumpcancel
	{
		if character != "N" && character != "NS" && character != "G" && character != "D"
		{
			input_buffer_shoot = 0;
			input_buffer_slap = 0;
			image_index = 0;
			sprite_index = spr_superjumpcancelstart;
			fmod_event_one_shot_3d("event:/sfx/pep/superjumpcancel", x, y);
		}
		else if (character == "N" || character == "NS" || character == "D")
		{
			image_speed = 0.5;
			input_buffer_shoot = 0;
			if (move != 0)
				xscale = move;
			input_buffer_slap = 0;
			key_slap = false;
			key_slap2 = false;
			jumpstop = true;
			vsp = -5;
			state = states.mach2;
			movespeed = 12;
			sprite_index = spr_playerN_sidewayspin;
			if character == "NS"
				sprite_index = spr_playerNS_hammerspin;
			image_index = 0;
			with (instance_create(x, y, obj_crazyrunothereffect))
				image_xscale = other.xscale;
			particle_set_scale(particle.jumpdust, xscale, 1);
			create_particle(x, y, particle.jumpdust, 0);
			return true;
		}
		else
		{
			input_buffer_shoot = 0;
			input_buffer_slap = 0;
			image_index = 0;
			if move == 0
				movespeed = 12 * xscale;
			else
			{
				movespeed = 12 * move;
				xscale = move;
			}
			sprite_index = spr_lonegustavo_punch;
			gus_superjump = true;
			vsp = -7;
			state = states.ratmountpunch;
		}
	}
	if sprite_index == spr_superjumpcancelstart 
	{
		vsp = 0;
		if (move != 0)
			xscale = move;
		if anim_end()
		{
			jumpstop = true;
			vsp = noone;
			if character == "M"
				vsp = -9;
			flash = true;
			image_index = 0;
			if (character != "V")
			{
				movespeed = 13;
				state = states.mach3;
			}
			else
				instance_create(x, y, obj_dynamiteexplosion);
			sprite_index = spr_superjumpcancel;
			with (instance_create(x, y, obj_crazyrunothereffect))
				image_xscale = other.xscale;
		}
	}
	if (character == "N" || character == "D") && sprite_index == spr_superjump || sprite_index == spr_superjump && character == "M" || character == "NS" && (sprite_index == spr_superjump || sprite_index == spr_playerNS_Sjumpboost)
		hsp = move * 3;
	if character != "NS"
		image_speed = .5;
	else 
		image_speed = 0.35;
	scr_collide_player();
}␀␀␀␀␀␀function scr_player_Sjumpland()
{
	mach2 = 0;
	jumpAnim = true;
	dashAnim = true;
	landAnim = false;
	machslideAnim = true;
	moveAnim = true;
	stopAnim = true;
	crouchslideAnim = true;
	crouchAnim = false;
	machhitAnim = false;
	movespeed = 0;
	start_running = true;
	alarm[4] = 14;
	vsp = 0;
	hsp = 0;
	if (floor(image_index) == 6)
	{
		sprite_index = character == "D" ? spr_playerN_jetpackboostdown : spr_machfreefall;
		state = states.jump;
