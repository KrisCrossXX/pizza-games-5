	if (charge_buffer > 0)
		charge_buffer--;
	else if (can_fire)
	{
		with (instance_create(x, y, obj_enemybullet))
		{
			image_xscale = other.image_xscale;
			vsp = random_range(-1, 1);
		}
		can_fire = false;
		alarm[0] = fire_max;
