␀␀␀à␀␀function scr_ratblock_destroy()
{
	if (place_meeting(x, y, obj_canonexplosion))
	{
		with (instance_place(x, y, obj_canonexplosion))
		{
			instance_destroy(other);
			if (baddie)
				notification_push(notifs.ratblock_explode, [room]);
		}
	}
	with (obj_player)
	{
		if ((other.sprite_index == spr_rattumbleblock || other.sprite_index == spr_rattumbleblock_big || other.sprite_index == spr_ratblock6) && (sprite_index == spr_tumble || sprite_index == spr_playerV_divekickstart || sprite_index == spr_playerV_divekick) && (place_meeting(x + 1, y, other) || place_meeting(x - 1, y, other)))
			instance_destroy(other);
		if (state != states.mort && state != states.bombgrab && (!scr_transformationcheck() || state == states.barrel || (state == states.lungeattack && character == "V")) && (place_meeting(x + 1, y, other) || place_meeting(x - 1, y, other) || place_meeting(x, y + 1, other) || place_meeting(x, y - 1, other)))
		{
			switch (state)
			{
				case states.barrel:
					if (!place_meeting(x, y - 12, other))
						instance_destroy(other);
					break;
				case states.boxxedpepspin:
					vsp = -6;
					if character == "N" || character == "D"
					{
						sprite_index = spr_playerN_boxxedhit;
						image_index = 0;
					}
					instance_destroy(other);
					break;
				case states.bombpep:
					if (sprite_index != spr_bombpepend && sprite_index != spr_bombpepintro)
					{
						instance_create(x, y, obj_bombexplosion);
						instance_destroy(other);
						GamepadSetVibration(0, 1, 1, 0.9);
						hurted = true;
						vsp = noone;
						image_index = 0;
						sprite_index = spr_bombpepend;
						state = states.bombpep;
						bombpeptimer = 0;
					}
					break;
				case states.gotoplayer:
				case states.tube:
				case states.actor:
				case states.boxxedpep:
				case states.mort:
				case states.morthook:
				case states.mortjump:
				case states.boxxedpepjump:
				case states.knightpep:
				case states.knightpepbump:
					break;
				case states.tumble:
					if (other.sprite_index == spr_rattumbleblock || other.sprite_index == spr_rattumbleblock_big)
						instance_destroy(other);
					break;
				default:
					if (other.sprite_index != spr_rattumbleblock && other.sprite_index != spr_rattumbleblock_big)
						instance_destroy(other);
			}
		}
	}
}␀␀␀␀␀␀␀function cutscene_dungeon_middle()
{
	with (obj_lavapot)
	{
		destroy = true;
		instance_destroy();
	}
	cutscene_end_action();
}
␀␀␀‡␀␀function scr_player_trashroll()
{
	image_speed = 0.35;
	hsp = xscale * movespeed;
	if (gravesurfingjumpbuffer > 0)
		gravesurfingjumpbuffer--;
	if ((scr_slope() && hsp != 0) && movespeed < 14)
		scr_player_addslopemomentum(0.25, 0.25);
	movespeed = max(3, movespeed);
	if (sprite_index != obj_player1.spr_corpsestart_player && sprite_index != obj_player1.spr_corpsesurf_player)
	{
		if (sprite_index != obj_player1.spr_trashjump && sprite_index != obj_player1.spr_trashjump2 && sprite_index != obj_player1.spr_trashfall)
			sprite_index = obj_player1.spr_trashslide;
		else
		{
			if (floor(image_index) == (image_number - 1) && sprite_index == obj_player1.spr_trashjump2)
				sprite_index = obj_player1.spr_trashfall;
			if (vsp > 0 && sprite_index == obj_player1.spr_trashjump)
			{
				sprite_index = obj_player1.spr_trashjump2;
				image_index = 0;
			}
			if (grounded && vsp > 0)
			{
				sprite_index = obj_player1.spr_trashslide;
				image_speed = 0.35;
			}
		}
	}
	else
	{
		image_speed = 0.35;
		if (sprite_index == obj_player1.spr_corpsestart_player && floor(image_index) == (image_number - 1))
			sprite_index = obj_player1.spr_corpsesurf_player;
	}
	if (!instance_exists(obj_slidecloud) && grounded)
	{
		if (!place_meeting(x, y + 1, obj_current))
		{
			with (instance_create(x, y, obj_slidecloud))
				image_xscale = other.xscale;
		}
	}
	if (input_buffer_jump > 0 && gravesurfingjumpbuffer <= 15)
	{
		input_buffer_jump = 0;
		dir = xscale;
		state = states.mach2;
		sprite_index = spr_mach2jump;
		jumpstop = false;
		vsp = -11;
		instance_create(x, y, obj_jumpdust);
	}
	if (((place_meeting(x + xscale, y, obj_solid) || place_meeting(x + xscale, y, obj_ghostwall)) && !place_meeting(x + hsp, y, obj_destructibles) && !place_meeting(x + hsp, y, obj_rattumble)) || place_meeting(x, y, obj_timedgate))
	{
		image_index = 0;
		sprite_index = spr_bump;
		state = states.bump;
		hsp = -xscale * 3;
		vsp = -3;
	}
}␀Í␀␀function scr_player_barrelslide()
{
	live_auto_call;
	image_speed = abs(movespeed) / 8;
	if (image_speed < 0.35)
		image_speed = 0.35;
	if (image_speed > 0.85)
		image_speed = 0.85;
	hsp = movespeed;
	if character != "N" && character != "D"
	{
		if (abs(movespeed) < 14)
			movespeed = Approach(movespeed, xscale * 14, 0.1);
	}
	else if (abs(movespeed) < 16)
		movespeed = Approach(movespeed, xscale * 16, 0.15);
	if ((dashcloudtimer == 0 && abs(hsp) > 8) && grounded)
	{
		with (instance_create(x, y, obj_dashcloud2))
			image_xscale = other.xscale;
		dashcloudtimer = 15;
	}
	if (dashcloudtimer > 0)
		dashcloudtimer--;
	if (floor(image_index) == (image_number - 1))
	{
		if (sprite_index == spr_barrelslipnslide)
			sprite_index = spr_barrelroll;
		else if (sprite_index == spr_playerD_barreldive && grounded)
		{
			sprite_index = spr_barrelroll;
			if !key_down
				vsp = -8.5;
		}
	}
	if grounded
		barrelroll_doisebuffer = false;
	if (!jumpstop && !key_jump2 && (vsp < 0 && !barrelroll_doisebuffer))
	{
		jumpstop = true;
		vsp /= 20;
	}
	if (input_buffer_jump > 0 && (can_jump || barrelroll_doisebuffer))
	{
		scr_fmod_soundeffect(jumpsnd, x, y);
		input_buffer_jump = 0;
		if barrelroll_doisebuffer
		{
			// honestly not sure about letting doise switch direction here -Compwnter
			vsp = -10;
		}
		else
			vsp = -8.5;
		barrelroll_doisebuffer = false;
		jumpstop = false;
		create_particle(x, y, particle.highjumpcloud1, 0);
	}
	if ((!key_attack && !place_meeting(x, y + 1, obj_current)) && !scr_solid(x, y - 16) && !scr_solid(x, y - 32))
	{
		mask_index = spr_player_mask;
		if (!place_meeting(x, y, obj_solid))
		{
			if (grounded)
				state = states.barrel;
			else
			{
				state = states.barreljump;
				sprite_index = spr_barrelfall;
			}
		}
	}
	if character == "D"
	{
		if (key_down2 && !grounded && sprite_index == spr_barrelroll)
		{
			sprite_index = spr_playerD_barreldive;
			fmod_event_one_shot_3d("event:/sfx/barrel/slope", x, y); // temp?
		}
		if (sprite_index == spr_playerD_barreldive)
		{
			with (instance_place(x, y + vsp, obj_destructibles))
				instance_destroy();
			if !grounded
				vsp += 1.5;
			else
				sprite_index = spr_barrelroll;
		}
	}
	with (instance_place(x + hsp, y, obj_destructibles))
		instance_destroy();
	if (place_meeting(x + sign(hsp), y, obj_solid)) && (!place_meeting(x + sign(hsp), y, obj_destructibles) && !place_meeting(x + sign(hsp), y, obj_ratblock1x1))
	{
		if (scr_slope())
		{
			with (instance_create(x, y, obj_speedlinesup))
				playerid = other.id;
			if (abs(movespeed) <= 5)
				vsp = -5;
			else if (abs(movespeed) >= 12)
				vsp = -12;
			else
				vsp = -abs(movespeed);
			state = states.barrelclimbwall;
			movespeed = 0;
			if character == "N" || character == "D"
				wallspeed = abs(vsp);
			fmod_event_one_shot_3d("event:/sfx/barrel/slope", x, y);
			if (sprite_index != spr_barrelroll)
				sprite_index = spr_barrelroll;
		}
		else
		{
			GamepadSetVibration(0, 0.6, 0.6, 0.3);
			scr_fmod_soundeffect(barrelbumpsnd, x, y);
			if character == "D"
			{
				if (grounded)
				{
					if vsp < -5
						vsp -= 5;
					else
						vsp = -5;
				}
				barrelroll_doisebuffer = true;
			}
			xscale *= -1;
			movespeed = xscale * 8;
			instance_create(x + (xscale * 10), y + 10, obj_bumpeffect);
			if (place_meeting(x, y + 1, obj_current))
			{
				input_buffer_jump = 0;
				vsp = -8.5;
				jumpstop = true;
				create_particle(x, y, particle.highjumpcloud1, 0);
			}
		}
	}
	image_speed = abs(movespeed) / 10;
	image_speed = clamp(image_speed, 0.25, 0.85);
}
␀␀␀V␀␀function scr_player_shotgundash()
{
	image_speed = 0.35;
