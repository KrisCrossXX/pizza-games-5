    var _x = snap_tile(x, 32)
    var _y = snap_tile(y, 32)
    switch dock
    {
        case comp_dock.topleft:
            _room.x = _x
            _room.y = _y
            _room.width = (startwidth - _x)
            _room.height = (startheight - _y)
            if (_room.width < 960)
            {
                _room.x = ((_room.x + _room.width) - 960)
                _room.width = 960
            }
            if (_room.height < 540)
            {
                _room.y = ((_room.y + _room.height) - 540)
                _room.height = 540
            }
            break
        case comp_dock.top:
            _room.y = _y
            _room.height = (startheight - _y)
            if (_room.height < 540)
            {
                _room.y = ((_room.y + _room.height) - 540)
                _room.height = 540
            }
            break
        case comp_dock.topright:
            _room.y = _y
            _room.width = (_x - _room.x)
            _room.height = (startheight - _y)
            if (_room.width < 960)
                _room.width = 960
            if (_room.height < 540)
            {
                _room.y = ((_room.y + _room.height) - 540)
                _room.height = 540
            }
            break
        case comp_dock.right:
            _room.width = (_x - _room.x)
            if (_room.width < 960)
                _room.width = 960
            break
        case comp_dock.bottomright:
            _room.width = (_x - _room.x)
            _room.height = (_y - _room.y)
            if (_room.width < 960)
                _room.width = 960
            if (_room.height < 540)
                _room.height = 540
            break
        case comp_dock.bottom:
            _room.height = (_y - _room.y)
            if (_room.height < 540)
                _room.height = 540
            break
        case comp_dock.bottomleft:
            _room.x = _x
            _room.width = (startwidth - _x)
            _room.height = (_y - _room.y)
            if (_room.width < 960)
            {
                _room.x = ((_room.x + _room.width) - 960)
                _room.width = 960
            }
            if (_room.height < 540)
                _room.height = 540
            break
        case comp_dock.left:
            _room.x = _x
            _room.width = (startwidth - _x)
            if (_room.width < 960)
            {
                _room.x = ((_room.x + _room.width) - 960)
                _room.width = 960
            }
            break
    }
    if obj_editor.key_place_released
