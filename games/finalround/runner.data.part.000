}␀␀␀D␀␀function scr_switchgustavo(peppino = true, skip_gloves = false)
{
	with (obj_player1)
	{
		if character != "N" && character != "M" && character != "G" && character != "D"
		{
			ratmount_movespeed = 8;
			gustavodash = 0;
			isgustavo = true;
			if peppino
			{
				visible = true;
				state = states.ratmount;
				sprite_index = spr_player_ratmountidle;
				jumpAnim = false;
			}
			brick = true;
			fmod_event_instance_release(snd_voiceok);
			snd_voiceok = fmod_event_create_instance("event:/sfx/voice/gusok");
		}
		if character == "N" || character == "D"
		{
			isgustavo = false;
			noisecrusher = true;
			if peppino
			{
				visible = true;
				jumpAnim = false;
				state = states.normal;
				sprite_index = spr_idle;
				if (room == street_jail && !skip_gloves)
				{
					actor_buffer = 40;
					sprite_index = spr_playerN_glovesstart;
					image_index = 0;
					state = states.animation;
				}
			}
		}
		if character == "M"
		{
			isgustavo = true;
			painting = 1
			state = states.ratmount;
			visible = true;
			if !instance_exists(obj_paintedgus)
				instance_create(x, y, obj_paintedgus)
			fmod_event_instance_release(snd_voiceok);
			snd_voiceok = fmod_event_create_instance("event:/sfx/voice/gusok");
		}
		if character == "G"
		{
			ratmount_movespeed = 8;
			gustavodash = 0;
			isstick = true;
			if peppino
			{
				visible = true;
				state = states.ratmount;
				sprite_index = spr_mrstick_idle;
				jumpAnim = false;
			}
			brick = false;
			fmod_event_instance_release(snd_voiceok);
			snd_voiceok = fmod_event_create_instance("event:/sfx/voice/gusok");
		}
	}
	with (obj_swapmodefollow)
	{
		isgustavo = true;
		get_character_spr();
	}
}

function scr_switchpeppino(peppino = true)
{
	with obj_player1
	{
		if character != "N" && character != "M" && character != "G" && character != "D"
		{
			gustavodash = 0;
			ratmount_movespeed = 8;
			isgustavo = false;
			brick = false;
			fmod_event_instance_release(snd_voiceok);
			snd_voiceok = fmod_event_create_instance("event:/sfx/voice/ok");
			if peppino
			{
				visible = true;
				state = states.normal;
				jumpAnim = false;
				sprite_index = spr_player_idle;
			}
		}
		if character == "N" || character == "D" 
		{
			isgustavo = false;
			noisecrusher = false;
			if peppino
			{
				jumpAnim = false;
				sprite_index = spr_idle;
				visible = true;
				state = states.normal;
			}
		}
		if character == "M"
		{
			isgustavo = 0
			painting = 0
			state = states.normal;
			visible = true;
			if instance_exists(obj_paintedgus)
				instance_destroy(obj_paintedgus)
			fmod_event_instance_release(snd_voiceok);
			snd_voiceok = fmod_event_create_instance("event:/sfx/voice/ok");
		}
		if character == "G"
		{
			gustavodash = 0;
			ratmount_movespeed = 8;
			isgustavo = true;
			brick = true;
			isstick = false;
			fmod_event_instance_release(snd_voiceok);
			snd_voiceok = fmod_event_create_instance("event:/sfx/voice/ok");
			if peppino
			{
				visible = true;
				state = states.ratmount;
				jumpAnim = false;
				sprite_index = spr_player_ratmountidle;
			}
		}
	}
	with (obj_swapmodefollow)
	{
		isgustavo = false;
		get_character_spr();
	}
}␀␀␀␀›␀␀function EditorLevel() constructor
{
	static destroy = function()
	{
		ds_list_destroy(rooms);
	};
	rooms = ds_list_create();
	current_room = -4;
	previous_room = -4;
	name = "Default";
}
function new_empty_level()
{
	var l = new EditorLevel();
	var r = new EditorRoom(0, 0);
	ds_list_add(l.rooms, r);
	l.current_room = r;
	return l;
}
function get_current_room()
{
	return global.current_level.current_room;
}
␀}␀␀function scr_playerS_superpeelout(){
	movespeed = 0;
	hsp = 0;
	vsp = 0;
	if snickpeelouthsp < 24
	{
	   snickpeelouthsp += 0.25;
	}
	if snickpeelouthsp < 12
	{
	   sprite_index = spr_mach1;
	}
	else if snickpeelouthsp > 12 && snickpeelouthsp < 16 
	{
	   sprite_index = spr_mach4;
	}
	else if snickpeelouthsp > 16
	{
	   sprite_index = spr_crazyrun;
	}
	if key_attack or (!key_slap && key_up)
	{
		if snickpeelouthsp < 12
		{
			state = states.mach2;
			movespeed = snickpeelouthsp;
			snickpeelouthsp = 0;
		}
		else if snickpeelouthsp > 12
		{
			state = states.mach3;
			movespeed = snickpeelouthsp;
			snickpeelouthsp = 0;
		}
	}

}␀␀␀ ␀␀function scr_oldstring_width(argument0) //gml_Script_scr_string_width
{
	var pos = 0
	var w = 0
	var originalstr = argument0
	var str_arr = array_create(0)
	while (pos < string_length(originalstr))
	{
		if (string_copy(originalstr, pos, 2) == "\n")
		{
			array_push(str_arr, string_copy(originalstr, 1, pos))
			string_delete(originalstr, 1, pos)
			pos = 0
			if (originalstr == "")
				break
			else
				continue
		}
		else
		{
			pos++
			continue
		}
	}
	if (array_length(str_arr) == 0)
		w = string_width(argument0)
	for (var i = 0; i < array_length(str_arr); i++)
	{
		var b = str_arr[i]
		if (string_width(b) > w)
			w = string_width(b)
	}
	return w;
}

function scr_oldseparate_text(argument0) //gml_Script_scr_separate_text
{
	draw_set_font(global.bigfont)
	while (scr_oldstring_width(argument0) > ((obj_camera.original_cam_width - (rpadding * 2)) - string_width("a")))
	{
		var _pos = string_length(argument0)
		var _oldpos = _pos
		while (string_char_at(argument0, _pos) != " ")
		{
			_pos--
			if (_pos < 0)
				_pos = _oldpos
		}
		if (string_char_at(argument0, _pos) == " ")
			argument0 = string_delete(argument0, _pos, 1)
		argument0 = string_insert("\n", argument0, _pos)
	}
	return argument0;
}

function scr_oldcalculate_text(argument0) //gml_Script_scr_calculate_text
{
	draw_set_font(global.bigfont)
	pos = 0
	var str2 = ""
	while (pos <= string_length(argument0))
	{
		pos++
		str2 = string_insert(string_char_at(argument0, pos), str2, (string_length(str2) + 1))
		str2 = scr_oldseparate_text(str2)
	}
	return str2;
}

function scr_oldcalculate_height(argument0) //gml_Script_scr_calculate_height
{
	str2 = scr_oldcalculate_text(argument0)
	return string_height(str2);
}

