}␀=	␀␀function scr_splitscreen()
{
    players = [obj_player1, obj_player2]
    view_visible[0] = true
    view_visible[1] = (use_splitscreen());
    var zoomval = 1.2
    if (global.coop && (!is_bossroom()) && room != rank_room && room_width > 960 && room_height > 540)
    {
        for (var i = 0; i < 2; i++)
        { 
            // x, y, width, and height sizes of the viewsports themself
            var _h = SCREEN_HEIGHT
            var _w = (SCREEN_WIDTH / 2)
            var _x = (_w * i) //moves player 2's camera to the right
            var _y = 0
        
           //sets the splitscreen sizes and the objects they follow
           splitscreen[i] = camera_create_view(0, 0, (_w * zoomval), (_h * zoomval), 0, players[i], -1, -1, (_w * zoomval), (_h * zoomval))
       
           //sets the views and cameras into size
            if (use_splitscreen())
            {
                camera_set_view_size(view_camera[i], (_w * zoomval), (_h * zoomval))
                view_set_camera(i, splitscreen[i])
                view_xport[i] = _x
                view_yport[i] = _y 
                view_hport[i] = _h
                view_wport[i] = _w
            }
            else
            {
                view_set_camera(i, view_camera[i])
                camera_set_view_size(view_camera[i], original_cam_width, original_cam_height)
                view_xport[i] = 0
                view_wport[i] = _w * 2
                view_hport[i] = _h
                view_yport[i] = 0
            }
        }
    }
    else
    {
        //resets the camera back to normal
        camera_set_view_target(view_camera[0], -4)
        view_hport[0] = SCREEN_HEIGHT
        view_wport[0] = SCREEN_WIDTH
        view_xport[0] = 0
        view_yport[0] = 0
    }
}
function use_splitscreen()
{
	var _startgate = false;
	with obj_player
	{
		if place_meeting(x, y, obj_startgate)
			_startgate = true;
	}
	var _force1playercam = false;
	with obj_player
	{
		if sprite_index == spr_uppizzabox || sprite_index == spr_downpizzabox || (place_meeting(x, y, obj_lapportal) && global.panic)
			_force1playercam = true;
	}
	return (global.coop && room != characterselect && (!is_bossroom()) && room_width > 960 && room_height > 540 && room != rank_room && (!instance_exists(obj_coopplayerfollow)) && !(obj_player.state == states.victory && _startgate) && !_force1playercam)
}␀␀␀␀␀function scr_player_dashtumble()
{
	landAnim = false;
	momemtum = true;
