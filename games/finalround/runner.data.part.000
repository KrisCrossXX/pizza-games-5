			case 5:
				pizzahead_x = -5;
				break;
			case 6:
				pizzahead_x = 0;
				break;
			case 7:
				pizzahead_x = 5;
				break;
		}
		pizzahead_front = false;
		if (floor(image_index) >= 5 && floor(image_index) <= 7)
			pizzahead_front = true;
		break;
}
