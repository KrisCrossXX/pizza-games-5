switch global.holiday
{
	case holiday.halloween:
		sprpizzascore = spr_pizzascorehalloween;
		sprpizzascorepepper = spr_pizzascore_pepperhalloween;
		sprpizzascorepepperoni = spr_pizzascore_pepperonihalloween;
