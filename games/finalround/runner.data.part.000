			}
		}
		if (cutscenebuffer > 0)
			cutscenebuffer--;
		else
		{
			with (obj_music)
			{
				if (music != noone)
					fmod_event_instance_set_parameter(music.event, "state", 1, true);
			}
			with playerid
			{
				state = states.normal;
				landAnim = false;
				flash = true;
				if character == "D"
				{
					fmod_event_one_shot_3d("event:/sfx/misc/breakice", x, y);
