					vsp = -8;
				}
				break;
			case obj_miniufo:
				instance_create(x, y, obj_warplaser);
				break;
			case obj_miniufo_grounded:
				with (instance_create(x + (8 * image_xscale), y, obj_ufobullet))
				{
					fmod_event_one_shot_3d("event:/sfx/enemies/ufolivelaser", x, y);
					image_xscale = other.image_xscale;
