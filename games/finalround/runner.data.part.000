	particlespr = spr_streetdebris;
	
var lay_id = layer_get_id("Assets_1")
var pep = layer_sprite_get_id(lay_id, "peppinotv")
var noise = layer_sprite_get_id(lay_id, "noisetv")
var doise = layer_sprite_get_id(lay_id, "doisetv")
if obj_player1.character == "P"
{
	layer_sprite_alpha(pep, 1)
	layer_sprite_alpha(noise, 0)
	layer_sprite_alpha(doise, 0)
}
else if obj_player1.character == "N"|| obj_player1.character == "D"
{
	layer_sprite_alpha(pep, 0)
	layer_sprite_alpha(noise, 1)
	layer_sprite_alpha(doise, 0)
	if obj_player1.character == "D"
	{
		layer_sprite_alpha(pep, 0)
		layer_sprite_alpha(noise, 0)
		layer_sprite_alpha(doise, 1)
	}
}
else
{
	layer_sprite_alpha(pep, 0)
	layer_sprite_alpha(noise, 0)
	layer_sprite_alpha(doise, 0)
}
if (!obj_secretmanager.init)
{
	obj_secretmanager.init = true;
	secret_add(function()
	{
		touchedtriggers = 0;
	}, function()
	{
		if (touchedtriggers >= 6)
			secret_open_portal(0);
	});
	secret_add(noone, function()
	{
		secret_open_portal(1);
	});
	secret_add(noone, function()
	{
		if (secret_check_trigger(2))
			secret_open_portal(2);
	});
}
