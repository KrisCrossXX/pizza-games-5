usic/w4/streettitle"], ["event:/music/w5/chateau", "event:/music/w5/chateau"], ["event:/music/w5/chateautitle", "event:/music/w5/chateautitle"], ["event:/music/w5/finalhallway", "event:/music/w5/finalhallway"], ["event:/music/w5/kidsparty", "event:/music/w5/kidsparty"], ["event:/music/w5/kidspartychase", "event:/music/w5/kidspartychase"], ["event:/music/w5/kidspartysecret", "event:/music/w5/kidspartysecret"], ["event:/music/w5/kidspartytitle", "event:/music/w5/kidspartytitle"], ["event:/music/w5/war", "event:/music/w5/war"], ["event:/music/w5/warsecret", "event:/music/w5/warsecret"], ["event:/music/w5/wartitle", "event:/music/w5/wartitle"]]
music_event = fmod_event_create_instance(music_arr[0][0]);
music_string = music_arr[0][0];
music_groups = ds_map_create();
directories = [];
subdirectories = ds_map_create();
ready = false;
ds_maps = [subdirectories, music_groups];

for(var i = 0; i < array_length(music_arr); i++) {
	var v = music_arr[i][0];
	
	var groups = string_split(v, "/");
	//0 = event:
	//1 = sfx/music
	//2 = group
	//3 = sound
	
	if(array_length(groups) <= 3)
		continue;
	
	if(is_undefined(music_groups[? groups[1]])) {
		music_groups[? groups[1]] = ds_map_create();
		array_push(ds_maps, music_groups[? groups[1]]);
		subdirectories[? groups[1]] = [];
		array_push(directories, groups[1]);
	
	}
	
	if(is_undefined(music_groups[? groups[1]][? groups[2]])) {
		array_push(subdirectories[? groups[1]], groups[2]);
		music_groups[? groups[1]][? groups[2]] = [];
		
	}
	
	array_push(music_groups[? groups[1]][? groups[2]], groups[3]);

}

ready = true;␀L␀␀␀/// @description input
scr_getinput();

hold_delay = max(hold_delay - 1, 0);␀␀␀␀µ␀␀if(hold_delay > 0)
	return;
	
var maxindex = array_length(directories)-1;

switch(state) {
	case ststate.nodir:
		maxindex = array_length(directories)-1;
		break;
		
	case ststate.dir:
		maxindex = array_length(subdirectories[? current_directory])-1;
		break;
		
	case ststate.subdir:
		maxindex = array_length(music_groups[? current_directory][? current_subdirectory])-1;
		break;
	
}

if(key_down) {
	hold_delay = IN_DELAY;
	
	index++;
	
	if(index > maxindex)
		index = 0;

}

if(key_up) {
	hold_delay = IN_DELAY;
	
	index--;
	
	if(index < 0)
		index = maxindex;

}

if(key_jump) {
	hold_delay = IN_DELAY;
	
	switch(state) {
		case ststate.nodir:
			current_directory = directories[index];
			index = 0;
			state = ststate.dir;
			break;
			
		case ststate.dir:
			current_subdirectory = subdirectories[? current_directory][index];
			index = 0;
			state = ststate.subdir;
			break;
			
		case ststate.subdir:
			fmod_event_instance_stop(music_event, true);
			fmod_event_instance_release(music_event);
			music_event = fmod_event_create_instance(string_concat("event:/", current_directory, "/", current_subdirectory, "/", music_groups[? current_directory][? current_subdirectory][index]));
