	key_taunt2 = tdp_input_get("player2_taunt").pressed || tdp_input_get("player2_tauntC").pressed;
	key_attack = tdp_input_get("player2_attack").held || tdp_input_get("player2_attackC").held;
	key_attack2 = tdp_input_get("player2_attack").pressed || tdp_input_get("player2_attackC").pressed;
	key_superjump = tdp_input_get("player2_superjumpC").held || tdp_input_get("player2_superjump").held;
	key_groundpound = tdp_input_get("player2_groundpoundC").pressed || tdp_input_get("player2_groundpound").pressed;
	key_groundpound2 = tdp_input_get("player2_groundpoundC").held || tdp_input_get("player2_groundpound").held;
	
	key_shoot = false;
	key_shoot2 = false;
	key_chainsaw = false;
	key_chainsaw2 = false;
