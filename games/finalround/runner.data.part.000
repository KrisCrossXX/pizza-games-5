			xscale = 0.6;
			yscale = 1.5;
			var pad = 30;
			var pd = 0;
			for (var i = 0; i < array_length(dirs); i++)
			{
				var b = dirs[i];
				pd = point_direction(0, 0, b[0], b[1]);
				with (instance_create(x + lengthdir_x(pad, pd), y + lengthdir_y(pad, pd), obj_pizzice_projectile))
				{
					image_xscale = b[0];
					image_yscale = b[1];
				}
			}
			if (shot <= 0)
