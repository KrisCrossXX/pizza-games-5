				with (other)
				{
					playerid = other.id;
					playerxoffset = other.x - x;
					state = states.walk;
					if (place_meeting(x + (dir * 32), y, obj_solid))
						dir *= -1;
				}
			}
		}
		break;
	case states.walk:
		x += (dir * 5);
		playerid.x = x + playerxoffset;
		playerid.hsp = 0;
		playerid.vsp = 0;
		if (place_meeting(x + dir, y, obj_solid))
		{
			with (playerid)
				state = states.normal;
			state = states.normal;
			with (obj_camera)
			{
				shake_mag = 5;
				shake_mag_acc = 5 / room_speed;
			}
			dir *= -1;
		}
		break;
}
