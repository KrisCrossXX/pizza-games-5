					if other.playerid.character == "D"
						sprite_index = spr_frozenpizzasnowflake;
				}
			}
			cutscenebuffer = 100;
			state = states.actor;
		}
		break;
	case states.actor:
		if (flamebuffer > 0)
			flamebuffer--;
