		sprite_index = spr_player_facestomp;
	else if (facestompAnim == 1)
	{
		sprite_index = spr_player_facestomphit;
		if (floor(image_index) == 5)
			facestompAnim = false;
	}
	if (move != 0)
		xscale = move;
	image_speed = 0.35;
	if (can_jump && input_buffer_jump > 0 && vsp > 0)
	{
		input_buffer_jump = 0;
		sprite_index = spr_player_hanstandjump;
		stompAnim = false;
		hsp = 0;
		state = states.handstandjump;
		jumpAnim = true;
		jumpstop = false;
		image_index = 0;
		create_particle(x, y, particle.landcloud, 0);
		freefallstart = 0;
	}
}
␀␀␀␀function scr_player_superslam()
{
	if (vsp > 0)
		freefallsmash++;
	if (freefallsmash >= 10 && !instance_exists(superslameffectid))
	{
		with (instance_create(x, y, obj_superslameffect))
		{
			playerid = other.object_index;
			other.superslameffectid = id;
		}
	}
	if (sprite_index == spr_piledriver)
	{
		move = key_left + key_right;
		hsp = move * movespeed;
		if (move != dir && move != 0)
		{
			dir = move;
			movespeed = 0;
		}
	}
	else
	{
		move = 0;
		hsp = 0;
	}
	if (vsp > 0)
	{
		if (punch_afterimage > 0)
			punch_afterimage--;
		else
		{
			punch_afterimage = 5
			if (global.blueeffects > 0 && global.blueeffects < 4)
			{
				if (global.blueeffects == 1)
				{
					with (create_firemouth_afterimage(x, y, sprite_index, image_index, 1))
					{
						image_xscale = other.xscale
						playerid = other.id
