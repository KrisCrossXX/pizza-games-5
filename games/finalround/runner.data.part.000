function boss_destroy(argument0)
{
	SUPER_boss_destroy(argument0);
	targetstunned = 1000;
	stunned = 1000;
	global.vigilantecutscene2 = true;
	quick_ini_write_real(get_savefile_ini(), "cutscene", "vigilante2", true);
}
function boss_hurt(argument0, argument1)
{
	if (targetstunned > 0)
	{
		targetstunned -= targetstunnedminus[phase - 1];
		attack_cooldown = 0;
		if (targetstunned < 0)
			targetstunned = 1;
	}
	else
		targetstunned = 150;
	SUPER_boss_hurt(argument0, argument1);
	targetxscale = -argument1.xscale;
}
function boss_hurt_noplayer(argument0)
{
	if (targetstunned > 0)
	{
		targetstunned -= targetstunnedminus[phase - 1];
		attack_cooldown = 0;
		if (targetstunned < 0)
			targetstunned = 1;
	}
	else
		targetstunned = 150;
	SUPER_boss_hurt_noplayer(argument0);
}
function player_hurt(argument0, argument1)
{
	if (!argument1.inv_frames && (argument1.state != states.backbreaker || argument1.parry_inst == noone))
	{
		hitstate = state;
		hithsp = hsp;
		hitvsp = vsp;
		if (state != states.uppunch || vsp < 0)
		{
			SUPER_player_hurt(argument0, argument1);
			with (argument1)
			{
				inv_frames = true;
				alarm[1] = 15;
			}
			if (hitstate == states.superattack)
			{
				hithsp = 0;
				hitvsp = 0;
			}
		}
	}
}
