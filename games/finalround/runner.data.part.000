function get_time(_milliseconds)
{
	var seconds  = floor((_milliseconds / 1000) % 60)
	var minutes  = floor((_milliseconds / (1000 * 60)) % 60)
	var hours  = floor((_milliseconds / (1000 * 60 * 60)) % 60)
	var secondsSTRING = (seconds < 10 ? "0" + string(seconds) : string(seconds));
	var minutesSTRING = (minutes < 10 ? "0" + string(minutes) : string(minutes));
	var hoursSTRING = (hours < 10 ? "0" + string(hours) : string(hours));
	
	var final = hoursSTRING + ":" + minutesSTRING + ":" + secondsSTRING;
	
	return final	
}


