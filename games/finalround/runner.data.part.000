				break;
			case obj_kentukybomber:
				instance_create(x, y + 70, obj_kentukybomb);
				break;
			case obj_bazookabaddie:
				var xx = x + (72 * image_xscale);
				with (instance_create(xx, y, obj_bazooka))
				{
					other.bazookaID = id;
