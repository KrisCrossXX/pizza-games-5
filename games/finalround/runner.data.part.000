	{
		shader_set(global.Pal_Shader);
		if obj_player1.character == "N" || obj_player1.character == "D" || obj_player2.character == "N" || obj_player2.character == "D" || global.swapmode || instance_exists(obj_noiseboss) && obj_noiseboss.doise
