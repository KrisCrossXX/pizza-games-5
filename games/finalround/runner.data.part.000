	vsp = 0;
	var _spd = 12;
	y = Approach(y, targetplayer.y, _spd);
	if (superattack_buffer > 0)
		superattack_buffer--;
	else
	{
		state = states.superslam;
		sprite_index = spr_pepperman_shoulderloop;
		image_index = 0;
	}
}
function boss_pepperman_superslam()
{
