			orangealpha = 1.5;
		}
		break;
	case states.transition:
		if (orangealpha > 0)
			orangealpha -= 0.08;
		if (flamebuffer > 0)
			flamebuffer--;
		else
		{
			flamebuffer = 8;
			repeat (3)
				with instance_create(x, y, obj_firemouthflame)
					if other.playerid.character == "D"
						sprite_index = spr_frozenpizzasnowflake;
		}
		if (cutscenebuffer > 0)
			cutscenebuffer--;
		else
		{
			with (obj_music)
			{
