		hsp = -5;
	else if (place_meeting(x, y + 1, obj_railh2))
		hsp = 5;
	if (floor(image_index) == (image_number - 1))
	{
		state = states.walk;
		sprite_index = walkspr;
	}
	if (bombreset <= 0 && floor(image_index) == global.throw_frame[object_index])
	{
