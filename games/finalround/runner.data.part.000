function swap_player(hurted = false, jumpscare = false)
{
	if global.swapmode
	{
		scr_swapmode_changetoppings();
		if !jumpscare && (instance_exists(obj_noiseanimatroniceffect) || obj_swapmodefollow.animatronic > 0)
			return false;
		with obj_bosscontroller
		{
			if hurted && (player_hp - 1) <= 0
				return false;
		}
		if hurted && instance_exists(obj_bosscontroller) && global.swap_boss_damage + 1 < 3
			return false;
		if hurted
			global.swap_boss_damage = -1;
		
		state = states.normal;
		if character != "N" && character != "D"
		{
			if isgustavo
			{
				scr_switchpeppino();
				noisecrusher = true;
			}
			if global.noisejetpack
				noisepizzapepper = true;
			else if global.leveltosave == "freezer"
				global.noisejetpack = true;
		}
		character = obj_swapmodefollow.character;
		if character != "N" && character != "D"
		{
			if noisecrusher
			{
				noisecrusher = false;
				scr_switchgustavo(true, false);
			}
			if global.noisejetpack && !noisepizzapepper
				global.noisejetpack = false;
		}
		if character != "P"
			tauntstoredisgustavo = false;
		scr_characterspr();
		pistolcharge = 0;
		pistolchargeshooting = false;
		pistolanim = -4;
		
		pistol = false;
		if (character != "N" && character != "D" && (room == boss_vigilante || instance_exists(obj_pizzafaceboss_p2))) || instance_exists(obj_bosscontroller) && (character == "N" || character == "D")
			pistol = true;
		
		if instance_exists(obj_randomsecret)
		{
			noisepizzapepper = false;
			if room == freezer_secret1
				global.noisejetpack = true;
			else if (character == "N" || character == "D") && room == freezer_secret3
				global.noisejetpack = true;
		}
		with obj_gustavoswitch
		{
			x = xstart;
			y = ystart;
			create_particle(x, y, particle.genericpoofeffect);
			var _esc = escape;
			event_perform(ev_create, 0);
			escape = _esc;
		}
		with obj_peppinoswitch
		{
			x = xstart;
			y = ystart;
			create_particle(x, y, particle.genericpoofeffect);
			var _esc = escape;
			event_perform(ev_create, 0);
			escape = _esc;
			event_perform(ev_other, ev_room_start);
		}
		with obj_playerbomb
		{
			dead = true;
			instance_destroy(id);
		}
		with obj_swapmodefollow
		{
			taunttimer = 0;
			if character == obj_player1.character
			{
				character = other_swap_character;
				if (obj_player1.character == "N" || obj_player1.character == "D") && obj_player1.noisecrusher
					isgustavo = true;
				get_character_spr();
			}
		}
		with obj_tv
		{
			scr_tvspr();
			if state == states.normal && !hurted
			{
				if idleanim < 60
					idleanim = 60;
				sprite_index = idletvspr;
				if sprite_index == idletvspr && playerid.isgustavo
					sprite_index = idleGtvspr;
			}
		}
		return true;
	}
	return false;
}␀␀␀␀%␀␀function scr_read_game(ini)
{
	var q = game_empty();
	ini_open(ini);
	q.percentage = ini_read_real("Game", "percent", 0);
	q.started = ini_read_real("Tutorial", "finished", false);
	q.judgement = ini_read_string("Game", "finalrank", "none");
	q.john = ini_read_real("Game", "john", false);
	q.snotty = ini_read_real("Game", "finalsnotty", false);
	q.palette = ini_read_real("Game", "palette", 1);
	q.minutes = ini_read_real("Game", "minutes", 0);
	q.seconds = ini_read_real("Game", "seconds", 0);
	var _texture = ini_read_string("Game", "palettetexture", "none");
	q.palettetexture = scr_get_texture_palette(_texture);
	q.palette_player2 = ini_read_real("Game", "palette_player2", 1);
	q.palettetexture_player2 = scr_get_texture_palette(ini_read_string("Game", "palettetexture_player2", "none"));
	q.character = ini_read_string("Game", "character", "P");
	ini_close();
	return q;
}
function menu_get_game(slot, peppino)
{
	var g = global.game[slot];
	if peppino == 0
		g = global.gameN[slot];
	if peppino == 2
		g = global.gameM[slot];
	if peppino == 3
		g = global.gameV[slot];
	
	var q = 
	{
		percentage: g.percentage,
		percvisual: 0,
		snotty: g.snotty,
		john: g.john,
		judgement: g.judgement,
		perstatus_icon: 0,
		alpha: 1,
		minutes: g.minutes,
		seconds: g.seconds,
		character: g.character
	};
	q.perstatus_icon = floor(q.percentage / (100 / 7));
	if (q.perstatus_icon > (sprite_get_number(spr_percentstatemenu) - 1))
		q.perstatus_icon = sprite_get_number(spr_percentstatemenu) - 1;
	if (q.percentage >= 101)
		q.perstatus_icon = 8;
	return q;
}
function game_empty()
{
	return 
	{
		percentage: 0,
		started: false,
		judgement: "none",
		john: false,
		snotty: false,
		palette: 1,
		palettetexture: noone,
		minutes: 0,
		seconds: 0,
		palette_player2: 1,
		palettetexture_player2: noone,
		character: "P"
	};
}
␀␀␀Ï␀␀function scr_brickintro(_introsprite = spr_lonebrick_knightintro, _gusreaction = spr_lonegustavo_panicreaction, _transfo = transfos.knight, _id = "knight"){
	ini_open_from_string(obj_savesystem.ini_str);
	if ini_read_string("Brickintro", _id, false) == true
	{
		obj_savesystem.ini_str = ini_close();
		gusintro = false;
		global.gus_transfo = _transfo;
		exit;
	}
	obj_savesystem.ini_str = ini_close();
	if !instance_exists(obj_brickintro)
	{
		with instance_create(obj_player1.x + 80, obj_player1.y, obj_brickintro)
			image_index = 0;
		with obj_player
		{
			brick = false;
			state = states.actor;
			landAnim = false;
			hsp = 0;
			vsp = 0;
			xscale = 1;
			sprite_index = spr_lonegustavo_levelintro;
			image_index = 0;
			image_speed = 0.35;
		}
	}
	with (obj_player)
	{
		if sprite_index != spr_lonegustavo_levelintro && sprite_index != _gusreaction
		{
			sprite_index = spr_lonegustavo_levelintro;
			image_index = 0;
		}
		if sprite_index == spr_lonegustavo_levelintro && anim_end()
			image_index = image_number - 4;
		if sprite_index == spr_lonegustavo_panicreaction && anim_end()
			image_index = image_number - 4;
	}
	with obj_brickintro
	{
		if sprite_index == spr_lonebrick_genericintro && anim_end()
		{
			sprite_index = _introsprite
			image_index = 0;
			with obj_player
			{
				if character == "G"
				{
					sprite_index = _gusreaction;
					image_index = 0;
				}
			}
		}
		if sprite_index == _introsprite && anim_end()
		{
			global.gus_transfo = _transfo;
			with obj_player
			{
				sprite_index = spr_lonegustavo_idle;
				image_index = 0;
				state = states.ratmount;
				landAnim = false;
				brick = false;
				with instance_create(x, y, obj_brickcomeback)
				{
					x = obj_brickintro.x;
					y = obj_brickintro.y;
					wait = true;
				}
			}
			instance_destroy(obj_brickintro);
			ini_open_from_string(obj_savesystem.ini_str);
			if _id != ""
				ini_write_real("Brickintro", _id, true);
			obj_savesystem.ini_str = ini_close();
			gusintro = false;
		}
	}
}␀¾␀␀function ResizeCMD(_inst, _xscale, _yscale, _oldxscale, _oldyscale) : Command() constructor
{
	static execute = function()
	{
		with (inst)
		{
			image_xscale = other.xscale;
			image_yscale = other.yscale;
		}
	};
	static undo = function()
	{
		with (inst)
		{
			image_xscale = other.oldxscale;
			image_yscale = other.oldyscale;
		}
	};
	inst = _inst;
	xscale = _xscale;
	yscale = _yscale;
	oldxscale = _oldxscale;
	oldyscale = _oldyscale;
}
␀␀Æ␀␀function peddito_followboss() 
{
	if (state == states.normal)
	{
		x = Approach(x, obj_noiseboss.x, abs(hsp));
		y = lerp(y, obj_noiseboss.y, 0.08);
		if place_meeting(x, y, obj_noiseboss)
		{
			state++;
			noisex = obj_noiseboss.x - x;
			noisey = obj_noiseboss.y - y;
			vsp = 0;
			with (obj_noiseboss)
			{
				fmod_event_one_shot("event:/sfx/voice/noisescream");
				substate = states.ending;
				sprite_index = spr_playerN_bossintro;
				image_index = 0;
			}
		}
	}
	else
	{
		vsp = Approach(vsp, -11, 0.8);
		x += hsp;
		y += vsp;
		with (obj_noiseboss)
		{
			x = other.x + other.noisex;
			y = other.y + other.noisey;
		}
		if x > room_width + 1200
		{
			instance_destroy();
			instance_destroy(obj_noiseboss);
			layer_set_visible(layer_get_id("Assets_2"), false);
			var lay1 = layer_get_id("Backgrounds_4");
			var lay2 = layer_get_id("Backgrounds_5");
			var bg1 = layer_background_get_id(lay1);
			var bg2 = layer_background_get_id(lay2);
			layer_background_sprite(bg1, bg_doisebossBG2end);
			layer_background_sprite(bg2, bg_doisebossBG1end);
			layer_background_speed(bg2, 0.35);
			layer_hspeed(lay1, 0);
			layer_vspeed(lay1, 0);
			layer_hspeed(lay2, 0);
			layer_vspeed(lay2, 0);
			instance_destroy(obj_doisecreature);
			if obj_player1.character == "N" || obj_player1.character == "D"
			{
				with instance_create(0, 0, obj_pizzahead_whitefade)
					whitefade = 1;
			}
		}
	}
	
}

function peddito_followplayer_boss()
{
	if state == states.normal
	{
		if place_meeting(x, y, obj_player1)
		{
			state++;
			noisex = obj_player1.x - x;
			noisey = obj_player1.y - y;
			vsp = 0;
			with (obj_player1)
			{
				with (obj_camera)
					lock = true;
				fmod_event_one_shot("event:/sfx/pep/screamboss");
				state = states.actor;
				sprite_index = spr_bossintro;
				image_index = 0;
				xscale = -1;
			}
		}
	}
	else
	{
		vsp = Approach(vsp, -11, 0.8);
		x += hsp;
		y += vsp;
		with obj_player1
		{
			if sprite_index == spr_bossintro && floor(image_index) == 10
				image_index = 6;
			x = min(other.x + other.noisex, room_width + 200);
			y = max(other.y + other.noisey, -200);
		}
	}
}

function peddito_followplayer(stateblacklist)
{
	live_auto_call;
	var playerid = obj_player1;
	if (global.coop && instance_nearest(x, y, obj_player).object_index == obj_player2)
		playerid = obj_player2;
	
	var dir = point_direction(x, y, playerid.x, playerid.y);
	var dist = point_distance(x, y, playerid.x, playerid.y);
	var movex = lengthdir_x(movespeed, curr_angle);
	var movey = lengthdir_y(movespeed, curr_angle);
	var maxspeed = 10;
	var minspeed = 2;
	var angle_diff = angle_difference(dir, curr_angle)	;
	if !slowdown
	{
		if movespeed < maxspeed
			movespeed += 0.15;
		else
			slowdown = true;
	}
	else
	{
		if movespeed > minspeed
			movespeed -= 0.15;
		else
			slowdown = false;
	}
	if angle_diff != 0
		curr_angle = dir - (angle_diff / 6);
	
	if (!array_contains(stateblacklist, other.state))
	{
		x = Approach(x, x + movex, movespeed);
		y = Approach(y, y + movey, movespeed);
	}
