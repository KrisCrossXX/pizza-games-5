tutorial1 = "Appuie sur [J] pour sauter. Maintiens [D] appuyÃ© et choisis droite ou gauche pour ramper."
tutorial2 = "Tu peux briser les blocs de marbre et de mÃ©tal situÃ©s en dessous de toi en les Ã©crasant. Appuie sur [g] lorsque tu es en l'air !"
tutorial3 = "Ã‰crase-toi de plus haut pour dÃ©truire les blocs de mÃ©tal."
tutorial4 = "Certains blocs peuvent Ãªtre cachÃ©s, alors ouvre l'Å“il ! Appuie sur [G] pour les dÃ©truire."
tutorial5 = "Appuie sur [G] pour courir en empoignant et ainsi dÃ©truire les blocs de marbre."
tutorial6 = "Maintiens [M] appuyÃ© pour lancer une ruÃ©e. Saute ensuite contre un mur pour courir dessus !"
tutorial7 = "Appuie sur [J] lorsque tu cours sur un mur pour en sauter. Maintiens [M] appuyÃ© pour coller aux autres murs. Un conseil : tu peux Ã©galement utiliser l'empoigne pour commencer Ã  courir sur les murs pendant que tu es en l'air. Il te suffit pour cela de maintenir [M] appuyÃ© !"
tutorial8 = "Appuie sur [G] puis maintiens [M] appuyÃ© pour un dÃ©part rapide avec la ruÃ©e. Essaie pour voir !"
tutorial9 = "Tu peux sauter aprÃ¨s avoir appuyÃ© sur [G] pour effectuer un saut en longueur."
tutorial10 = "Tu peux aussi simplement courir le long d'une pente Ã  proximitÃ© d'un mur pour commencer automatiquement Ã  courir sur celui-ci."
tutorial11 = "Lors d'une ruÃ©e, maintiens [D] appuyÃ© pour dÃ©truire des blocs situÃ©s dans de petits interstices."
tutorial12 = "RelÃ¢che [D] et continue de maintenir [M] appuyÃ© afin de poursuivre la ruÃ©e."
tutorial13 = "Maintiens [D] appuyÃ© pendant une ruÃ©e dans les airs pour plonger."
tutorial14 = "Tu dois gagner de la vitesse avec une ruÃ©e pour dÃ©truire les blocs de mÃ©tal. Maintiens [F] appuyÃ© pour courir encore plus vite !"
tutorial15 = "Descendre une pente en courant te permet d'augmenter ta vitesse."
