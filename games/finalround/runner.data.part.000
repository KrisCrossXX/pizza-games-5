var hermesconrad = 0
if keyboard_check_pressed(vk_tab)
	hermesconrad = 1 // what
	
if (keyboard_check_pressed(vk_alt) && (state == states.normal || state == states.ratmount)) 
{
	state = states.titlescreen;
	instance_create(x, y, obj_chardresser);
	hsp = 0;
	fmod_event_one_shot_3d("event:/sfx/misc/computerswitch", x, y);
}
	
if (keyboard_check_pressed(vk_f3))
{
	main_attack_id += 1
	if (main_attack_id = 1 && !global.pummelunlock)
	main_attack_id = 0;
	if (main_attack_id = 2 && !global.shoulderunlock)
	main_attack_id = 0;

	if main_attack_id > 2
	{
		main_attack_id = 0
	}
	if character = "P"
	{
		switch (main_attack_id) // TODO: fix these, probably move them to the actual move changing input function rather than this check
		{
			case 0:
				global.attackstyle = 0;
				main_attack = "grab_dash"
				//create_transformation_tip("Grab Dash");
				break;
			case 1:
				main_attack = "pummel";
				global.attackstyle = 3;
				//create_transformation_tip("Pummel");
				break;
			case 2:
				global.attackstyle = noone;
				main_attack = "shoulderbash";
				//create_transformation_tip("Shoulder Bash");
				break;
		}
	}
	else
		main_attack = -1
}
	
if key_slap2
	input_buffer_pistol = 10;
if object_index != obj_player2
{
	if key_taunt_p2
		input_taunt_p2 = 5;
}

if (character == "N" || character == "D") && !isgustavo
{
	if can_jump && vsp > 0
		noisewalljump = 0;
}
if (character == "M")
{
	if (grounded && vsp > 0)
	{
		pepperman_jump = false;
	}
	if ((state != states.jump && state != states.handstandjump && state != states.mach3 && state != states.normal && state != states.shoulderbashstart) || state == states.normal && !key_attack)
		pepperman_skipstartup = false;
	if state != states.firemouth
		pepperman_doublejump = false;
}
if (character == "G")
{
	if ((grounded && vsp > 0) || state != states.ratmountjump || brick)
	{
		spinjump = false;
	}
	if isstick && grounded && vsp > 0
		stickfly = 0;
}
if state != states.tumble && character == "V"
	vigikickslide = true;

// input buffers and coyote time
if (key_slap2)
	input_buffer_shoot = 10;
if (key_slap2)
	input_buffer_slap = 12;
if (key_jump)
	input_buffer_jump = 15;
if (grounded && vsp > 0)
	coyote_time = 8;
if (vsp < 0)
	coyote_time = 0;
can_jump = (grounded && vsp > 0) || (coyote_time && vsp > 0);

var prevmask = mask_index;
if (state != states.grab)
	swingdingthrow = false;

// collision flags
enum colflag
{
	secret = 1,
	sloped = 2,
	grounded = 4
	// 8, 16, 32, 64, 128, 256...
}

collision_flags = 0;
if (place_meeting(x, y, obj_secretportal) || place_meeting(x, y, obj_secretportalstart))
	collision_flags |= colflag.secret;
if (scr_solid(x, y + 1))
	collision_flags |= colflag.grounded;
if (place_meeting(x, y + 1, obj_slope))
	collision_flags |= colflag.sloped;
	

if (character == "N" || character == "D" || character == "NS") && (scr_check_superjump() && key_jump2 || key_superjump) && state != states.mach3 && can_jump && vsp > 0 && (state == states.normal || state == states.mach2)
{
	sprite_index = spr_superjumpprep;
	state = states.Sjumpprep;
	hsp = 0;
	image_index = 0;
}

