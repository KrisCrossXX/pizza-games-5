function vm_group_jump_on_jump(l_th,l_act,l_scope,l_st){
	// vm_group_jump_on_jump(th:gml_thread, act:gml_action, scope:gml_thread_scope, st:gml_stack<any>)->gml_thread_proc_result
	/// @ignore
