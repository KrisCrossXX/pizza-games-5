␀Ö*␀␀function scr_player_freefall()
{
	live_auto_call;
	if character == "V" && isgustavo
	{
		scr_playerV_mort();
		exit;
	}
	landAnim = true;
	if (vsp >= 2)
	{
		if (steppybuffer > 0)
			steppybuffer--;
		else
		{
			create_particle(x + irandom_range(-25, 25), y + irandom_range(-10, 35), particle.cloudeffect, 0);
			steppybuffer = 8;
		}
		if (vsp > 17)
		{
			if (punch_afterimage > 0)
				punch_afterimage--;
			else
			{
				punch_afterimage = 5;
				with (create_mach3effect(x, y, sprite_index, image_index, true))
				{
					image_xscale = other.xscale;
					playerid = other.id;
					maxmovespeed = 6;
					vertical = true;
					fadeoutstate = states.freefall;
				}
			}
			if (piledrivereffect > 0)
				piledrivereffect--;
			else
			{
				with (instance_create(x, y, obj_parryeffect))
					sprite_index = spr_piledrivereffect;
				piledrivereffect = 15;
			}
		}
		vsp += (sprite_index == spr_playerV_knightpound ? 2 : 0.5);
	}
	
	// Might as well make it a switch statement
	if (floor(image_index) == (image_number - 1))
	{
		switch (sprite_index)
		{
			case spr_bodyslamstart:
				sprite_index = spr_bodyslamfall
				if character == "M"
				{
					if vsp < 14
						vsp = 14
					if freefallsmash < 12
						freefallsmash = 12
				}
				break
			case spr_shotgunjump1:
				sprite_index = spr_shotgunjump3
				break
			case spr_playerM_BintoGPtrans:
				sprite_index = spr_bodyslamfall
				break
			case spr_playerV_divebombstart:
				instance_create(x, y, obj_dynamiteexplosion)
				sprite_index = spr_playerV_divebomb
				if vsp < 14
					vsp = 14
				if freefallsmash < 12
					freefallsmash = 12
				break
			case spr_playerV_knightpoundstart:
				sprite_index = spr_playerV_knightpound
				break
		}
	}
	
	if (sprite_index == spr_playerV_divebombstart)
		image_speed = 0.5
	move = key_left + key_right;
	if (!grounded)
	{
		if (sprite_index == spr_rockethitwall)
			hsp = 0;
		
		if (sprite_index != spr_rockethitwall)
			hsp = move * movespeed;
				
		if (move != xscale && momemtum == 1 && movespeed != 0)
			movespeed -= 0.05;
				
		if (movespeed == 0)
			momemtum = false;
		if (move != dir && move != 0)
		{
			dir = move;
			movespeed = 0;
		}
		if ((move == 0 && momemtum == 0) || scr_solid(x + hsp, y))
		{
			movespeed = 0;
			mach2 = 0;
		}
		if (move != 0 && movespeed < 7)
			movespeed += 0.25;
		if (movespeed > 7)
			movespeed -= 0.05;
		if ((scr_solid(x + 1, y) && move == 1) || (scr_solid(x - 1, y) && move == -1))
			movespeed = 0;
		if (move != 0 && sprite_index != spr_poundcancel1)
			xscale = move;
	}
	if (vsp > 0)
		freefallsmash++;
	else if (vsp < 0)
		freefallsmash = -14;
	if (freefallsmash >= 10 && !instance_exists(superslameffectid))
	{
		with (instance_create(x, y, obj_superslameffect))
		{
			playerid = other.object_index;
			other.superslameffectid = id;
		}
	}
	if (grounded && vsp > 0 && (freefallsmash < 10 || !place_meeting(x, y + vsp, obj_metalblock)) && !place_meeting(x, y + vsp, obj_destructibles) && !place_meeting(x, y + vsp + 6, obj_destructibles))
	{
		if scr_slope() && (character != "M" || (character == "M" && (!key_down && !key_groundpound2)))
		{
			if character == "P" || character == "N" || character == "D" || (character == "V" && global.vigiattack != "knight") || character == "FP" || character == "NS" || character == "S"
			{
				with (instance_place(x, y + 1, obj_slope))
				{
					other.xscale = -sign(image_xscale);
					other.state = states.tumble;
					other.sprite_index = other.spr_crouchslip;
					if (other.freefallsmash > 20)
						other.movespeed = 12;
					else
						other.movespeed = 8;
					with (instance_create(other.x, other.y, obj_jumpdust))
						image_xscale = -sign(other.image_xscale);
				}
			} 
			else if (character == "M") 
			{
				if (!key_down && !key_groundpound2) 
				{
					with (instance_place(x, y + 1, obj_slope)) 
					{
						other.xscale = -sign(image_xscale);
						other.state = states.tumble;
						other.sprite_index = spr_playerM_shoulderslide;
						if (other.freefallsmash > 20)
							other.movespeed = 12;
						else
							other.movespeed = 8;
						with (instance_create(other.x, other.y, obj_jumpdust))
							image_xscale = -sign(other.image_xscale);
					}	
				}
			}
			else if (global.vigiattack == "knight")
			{
				with (instance_place(x, y + 1, obj_slope))
				{
					other.xscale = -sign(image_xscale)
					other.state = states.punch
					other.image_index = 0
					other.sprite_index = spr_playerV_knightdashstart
					other.vsp = 9
					other.movespeed = 11
					fmod_event_one_shot_3d("event:/sfx/pep/groundpound", x, y)
					fmod_event_one_shot_3d("event:/sfx/pep/bumpwall", x, y)
				}
			}
		}
		else
		{
			fmod_event_one_shot_3d(sfx_groundpound, x, y);
			if !shotgunAnim
			{
				switch sprite_index
				{
					case spr_playerS_dropdash:
						sprite_index = spr_playerS_dropdashland;
						break;
					case spr_poundcancel1:
						sprite_index = spr_poundcancel2;
						break;
					case spr_playerV_knightpoundstart:
					case spr_playerV_knightpound:
						sprite_index = spr_playerV_knightpoundend
						break
					default:
						sprite_index = spr_bodyslamland;
						break;
				}
			}
			else
				sprite_index = spr_shotgunjump2;
			image_index = 0;
			pepperman_superdelay = room_speed*.4;
			pepperman_superhascharged = true;
			state = states.freefallland;
			jumpAnim = true;
			jumpstop = false;
			with (obj_camera)
			{
				shake_mag = 5;
				shake_mag_acc = 15 / room_speed;
			}
			if (freefallsmash >= 10)
			{
				with (obj_baddie)
				{
					if (shakestun && grounded && point_in_camera(x, y, view_camera[0]) && grounded && vsp > 0 && !invincible && groundpound)
					{
						state = states.stun;
						if (stunned < 60)
							stunned = 60;
						vsp = -11;
						image_xscale *= -1;
						hsp = 0;
						momentum = 0;
					}
				}
				with (obj_camera)
				{
					shake_mag = 10;
					shake_mag_acc = 30 / room_speed;
				}
				combo = 0;
				bounce = false;
			}
			create_particle(x, y + 3, particle.groundpoundeffect, 0);
			freefallstart = 0;
		}
	}
	if sprite_index != spr_playerV_divebombstart
	{
		image_speed = 0.35;
		if (sprite_index == spr_bodyslamstart)
			image_speed = 0.4;
	}
	if scr_pepperman_machcancel_grab()
		exit;

	if character == "M"
	{
		with instance_place(x, y + vsp, obj_metalblock)
		{
			with other
			{
				if !key_down && !key_groundpound2 && sprite_index != spr_rockethitwall
				{
					vsp = -9
					sprite_index = spr_jump
					stompAnim = true
					state = states.jump
					image_index = 0
					image_speed = .35;
				}
			}
			instance_destroy();
		}
		with (instance_place(x, y + (vsp + 4), obj_horseyblock))
		{
			instance_destroy();
		}
		with (instance_place(x, y + vsp, obj_iceblock_breakable))
		{
			instance_destroy();
		}
	}
}

function scr_player_pepperbounce() //OLD GO TO scr_playerM_rolling
{
	if sprite_index == spr_playerM_longjump || sprite_index == spr_longjumpend
		hsp = (xscale * movespeed);
	if punch_afterimage
		punch_afterimage--;
	else
	{
		create_noise_afterimage(x, y, sprite_index, image_index, xscale);
		punch_afterimage = 5;
	}
	
	if pepperman_grounded //id love to know why this is here instead of scr_player_freefallland but pop off ig -jack
	{ 
		pepperman_grounded = false;
		vsp = -18;
		grav = 0.5;
		sprite_index = spr_machroll; 
	}
	
	if scr_check_groundpound() && !grounded
	{
		pepper_canwall = 0;
		sprite_index = spr_playerM_BintoGPtrans;
		image_index = 0;
		state = states.freefall;
		pistolanim = noone;
		freefallsmash = 12;
		vsp = 14;
		exit;
	}
	if sprite_index != spr_playerM_longjump && sprite_index != spr_longjumpend
		movespeed = 0;
	
	if pepper_retainspd {
		pepwallmove = xscale
		if key_right+key_left != 0 && key_right+key_left != pepwallmove {
			pepper_retainspd = false;
		}
	}
	
	if !pepper_retainspd
		pepwallmove = key_right + key_left;

	if sprite_index != spr_playerM_longjump && sprite_index != spr_longjumpend
		hsp = Approach(hsp, (pepwallmove * (12 - (sprite_index == spr_playerM_walljumpclose || sprite_index == spr_playerM_walljumpcloseend ? 6 : 0))), 0.85 - (sprite_index == spr_playerM_walljumpclose || sprite_index == spr_playerM_walljumpcloseend ? 0.2 : 0));
	
	var destructslist = [
		obj_destructibles,
		obj_secretblock,
		obj_secretbigblock,
	];
	
	for(var i = 0; i < array_length(destructslist); i++)
	{
		var destruct = instance_place(x + hsp, y + vsp, destructslist[i]);
		if destruct != noone
			instance_destroy(destruct);
	}
		
	if anim_end() && (sprite_index == spr_playerM_rollingstart || sprite_index == spr_playerM_grabintorolltrans || sprite_index == spr_playerM_longjump || sprite_index == spr_playerM_breakdanceuppercutend || sprite_index == spr_playerM_breakdanceuppercutloop)
	{
		image_index = 0;
		sprite_index = spr_playerM_rolling;
		pepper_canwall = 0;
	}
	
	if (key_slap2 || key_jump)
	{
		image_index = 0;
		sprite_index = spr_playerM_breakdanceuppercutloop;
	}
	
	if (place_meeting(x + xscale, y, obj_solid) && !place_meeting(x + xscale, y, obj_slope) && !place_meeting(x + xscale, y, obj_destructibles))
	{
		if(vsp < 0)
		{
			hsp = 0;
			move = 0
		}
		
		if (sprite_index == spr_playerM_breakdanceuppercutloop || sprite_index == spr_playerM_grabintorolltrans || sprite_index == spr_playerM_longjump)
		{
			if pepper_canwall
				pepper_canwall--;
			else
			{
				move = key_left + key_right
				pepper_canwall = 5;
				pepper_retainspd = true;
				if (sprite_index != spr_playerM_rolling)
				{
					image_index = 0;
					sprite_index = spr_playerM_rolling;
				}
				instance_create(x + (image_xscale * 20), y, obj_pepperbounce_effect);
				
				if(xscale == move)
				xscale *= -1
				else
				hsp = -12 * xscale;
				
				if sprite_index != spr_playerM_breakdanceuppercutend
					vsp = -12;
				fmod_event_one_shot_3d(sfx_playerM_wallboing, x, y);
				input_buffer_slap = 0
				exit;
			}
		}
	}
	if sprite_index == spr_playerM_grabintorolltrans
	{
		if hsp < 8
			hsp = xscale * 8;
	}
	if grounded && !key_attack && vsp >= 0 && (sprite_index == spr_playerM_rolling || sprite_index == spr_playerM_breakdanceuppercutloop || sprite_index == spr_playerM_grabintorolltrans
	|| sprite_index == spr_playerM_longjump)
	{
		state = states.normal;
		movespeed = abs(hsp);
	}
	if grounded && key_attack && vsp >= 0 && (sprite_index == spr_playerM_rolling || sprite_index == spr_playerM_breakdanceuppercutloop || sprite_index == spr_playerM_grabintorolltrans
	|| sprite_index == spr_playerM_longjump)
	{
		fmod_event_one_shot_3d(sfx_playerM_boingenter, x, y);
		input_buffer_slap = 0;
		if (move != 0)
			xscale = move;
		else if (savedmove != 0)
			xscale = savedmove;
		jumpstop = true;
		state = states.mach3;
		movespeed = 12;
		sprite_index = spr_shoulderloop;
		with (instance_create(x, y, obj_pepperbounce_effect))
			image_xscale = other.xscale;
		flash = true;
		image_index = 0;
		with (instance_create(x, y, obj_crazyrunothereffect))
			image_xscale = other.xscale;
	}
	xscale = sign(hsp) != 0 ? sign(hsp) : xscale;
	scr_dotaunt();
	image_speed = .35;
}␀␀ƒ␀␀function scr_player_freefallland()
{
	mach2 = 0;
	jumpAnim = true;
	dashAnim = true;
	landAnim = false;
	moveAnim = true;
	stopAnim = true;
	crouchslideAnim = true;
	crouchAnim = false;
	machhitAnim = false;
	movespeed = 0;
	facehurt = (sprite_index != spr_playerV_knightpoundend);
	start_running = true;
	vsp = 0;
	hsp = 0;
	if (character == "M")
	{
		if sprite_index == spr_bodyslamland && (!key_down && !key_groundpound2)
		{
			sprite_index = spr_playerM_groundpoundland;
			image_index = 0;
		}
		if input_buffer_jump > 8 && !key_attack
		{
			//global.coop_cancelgroundpound = false;
			input_buffer_jump = 0
			sprite_index = spr_playerM_rolling
			image_index = 0
			input_buffer_jump = 0;
			fmod_event_one_shot_3d("event:/sfx/playerM/groundpoundjump", x, y);
			particle_set_scale(particle.highjumpcloud2, xscale, 1);
			create_particle(x, y, particle.highjumpcloud2, 0);
			vsp = -18
			state = states.pepperbounce;
			jumpstop = false;
			if (place_meeting(x, y + 1, obj_railparent))
				railmomentum = true;
			freefallstart = 0;
			//state = states.jump
			pepperman_jump = true;
			pepperman_sjumptimer = 78;
		}
		if input_buffer_jump > 8 && key_attack
		{
			//global.coop_cancelgroundpound = false;
			input_buffer_jump = 0
			sprite_index = spr_playerM_rolling
			image_index = 0
			fmod_event_one_shot_3d("event:/sfx/playerM/groundpoundjump", x, y);
			particle_set_scale(particle.highjumpcloud2, xscale, 1);
			create_particle(x, y, particle.highjumpcloud2, 0);
			vsp = -20
			movespeed = 15*xscale
			hsp = movespeed
			if (place_meeting(x, y + 1, obj_railparent))
				railmomentum = true;
			freefallstart = 0;
			state = states.pepperbounce
			pepperman_sjumptimer = 78;
		}
		if input_buffer_slap > 0 && !shotgunAnim && !key_jump
		{
			//global.coop_cancelgroundpound = false;
			sprite_index = spr_playerM_shoulderslidestart;
			image_index = 0;
			input_buffer_slap = 0;
			movespeed = 11;
			if (place_meeting(x, y + 1, obj_railparent))
				railmomentum = true;
			freefallstart = 0;
			state = states.tumble;
			pepperman_sjumptimer = 78;
		}
		if (key_down || key_groundpound2) && sprite_index == spr_bodyslamland && anim_end()
		{
			pepperman_sjumpcharge = 0;
			sprite_index = spr_superjumpprep;
			image_index = 0;
			state = states.Sjumpprep;
			pepperman_sjumptimer = 78;
			pepperman_sjump = true;
		}
		if (sprite_index == spr_playerM_groundpoundland || sprite_index == spr_shotgunjump2) && anim_end()
		{	
			facehurt = true;
			sprite_index = spr_facehurt;
			image_index = 0;
			state = states.normal;
			jumpstop = true;
			pepperman_sjumptimer = 78;
		}
	}
	else if character == "S" && sprite_index == spr_playerS_dropdashland && !shotgunAnim
	{
		if image_index > 4 && !anim_end()
			hsp = xscale * 11.5;
		else if anim_end()
		{
			sprite_index = spr_mach4;
			image_index = 0;
			movespeed = 13;
			state = states.mach3;
		}
		if place_meeting(x, y + 1, obj_railparent)
			railmomentum = true;
		freefallstart = 0;
	}
	else
	{
		alarm[4] = 14;
		if anim_end()
		{
			facehurt = (sprite_index != spr_playerV_knightpoundend);
			sprite_index = spr_facehurtup;
			image_index = 0;
			state = states.normal;
			jumpstop = true;
		}
	}
	image_speed = 0.35;
	
}␀¿␀␀function scr_player_freefallprep()
{
	move = key_left + key_right;
	if (!grounded)
	{
		hsp = move * movespeed;
		if (move != xscale && momemtum == 1 && movespeed != 0)
			movespeed -= 0.05;
		if (movespeed == 0)
			momemtum = false;
		if ((move == 0 && momemtum == 0) || scr_solid(x + hsp, y))
		{
			movespeed = 0;
			mach2 = 0;
		}
		if (move != 0 && movespeed < 7)
			movespeed += 0.25;
		if (movespeed > 7)
			movespeed -= 0.05;
		if ((scr_solid(x + 1, y) && move == 1) || (scr_solid(x - 1, y) && move == -1))
			movespeed = 0;
		if (dir != xscale)
		{
			mach2 = 0;
			dir = xscale;
			movespeed = 0;
		}
		if (move == -xscale)
		{
			mach2 = 0;
			movespeed = 0;
			momemtum = false;
		}
		if (move != 0)
			xscale = move;
		if (vsp > 0)
			vsp = 0;
	}
	image_speed = 0.5;
	if (floor(image_index) == (image_number - 1))
	{
		state = states.freefall;
		if !shotgunAnim
			sprite_index = spr_bodyslamfall;
		else
			sprite_index = spr_shotgunjump3;
	}
}
␀ˆ␀␀function scr_player_bump()
{
	if (sprite_index != spr_wallsplat)
	{
		if sprite_index == spr_playerM_shoulderhurtstart
		{
			if anim_end()
			{
				vsp = -3
				hsp = -3 * xscale
				sprite_index = spr_playerM_shoulderhurt
			}
		}
		movespeed = 0;
		mach2 = 0;
		var _gus = sprite_index == spr_player_ratmountbump || sprite_index == spr_lonegustavobump || sprite_index == spr_mrstick_hitwall;
		start_running = true;
		alarm[4] = 14;
		if (grounded && vsp > 0)
			hsp = 0;
		var can_end = true;
		if (sprite_index == spr_tumbleend)
			can_end = !place_meeting(x, y, obj_pepgoblin_kickhitbox);
		if (sprite_index == spr_tumbleend && !can_end)
			image_speed = 0;
		else
			image_speed = 0.35;
		if (sprite_index == spr_tumbleend && floor(image_index) >= 3 && !grounded)
			image_index = 3;
		if (sprite_index == spr_rockethitwall && grounded && vsp > 0)
			image_index = image_number - 1;
		if sprite_index == spr_playerD_snowballvomit && anim_end()
			state = states.normal;
		if (anim_end() && sprite_index != spr_player_catched && sprite_index != spr_boxxedpep_air && !_gus)
		{
			if !skateboarding
			{
				if (sprite_index != spr_rockethitwall || (grounded && vsp > 0))
					state = states.normal;
			}
			else
				state = states.mach2;
		}
		if (grounded && vsp > 0 && _gus)
			state = states.ratmount;
		if (sprite_index != spr_player_catched && sprite_index != spr_playerD_snowballvomit && sprite_index != spr_boxxedpep_air && sprite_index != spr_rockethitwall && sprite_index != spr_tumbleend && sprite_index != spr_hitwall && sprite_index != spr_playerM_shoulderhurt && !_gus && sprite_index != spr_mach && sprite_index != spr_mach4)
			sprite_index = !skateboarding ? spr_bump : spr_clownbump;
	}
	else
	{
		movespeed = 0;
		hsp = 0;
		vsp = 0;
		if (floor(image_index) == (image_number - 1))
			state = states.normal;
		image_speed = 0.35;
	}
	if (state == states.normal && isgustavo)
		state = states.ratmount;
}
␀␀␀␀"␀␀function scr_player_machroll()
{
	if (!place_meeting(x, y + 1, obj_railparent))
		hsp = xscale * movespeed;
	else
	{
		var _railinst = instance_place(x, y + 1, obj_railparent);
		hsp = (xscale * movespeed) + (_railinst.movespeed * _railinst.dir);
	}
	mach2 = 100;
	machslideAnim = true;
	move = key_right + key_left;
	switch (character)
	{
		case "D":
		case "N":
		case "NS":
		case "P":
		case "S":
		case "V":
			if (scr_solid(x + xscale, y) && (!place_meeting(x + sign(hsp), y, obj_slope) || scr_solid_slope(x + sign(hsp), y)) && !place_meeting(x + sign(hsp), y, obj_destructibles))
			{
				hsp = 0;
				image_speed = 0.35;
				flash = false;
				combo = 0;
				state = states.bump;
				hsp = -2.5;
				vsp = -3;
				mach2 = 0;
				image_index = 0;
				instance_create(x + 10, y + 10, obj_bumpeffect);
				mask_index = spr_player_mask;
				if (scr_solid(x, y))
				{
					var ty = try_solid(0, 1, obj_solid, 32);
					if (ty != -1)
						y += ty;
				}
			}
			if (!instance_exists(dashcloudid) && grounded)
			{
				with (instance_create(x, y + 43, obj_cloudeffect))
				{
					image_xscale = other.xscale;
					other.dashcloudid = id;
				}
			}
			if sprite_index == spr_playerV_divekickstart && anim_end()
				sprite_index = spr_playerV_divekick;
			if (grounded && sprite_index != spr_playerV_divekickstart)
				sprite_index = !skateboarding ? spr_machroll : spr_clowncrouch;
			else if (sprite_index != spr_dive && !skateboarding)
			{
				sprite_index = spr_dive;
				vsp = 10;
			}
			if scr_slope()
				movespeed += 0.1;
			image_speed = 0.8;
			if (!key_down && !scr_solid(x + 27, y - 32) && !scr_solid(x - 27, y - 32) && !scr_solid(x, y - 32) && !scr_solid(x, y - 16))
			{
				image_index = 0;
				if (grounded)
					sprite_index = spr_rollgetup;
				if (movespeed < 12 || skateboarding == 1)
				{
					if (!grounded)
						sprite_index = spr_mach;
					state = states.mach2;
				}
				else
				{
					if (!grounded)
						sprite_index = spr_mach4;
					state = states.mach3;
				}
			}
			if (skateboarding && movespeed < 12)
				movespeed += 0.5;
			break;
	}
}
␀␀␀␀function scr_player_machslide()
{
	switch (character)
	{
		case "D":
		case "M":
		case "N":
		case "NS":
		case "V":
		case "P":
		case "FP":
		case "S":
			if (!place_meeting(x, y + 1, obj_railparent))
				hsp = xscale * movespeed;
			else
			{
				var _railinst = instance_place(x, y + 1, obj_railparent);
				hsp = (xscale * movespeed) + (_railinst.movespeed * _railinst.dir);
			}
			move = key_right + key_left;
			movespeed = Approach(movespeed, 0, 0.4);
			if (sprite_index == spr_machslidestart && floor(image_index) == (image_number - 1))
				sprite_index = spr_machslide;
			if (floor(image_index) == (image_number - 1) && (sprite_index == spr_machslideboost || sprite_index == spr_mach3boost))
			{
				if !grounded
				{
					if sprite_index == spr_machslideboost
						sprite_index = spr_machslideboostfall;
					else if sprite_index == spr_mach3boost
						sprite_index = spr_mach3boostfall;
				}
				else
					image_index = image_number - 1;
			}
			else
				image_speed = 0.35;
			landAnim = false;
			if (floor(movespeed) <= 0 && (sprite_index == spr_machslide || sprite_index == spr_crouchslide))
			{
				state = states.normal;
				image_index = 0;
				if (sprite_index == spr_machslide)
					machslideAnim = true;
				movespeed = 0;
			}
			if (place_meeting(x + xscale, y, obj_solid) && (sprite_index == spr_machslide || sprite_index == spr_machslidestart))
			{
				fmod_event_one_shot_3d("event:/sfx/pep/splat", x, y);
				sprite_index = spr_wallsplat;
				state = states.bump;
				image_index = 0;
			}
			if (((floor(image_index) == (image_number - 1) && sprite_index == spr_machslideboost) || sprite_index == spr_machslideboostfall) && grounded && character != "M")
			{
				hsp = 0;
				image_index = 0;
				xscale *= -1;
				movespeed = 8;
				state = states.mach2;
			}
			if (((floor(image_index) == (image_number - 1) && sprite_index == spr_mach3boost) || sprite_index == spr_mach3boostfall) && grounded)
			{
				if (!launch)
				{
					hsp = 0;
					sprite_index = character == "M" ? spr_shoulderloop : spr_mach4;
					image_index = 0;
					xscale *= -1;
					movespeed = 12;
					state = states.mach3;
				}
				else
				{
					xscale *= -1;
					sprite_index = spr_dashpadmach;
					image_index = 0;
					state = states.mach3;
					movespeed = 14;
					launched = true;
					launch = false;
					launch_buffer = 20;
				}
			}
			if (sprite_index == spr_player_crouchslide && movespeed == 0 && grounded)
			{
				facehurt = true;
				state = states.normal;
				sprite_index = spr_facehurtup;
			}
			if (input_buffer_shoot > 0)
			{
				if (shotgunAnim)
				{
					if (move != 0)
						xscale = move;
					scr_shotgunshoot();
				}
				else if (pistol)
					scr_pistolshoot(states.normal);
			}
			if (!instance_exists(dashcloudid) && grounded && !place_meeting(x, y + 1, obj_water))
			{
				with (instance_create(x, y, obj_dashcloud2))
				{
					image_xscale = other.xscale;
					other.dashcloudid = id;
				}
			}
			if (!instance_exists(dashcloudid) && grounded && place_meeting(x, y + 1, obj_water))
			{
				with (instance_create(x, y, obj_dashcloud2))
				{
					sprite_index = spr_watereffect;
					image_xscale = other.xscale;
					other.dashcloudid = id;
				}
			}
			break;
	}
}
␀␀␀,m␀␀function scr_player_mach3()
{
	if (character == "G" || isgustavo) && sprite_index != spr_fightball
	{
		state = states.ratmount;
		if ratmount_movespeed < 12
			ratmount_movespeed = 12;
		movespeed = movespeed*xscale;
		sprite_index = brick ? spr_player_ratmountmach3 : spr_lonegustavo_mach3;
		exit;
	}
	if sprite_index == spr_fightball
	{
		scr_player_fightball();
		exit;
	}
	switch (character)
	{
		case "D":
		case "M":
		case "N":
		case "NS":
		case "P":
		case "S":
		case "FP":
		case "V":
			var slopeaccel = 0.1;
			var slopedeccel = 0.2;
			var mach4movespeed = 20;
			var mach3movespeed = 16;
			var accel = 0.025;
			var mach4accel = 0.1;
			var jumpspeed = -11;
			var machrollspeed = 10;
			var mach3_spr = spr_mach4;
			var uppercutheight = -14;
			switch character
			{
				case "N":
					uppercutheight = -21;
					break;
				case "D":
					accel = 0.038;
					mach4accel = 0.28;
					mach4movespeed = 24;
					uppercutheight = -16;
					break;
				case "M":
					accel = 0.012;
					uppercutheight = -16;
					break;
				case "V":
					accel = 0.015;
					break;
			}
			
			if sprite_index == spr_playerM_shoulderstart
			{
				if !scr_solid(x - (xscale * 32), y + 1) && !place_meeting(x - (xscale * 32), y + 8, obj_slope) && !scr_slope() && grounded && !pepperman_skipstartup
					movespeed = 0;
				if floor(image_index) < 2 && move != 0
					xscale = move;
	
				if anim_end()
				{
	
					if key_attack
					{
						state = states.mach3;
						movespeed = 12;
						sprite_index = spr_shoulderloop;
						pepperman_skipstartup = false;
					}
					else
					{
						fmod_event_one_shot_3d(sfx_break, x, y);
						state = states.machslide;
						if movespeed < 10
							movespeed = 10;
						sprite_index = spr_machslidestart;
						image_index = 0;
						pepperman_skipstartup = false;
					}
				}
			}
			else if character == "M" && movespeed < 8
				movespeed = 12;
			if (global.swapmode && key_attack && key_fightball && !instance_exists(obj_swapmodegrab) && !instance_exists(obj_swapdeatheffect) && !instance_exists(obj_noiseanimatroniceffect) && obj_swapmodefollow.animatronic <= 0)
			{
				sprite_index = spr_fightball;
				jump_p2 = false;
				if noisecrusher
					instance_create_unique(x, y, obj_swapgusfightball);
				exit;
			}
			if grounded && (sprite_index == spr_playerV_longkick || sprite_index == spr_playerV_longkickend || sprite_index == spr_playerV_longkickprep || sprite_index == spr_playerD_mach3doublejump || sprite_index == spr_playerD_mach3doublejumpfall)
			{
				sprite_index = mach3_spr;
				movespeed = 13;
			}
			if character == "S" && anim_end() && sprite_index == spr_playerS_dropdashland
			{
				sprite_index = mach3_spr;
				movespeed = 13;
				image_index = 0;
				xscale = move;
			}
			if (character == "N" || character == "D") && grounded && vsp > 0
			{
				if (sprite_index == spr_mach4 && place_meeting(x, y + 1, obj_water))
					sprite_index = spr_playerN_mach3water;
				else if (sprite_index == spr_playerN_mach3water && !place_meeting(x, y + 1, obj_water))
					sprite_index = spr_mach4;
			}
			if input_buffer_jump > 0 && !can_jump && key_up && character == "N"|| input_buffer_jump > 0 && !can_jump && key_up && character == "D" && doisedoublejump
			{
				doisedoublejump = false;
				scr_player_do_noisecrusher();
			}
			if (character != "V")
			{
				if (key_slap2 && global.kungfumoveset == 1)
				{
				   if (grounded)
				   {
					  randomise();
					  sprite_index = choose(spr_player_kungfu1,spr_player_kungfu2,spr_player_kungfu3);
					  state = states.punch;
				   }
				   else
