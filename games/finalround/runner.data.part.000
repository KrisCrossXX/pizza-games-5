			if(compile_gml_compile_args_proc(l_actions,[l__g[2],l__g[3],l__g[4],l__g[5]]))return true;
			ds_list_add(l_actions,gml_action_index2d_set(l__g[1]));
			break;
		case gml_node.raw_id2d_set:
			if(compile_gml_compile_args_proc(l_actions,[l__g[2],l__g[3],l__g[4],l__g[5]]))return true;
			ds_list_add(l_actions,gml_action_index2d_set(l__g[1]));
