}␀à␀␀function scr_playerD_pogo()
{
	move = key_left + key_right;
	var maxpogospeed = 10;
	if move == 0 && hsp != 0
		hsp = xscale * movespeed;
	else
		hsp = move * movespeed;
	if move != 0 && !scr_solid(x, y + 1)
	{
		if movespeed < 6
			movespeed += 0.5;
	}
	if move != xscale || move == 0 || place_meeting(x + xscale, y, obj_solid)
	{
		movespeed = 0;
		pogospeed = 6;
	}
	if sign(hsp) != 0
		xscale = sign(hsp);
	else if move != 0
		xscale = move;
	if move != xscale
		pogospeed = 6;
	if grounded && sprite_index != spr_playerD_pogobounce && sprite_index != spr_playerD_pogobouncemach
	{
		pogospeedprev = false;
		image_index = 0;
		movespeed = 0;
		vsp = 0;
		if pogochargeactive
			sprite_index = spr_playerD_pogobouncemach;
		else
			sprite_index = spr_playerD_pogobounce;
		create_particle(x, y, particle.landcloud, 0);
		fmod_event_one_shot_3d("event:/sfx/noise/pogo", x, y);
	}
	if floor(image_index) == 1 && pogospeedprev == 0 && (sprite_index == spr_playerD_pogobounce || sprite_index == spr_playerD_pogobouncemach)
	{
		if key_up && move == 0
			vsp = -14;
		else if key_up && move != 0
			vsp = -10;
		else
			vsp = -6;
		if move == -xscale && movespeed > 0
			pogospeed = 6;
		if move == xscale && movespeed < 12 && pogospeed < maxpogospeed
			pogospeed += 1;
		movespeed = pogospeed;
		pogospeedprev = true;
	}
	if anim_end() && (sprite_index == spr_playerD_pogobounce || sprite_index == spr_playerD_pogofallmach || sprite_index == spr_playerD_pogobouncemach || sprite_index == spr_playerN_pogostart)
	{
		if pogochargeactive
			sprite_index = spr_playerD_pogofallmach;
		else
			sprite_index = spr_playerD_pogofall;
	}
	if pogospeed >= maxpogospeed && !pogochargeactive
	{
		pogochargeactive = true;
		pogocharge = 100;
		flash = true;
	}
	if pogospeed >= maxpogospeed
		pogocharge = 100;
		
	// Doise Return To Mach
	if input_buffer_slap && sprite_index != spr_playerD_pogocrusherland
	{
		if !grounded
		{
			image_speed = 0.5;
			input_buffer_shoot = 0;
			if (move != 0)
				xscale = move;
			input_buffer_slap = 0;
			key_slap = false;
			key_slap2 = false;
			jumpstop = true;
			vsp = -5;
			state = states.mach2;
			movespeed = 11;
			sprite_index = spr_playerN_sidewayspin;
			image_index = 0;
			with (instance_create(x, y, obj_crazyrunothereffect))
				image_xscale = other.xscale;
			particle_set_scale(particle.jumpdust, xscale, 1);
			create_particle(x, y, particle.jumpdust, 0);
			return true;
		}
		else
		{
			image_speed = 0.5;
			input_buffer_shoot = 0;
			if move != 0
				xscale = move;
			input_buffer_slap = 0;
			key_slap = false;
			key_slap2 = false;
			jumpstop = true;
			vsp = -7;
			state = states.mach3;
			movespeed = 14;
			sprite_index = spr_playerD_mach3doublejump;
			image_index = 0;
			with instance_create(x, y, obj_crazyrunothereffect)
				image_xscale = other.xscale;
			particle_set_scale(particle.jumpdust, xscale, 1);
			create_particle(x, y, particle.jumpdust, 0);
			return true;
		}
	}
	
	// Pogo Smash Down
	if key_down && doisedoublejump
		scr_player_do_noisecrusher();
		
	// Doise Aftereffects when charged
	if pogochargeactive
	{
		if (punch_afterimage > 0)
			punch_afterimage--;
		else
		{
			punch_afterimage = 5;
			create_doise_afterimage(x, y, sprite_index, image_index, xscale);
		}
	}
	image_speed = 0.35;
	scr_dotaunt();
}␀␀␀␀~␀␀function scr_player_faceplant()
{
	image_speed = 0.55;
	hsp = xscale * movespeed;
	move = key_right + key_left;
	if (movespeed < 10 && grounded)
		movespeed += 0.5;
	else if (!grounded)
		movespeed = 10;
	if (place_meeting(x + hsp, y, obj_solid) && !place_meeting(x + hsp, y, obj_slope) && !place_meeting(x + hsp, y, obj_destructibles))
	{
		sprite_index = spr_hitwall;
		with (obj_camera)
		{
			shake_mag = 20;
			shake_mag_acc = 40 / room_speed;
		}
		hsp = 0;
		image_speed = 0.35;
		with (obj_baddie)
		{
			if (shakestun && point_in_camera(x, y, view_camera[0]) && grounded)
			{
				stun = true;
				alarm[0] = 200;
				ministun = false;
				vsp = -5;
				hsp = 0;
			}
		}
		flash = false;
		state = states.bump;
		hsp = -2.5;
		vsp = -3;
		mach2 = 0;
		image_index = 0;
		instance_create(x + 10, y + 10, obj_bumpeffect);
	}
	if (floor(image_index) == (image_number - 1) && !key_attack)
	{
		image_speed = 0.35;
		state = states.normal;
		grav = 0.5;
	}
	if (floor(image_index) == (image_number - 1) && key_attack)
	{
		image_speed = 0.35;
		state = states.mach2;
		grav = 0.5;
	}
	if (key_down && grounded && vsp > 0)
	{
		grav = 0.5;
		sprite_index = spr_crouchslip;
		machhitAnim = false;
		state = states.crouchslide;
		movespeed = 15;
	}
	if (!instance_exists(obj_dashcloud2) && grounded && movespeed > 5)
	{
		with (instance_create(x, y, obj_dashcloud2))
			image_xscale = other.xscale;
	}
}
␀␀š␀␀␀function scr_player_hook()
{
