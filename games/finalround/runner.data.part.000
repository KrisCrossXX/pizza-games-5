				vsp = -12
			var _changemovespeed = false
			if movespeed < 0
			{
				if movespeed > -13
					_changemovespeed = true
			}
			if movespeed > 0
			{
				if movespeed < 13
					_changemovespeed = true
			}
			if _changemovespeed
				movespeed = 13*xscale
			else
				movespeed = movespeed*xscale
			sprite_index = spr_playerM_rolling;
