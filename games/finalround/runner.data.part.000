# FINAL ROUND START
# -----------------

# ---- PEPPERMAN TUTORIAL ----
tutorial1M = "Hold [M] to instantly begin to Mach Run! You can do this in the air too!"
tutorial2M = "When you hold [M] and then jump on a wall, you will bounce up. Holding [J] and then touching the wall again will make you bounce again! If you press [G] while air rolling then you will cancel it into a horizontal knee move!"
tutorial3M = "When you press [D] mid-air while Mach Running, you will cancel into a Ground Pound!"
tutorial4M = "Sometimes there will be tight spaces for Pepperman, if you ground pound and press [G] when you land, Pepperman will begin a Shoulder Slide!"
tutorial5M = "If you press [G] mid-air, then you will start rolling, completely skipping the ground pound jump part of the move!"
tutorial6M = "To perform a Super Jump, you must ground pound and hold [D], and then let go of [D] when you start flashing! You can also cancel out of flashing if you press [G]"

