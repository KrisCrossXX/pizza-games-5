function gml_seek_calls_proc(l_q,l_st){
	// gml_seek_calls_proc(q:ast_GmlNode, st:ast_GmlNodeList)->bool
	/// @ignore
	var l_n,l_s;
	var l__g=l_q;
	if(l__g[0]==23){
		var l_d=l__g[1];
		var l_x=l__g[2];
