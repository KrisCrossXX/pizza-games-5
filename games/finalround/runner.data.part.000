{
	case 0:
		hsp = 0;
		vsp = 0;
		if (floor(image_index) == image_number - 1)
		{
			fmod_event_one_shot_3d("event:/sfx/pep/step", x, y);
			image_index = image_number - 1;
			introbuffer = 120;
			introstate++;
		}
		break;
	
	case 1:
		image_index = image_number - 1;
		if introbuffer > 0
			introbuffer--;
		else
		{
			keyshot = false;
			sprite_index = spr_pizzahead_phase3_intro2;
			image_index = 0;
			introstate++;
		}
		break;
	
	case 2:
		if (floor(image_index) >= 21 && !keyshot)
		{
			keyshot = true;
			fmod_event_one_shot("event:/sfx/pizzahead/recover");
		}
		if (floor(image_index) >= 50 && sprite_index != spr_player_gnomecutscene1)
			image_xscale = -1;
		else if (floor(image_index) >= 2 && sprite_index != spr_player_gnomecutscene1)
		{
			with obj_player1
			{
				if sprite_index != spr_player_gnomecutscene2 && character == "P"
				{
					sprite_index = spr_player_gnomecutscene2;
					image_index = 0;
				}
				else if (character == "P" && floor(image_index) == image_number - 1)
					image_index = image_number - 1;
			}
		}
		if (floor(image_index) >= 49)
		{
			introstate++;
			sprite_index = spr_pizzahead_giddy;
			image_xscale = 1;
		}
		break;
	
	case 3:
		with obj_player1
		{
			if (character == "P" && floor(image_index) == image_number - 1)
				image_index = image_number - 1;
		}
