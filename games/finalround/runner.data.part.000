		golfid = noone;
		playerid = noone;
	}
	var tx = x;
	var ty = y;
	var ix = floor(image_index);
	if (ix < 6)
	{
		tx = x + (36 * image_xscale);
		ty = y - 14;
	}
	else if (ix == 6)
	{
		tx = x + (30 * image_xscale);
		ty = y - 17;
	}
	else if (ix == 7)
	{
		tx = x + (19 * image_xscale);
		ty = y - 19;
	}
	else if (ix == 8)
	{
		tx = x + (15 * image_xscale);
		ty = y - 18;
	}
	else if (ix == 9)
	{
		tx = x - (9 * image_xscale);
		ty = y - 16;
	}
	else if (ix == 10)
	{
		tx = x - (30 * image_xscale);
		ty = y - 20;
	}
	else if (ix == 11)
	{
		tx = x - (38 * image_xscale);
		ty = y - 36;
	}
	else if (ix == 12)
	{
		tx = x - (70 * image_xscale);
		ty = y - 50;
	}
	else if (ix < 17)
	{
		tx = x - (67 * image_xscale);
		ty = y - 50;
	}
	else if (ix == 17)
	{
		tx = x + (27 * image_xscale);
		ty = y - 26;
	}
	if (!shot)
	{
		if (!pizzaball)
		{
			with (playerid)
			{
				xscale = other.image_xscale;
				movespeed = 0;
				hsp = 0;
				vsp = 0;
				state = states.actor;
				jumpstop = true;
				x = lerp(x, tx, 0.2);
				y = lerp(y, ty, 0.2);
			}
		}
		else
		{
			with (golfid)
			{
				depth = -14;
				image_xscale = other.image_xscale;
				x = lerp(x, tx, 0.2);
				y = lerp(y, ty, 0.2);
				hsp = 0;
				vsp = -grav;
				hsp_carry = 0;
				vsp_carry = 0;
				invincible = true;
			}
		}
	}
	if (floor(image_index) >= 15 && !shot)
	{
		shot = true;
