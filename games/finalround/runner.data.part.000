	if (!grounded && place_meeting(x + sign(hsp), y, obj_climbablewall) && !place_meeting(x + sign(hsp), y, obj_destructibles) && !place_meeting(x + sign(hsp), y, obj_metalblock))
	{
		var _climb = true;
		if character == "N" || character == "D"
			_climb = ledge_bump(32);
