						other.hub_array[other.selected][0] = true;
						ini_open_from_string(obj_savesystem.ini_str);
						ini_write_real("CoinCount", "coin", global.coin_count)
						ini_write_real("Unlocks", string(other.hub_array[other.selected][1]), other.hub_array[other.selected][0]);
						global.coin_count = ini_read_real("CoinCount", "coin", 0); 
						obj_savesystem.ini_str = ini_close();
						gamesave_async_save();
					}
				}
				else
				fmod_event_one_shot("event:/sfx/ui/select");
			}
			if (playerid.key_slap)
				{
					state = states.normal;
					with (obj_player)
						state = states.normal;
				}
		}
		break;
}

