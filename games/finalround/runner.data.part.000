			} else return 1;
		} else return l_th.h_proc_error2("Trying to call invalid script index "+gml_value_print(l_v1),l_act);
	} else return l_th.h_proc_error2("Script index must be a number, got "+gml_value_dump(l_v1),l_act);
}

