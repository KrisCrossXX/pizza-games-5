	key_jump2 = tdp_input_get("player2_jump").held || tdp_input_get("player2_jumpC").held;
	key_jump3 = tdp_input_get("player2_jump").released || tdp_input_get("player2_jumpC").released;
	key_slap = tdp_input_get("player2_slap").held || tdp_input_get("player2_slapC").held;
