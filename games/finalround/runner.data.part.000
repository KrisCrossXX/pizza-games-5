}␀␀ë␀␀function scr_lang_load_init()
{
    var lang;
    
    lang = ds_map_find_value(global.lang_available, global.option_lang);
    
    if (is_undefined(lang))
    {
        global.option_lang = "en";
        lang = ds_map_find_value(global.lang_available, global.option_lang);
    }
    
    ds_queue_enqueue(global.lang_to_load, lang.file);
    ds_list_clear(global.lang_textures_to_load);
    global.lang_tex_max = 0;
}

function lang_load_fonts(language)
{
    var lang;
    
    lang = ds_map_find_value(global.lang_map, language);
    
    if (ds_map_find_value(lang, "custom_fonts"))
    {
        ds_map_set(global.font_map, concat("tutorialfont_", language), lang_get_custom_font("tutorialfont", lang));
        ds_map_set(global.font_map, concat("creditsfont_", language), lang_get_custom_font("creditsfont", lang));
        ds_map_set(global.font_map, concat("bigfont_", language), lang_get_custom_font("bigfont", lang));
        ds_map_set(global.font_map, concat("smallfont_", language), lang_get_custom_font("smallfont", lang));
        ds_map_set(global.font_map, concat("captionfont_", language), lang_get_custom_font("captionfont", lang));
    }
}

function lang_unload_font(language)
{
    var lang;
    
    lang = ds_map_find_value(global.lang_map, language);
    
    if (ds_map_find_value(lang, "custom_fonts"))
    {
        font_delete(ds_map_find_value(global.font_map, concat("tutorialfont_", language)));
        font_delete(ds_map_find_value(global.font_map, concat("creditsfont_", language)));
        font_delete(ds_map_find_value(global.font_map, concat("bigfont_", language)));
        font_delete(ds_map_find_value(global.font_map, concat("smallfont_", language)));
        font_delete(ds_map_find_value(global.font_map, concat("captionfont_", language)));
    }
}

function scr_lang_load_update()
{
    var lang, sprites, textures_to_offload, key, size, i, sprite, j, frame, tex, spr, name, filename;
    
    if (global.offload_lang != -4 && global.offload_lang != "en")
    {
        lang = ds_map_find_value(global.lang_map, global.offload_lang);
        
        if (lang_get_value_raw(global.offload_lang, "custom_graphics"))
        {
            sprites = ds_map_find_value(global.lang_sprite_map, global.offload_lang);
            textures_to_offload = ds_list_create();
            key = ds_map_find_first(sprites);
            size = ds_map_size(sprites);
            
            for (i = 0; i < size; i++)
            {
                sprite = ds_map_find_value(sprites, key);

				if (!ds_list_find_index(textures_to_offload, $"{global.offload_lang}/{sprite.name}.png"))
                        ds_list_add(textures_to_offload, $"{global.offload_lang}/{sprite.name}.png");
                
                key = ds_map_find_next(sprites, key);
            }
            
            for (i = 0; i < ds_list_size(textures_to_offload); i++)
            {
                tex = ds_list_find_value(textures_to_offload, i);
                spr = lang_get_texture(tex);
                sprite_delete(spr);
                ds_map_delete(global.lang_texture_map, tex);
            }
            
            ds_list_destroy(textures_to_offload);
        }
        
        global.offload_lang = -4;
    }
    
    if (ds_queue_size(global.lang_to_load) > 0)
    {
        lang_parse_file(ds_queue_dequeue(global.lang_to_load));
    }
    else if (ds_list_size(global.lang_textures_to_load) > 0)
    {
        lang_tex--;
        name = ds_list_find_value(global.lang_textures_to_load, 0);
        
        if (is_undefined(ds_map_find_value(global.lang_texture_map, name)))
        {
            filename = concat("lang/graphics/", name);
            ds_map_set(global.lang_texture_map, name, sprite_add(filename, 1, false, false, 0, 0));
        }
        
        ds_list_delete(global.lang_textures_to_load, 0);
    }
    else
    {
        global.lang = global.option_lang;
        
        if (variable_global_exists("font_map"))
            lang_load_fonts(global.lang);
        
        return false;
    }
    
    return true;
}
␀İ
␀␀function scr_player_shrink()
{
	mask_index = spr_pepperman_maskcrouch;
	buffer = false;
	image_speed = abs(movespeed) / 4;
	if (image_speed < 0.35)
		image_speed = 0.35;
	if (image_speed > 0.85)
		image_speed = 0.85;
	hsp = movespeed;
	move = key_right + key_left;
	if (sprite_index == spr_pepperman_ministart && floor(image_index) == (image_number - 1))
		sprite_index = spr_pepperman_miniidle;
	if (move != 0)
	{
		if (move == xscale)
			movespeed = Approach(movespeed, xscale * 8, 0.5);
		else
			movespeed = Approach(movespeed, 0, 0.5);
		if (movespeed <= 0)
			xscale = move;
	}
	else
		movespeed = Approach(movespeed, 0, 0.5);
	if (sprite_index == spr_player_barrelland && floor(image_index) == (image_number - 1))
		sprite_index = spr_pepperman_miniidle;
	if (sprite_index == spr_pepperman_miniidle && floor(image_index) == (image_number - 1))
		buffer = true;
		
	if (key_shoot2 && !scr_solid(x, y - 3))
	{
		sprite_index = spr_pepperman_miniend;
		state = states.normal
	}
	if (grounded)
	{
		if (sprite_index != spr_player_barrelland)
		{
			if (hsp != 0)
				sprite_index = spr_pepperman_minimove;
			else if (hsp == 0 && sprite_index != spr_pepperman_ministart)
				sprite_index = spr_pepperman_miniidle;
		}
		if (scr_slope() && hsp != 0)
		{
			with (instance_place(x, y + 1, obj_slope))
			{
				if (sign(image_xscale) == -sign(other.xscale))
					other.movespeed = Approach(other.movespeed, other.xscale * 12, 0.5);
			}
		}
		if (input_buffer_jump > 0 && !key_down && vsp > 0)
		{
			input_buffer_jump = 0;
			scr_fmod_soundeffect(jumpsnd, x, y);
			vsp = -8.5;
			if (move != xscale && move != 0)
			{
				if (sign(movespeed) == 1)
					xscale = move;
			}
			state = states.shrinkjump;
			sprite_index = spr_pepperman_minijump;
			image_index = 0;
			jumpstop = false;
			create_particle(x, y, particle.highjumpcloud1, 0);
		}
		if (key_attack && abs(movespeed) > 0)
		{
			movespeed = xscale * 7;
			fmod_event_one_shot_3d("event:/sfx/barrel/start", x, y);
			with (instance_create(x, y, obj_jumpdust))
				image_xscale = other.xscale;
			state = states.shrinkroll;
			sprite_index = spr_pepperman_miniroll;
			image_index = 0;
		}
	}
	else if (!grounded)
	{
		state = states.shrinkjump;
		sprite_index = spr_pepperman_minifall;
		image_index = 0;
		if (vsp < 0)
			sprite_index = spr_player_barreljump;
	}
	if (place_meeting(x + sign(hsp), y, obj_solid) && !place_meeting(x + sign(hsp), y, obj_slope))
	{
		//movespeed = 0;
		if (sprite_index == spr_pepperman_minimove)
			sprite_index = spr_pepperman_miniidle;
	}
	if (sprite_index == spr_pepperman_minimove)
	{
		if (steppybuffer > 0)
			steppybuffer--;
		else
		{
			create_particle(x, y + 43, particle.cloudeffect, 0);
			steppybuffer = 14;
			fmod_event_one_shot_3d("event:/sfx/pep/step", x, y);
		}
	}
}
␀␀␀?␀␀function scr_drawtv()
{
	var collect_x = irandom_range(-collect_shake, collect_shake);
	var collect_y = irandom_range(-collect_shake, collect_shake);

	var _cx = tv_x + combo_posX;
	var _cy = tv_y + 117 + hud_posY + combo_posY;
	
	var _perc = global.combotime / 60;
	var _minX = _cx - 56;
	var _maxX = _cx + 59;
	
	combofill_x = lerp(combofill_x, _minX + ((_maxX - _minX) * _perc), 0.5);
	combofill_y = _cy;

	var _combofillperc = (1 / _perc)
	var theroomname = room_get_name(room)

	shader_set(global.Pal_Shader);

	//Combo Text & Numbers Palettes
	var chara = playerid.character, combopalette = 0;
	if chara == "N"
		combopalette = 1;
	else if chara == "D"
		combopalette = 2;
	else if chara == "M"
		combopalette = 3;
	else if chara == "V"
		combopalette = 4;
	else if chara == "FP"
		combopalette = 5;
	else if chara == "NS"
		combopalette = 6;
	else if chara == "S"
		combopalette =7;
	
	pal_swap_set(spr_tv_combofillpalette, (!global.combodropped && global.prank_enemykilled) ? 2 : 1, false);
	draw_sprite(spr_combobubblefill, combofill_index, combofill_x, combofill_y);

	pal_swap_set(spr_tv_combopalette, combopalette, false);
	draw_sprite(spr_tv_combobubble, bubble_index, _cx, _cy);
	lang_draw_sprite(spr_tv_combobubbletextEN, -1, _cx, _cy);

	draw_set_font(global.combofont2);
	draw_set_halign(fa_left);
	draw_set_valign(fa_top);
	var _tx = _cx - 64;
	var _ty = _cy - 12;
	var _str = string(visualcombo);
	var num = string_length(_str);
	for (var i = num; i > 0; i--)
	{
		var char = string_char_at(_str, i);
		draw_text(_tx, _ty, char);
		_tx -= 22;
		_ty -= 8;
	}

	if (room != strongcold_endscreen)
	{
		chara = playerid.character;
	
		draw_sprite_ext(bgtv, tv_bg_index, tv_x + collect_x, tv_y + collect_y + hud_posY, 1, 1, 0, c_white, alpha);
		pal_swap_set(playerid.spr_palette, 2, false); // placeholder code (lets see if this works graah)
	
		shader_set(global.Pal_Shader);
		pattern_set(global.Base_Pattern_Color, sprite_index, image_index, image_xscale, image_yscale, global.palettetexture);
	
		// Character Palettes and TV Sprites
		if (playerid.isgustavo && playerid.character != "G" || playerid.character == "G" && playerid.isstick)
			pal_swap_set(playerid.spr_ratmountpaletteplayer, playerid.paletteselect, false);
		else
			pal_swap_set(playerid.spr_palette, playerid.paletteselect, false);
		draw_sprite_ext(sprite_index, image_index, (tv_x + collect_x), tv_y + collect_y + hud_posY, 1, 1, 0, c_white, alpha);
		var _red = global.noisejetpack && (playerid.character != "N" && playerid.character != "D" || playerid.noisepizzapepper);
		if (_red)
		{
			pal_swap_set(playerid.spr_palette, 2, false);
			draw_sprite_ext(sprite_index, image_index, tv_x + collect_x, tv_y + collect_y + hud_posY, 1, 1, 0, c_white, alpha);
		}
	
		// player tv palettes
		var tv_palette = 0;
		switch chara
		{
			case "N":
				tv_palette = 1;
				break;
			case "D":
				tv_palette = 2;
				break;
			case "M":
				tv_palette = 3;
				break;
			case "V":
				tv_palette = 4;
				break;
			case "FP":
				tv_palette = 5;
				break;
			case "NS":
				tv_palette = 6;
				break;
			case "S":
				tv_palette = 7;
				break;
		}
	
		// tv palettes
		if tv_palette != 0 || halloween
		{
			pal_swap_set(spr_tv_palette, tv_palette, false);
			var spr = spr_empty;
			if (sprite_index == global.spr_opentv)
				spr = sprite_index;
			draw_sprite_ext(spr, image_index, tv_x + collect_x, tv_y + collect_y + hud_posY, 1, 1, 0, c_white, alpha);
		}
	
		// static
		if (state == states.tv_whitenoise)
		{
			pal_swap_set(spr_tv_palette, tv_palette, false);
			draw_sprite(whitenoisetvspr, tv_trans, (tv_x + collect_x), ((tv_y + collect_y) + hud_posY))
			if halloween
				draw_sprite_ext(spr_tv_emptyH, image_index, tv_x + collect_x, tv_y + collect_y + hud_posY, 1, 1, 0, c_white, alpha);
		}
		if (sprite_index == spr_tv_exprheatN)
		{
			pal_swap_set(playerid.spr_palette, playerid.paletteselect, false);
			draw_sprite_ext(sprite_index, image_index, tv_x + collect_x, tv_y + collect_y + hud_posY, 1, 1, 0, c_white, alpha);
			if (_red)
			{
				pal_swap_set(playerid.spr_palette, 2, false);
				draw_sprite_ext(sprite_index, image_index, tv_x + collect_x, tv_y + collect_y + hud_posY, 1, 1, 0, c_white, alpha);
			}
		}
		pattern_reset();
	}
	reset_shader_fix();
	if (global.panic)
	{
		var _fill = global.fill;
		var _currentbarpos = chunkmax - _fill;
		_perc = _currentbarpos / chunkmax;
		var _max_x = 299;
		var _barpos = _max_x * _perc;
		if (!surface_exists(bar_surface))
			bar_surface = surface_create(298, 30);
		var _barfillpos = floor(_barpos) + 13;
		if (_barfillpos > 0)
		{
			surface_resize(bar_surface, _barfillpos, 30);
			surface_set_target(bar_surface);
			draw_clear_alpha(0, 0);
			var clip_x = timer_x + 3;
			var clip_y = timer_y + 5;
			for (i = 0; i < 3; i++)
				draw_sprite(spr_timer_barfill, 0, barfill_x + (i * 173), 0);
			surface_reset_target();
			draw_surface(bar_surface, clip_x, clip_y);
		}
		draw_sprite(spr_timer_bar, -1, timer_x, timer_y);
		draw_sprite(johnface_sprite, johnface_index, timer_x + 13 + _barpos, timer_y + 20);
		var timerspr = pizzaface_sprite;
		if (timer_tower)
			timerspr = spr_timer_tower;
		draw_sprite(timerspr, pizzaface_index, timer_x + 320, timer_y + 10);
		var minutes = 0;
		var seconds;
		for (var seconds = ceil(global.fill / 12); seconds > 59; seconds -= 60)
			minutes++;
		if (seconds < 10)
			seconds = concat("0", seconds);
		else
			seconds = string(seconds);
		draw_set_halign(1);
		draw_set_valign(1);
		draw_set_font(global.bigfont);
		draw_text(timer_x + 153, timer_y + 14, concat(minutes, ":", seconds));
	}
	else if (surface_exists(bar_surface))
		surface_free(bar_surface);
	draw_set_halign(0);
	draw_set_valign(0);
}␀␀␀function scr_anybutton_pressed(gamepad)
{
	var _index = gamepad;
	if (keyboard_check_pressed(vk_anykey))
		return -1;
	else if (gamepad_is_connected(_index))
	{
		for (var i = gp_face1; i < gp_axisrv; i++)
		{
			if (gamepad_button_check_pressed(_index, i))
			{
				if (i == gp_face1 && instance_exists(obj_player1))
				{
					obj_player1.key_jump = true;
					obj_player1.key_jump2 = true;
				}
				return _index;
			}
		}
		var _threshold = 0.5;
		var _up = gamepad_axis_value(_index, gp_axislv) < -_threshold;
		var _right = gamepad_axis_value(_index, gp_axislh) > _threshold;
		var _left = gamepad_axis_value(_index, gp_axislh) < -_threshold;
		var _down = gamepad_axis_value(_index, gp_axislv) > _threshold;
		if (_up || _right || _left || _down)
			return _index;
	}
	return -2;
}
