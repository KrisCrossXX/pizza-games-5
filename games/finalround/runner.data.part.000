					create_particle(x, y, particle.genericpoofeffect);
					instance_destroy();
				}
				with (obj_brickball)
				{
					create_particle(x, y, particle.genericpoofeffect);
					instance_destroy();
				}
				
				// Lapping
				if (ds_list_find_index(global.saveroom, other.id) == -1)
				{
					if (global.laps >= 1 && global.fill > 12) 
					{
						if room == tower_entrancehall
							global.fillerup = global.fill + 1080;
						else
							global.fillerup = global.fill + 300;
					}
					addcollect(object_index, 3000);
					global.combotime = 60;
					with (instance_create(x, y, obj_smallnumber))
						number = string(3000);
				}
			}
		}
	}
	else if (playerid != noone && sprite_index == playerid.spr_player_pizzaportalenter)
	{
		with (playerid)
		{
			hsp = 0;
			vsp = 0;
			visible = false;
		}
		if global.coop
		{
			var _player = playerid.object_index == obj_player1 ? obj_player2 : obj_player1
			with _player
			{
				if state != states.actor
				{
					sprite_index = spr_rockethitwall;
					state = states.gotoplayer
				}
			}
		}
		if anim_end()
		{
			image_index = image_number - 1;
			image_speed = 0;
			if (!instance_exists(obj_fadeout))
			{
				with (obj_player)
				{
					targetDoor = "LAP";
					targetRoom = other.targetRoom;
				}
				for (var i = 0; i < ds_list_size(global.escaperoom); i++)
				{
					var b = ds_list_find_value(global.escaperoom, i);
					var q = ds_list_find_index(global.baddieroom, b);
					var t = false;
					if (q == -1)
					{
						q = ds_list_find_index(global.saveroom, b);
						t = true;
					}
					if (q != -1)
					{
						if (!t)
							ds_list_delete(global.baddieroom, q);
						else
							ds_list_delete(global.saveroom, q);
					}
				}
				global.laps++;
				global.lap = true;
				instance_create(0, 0, obj_fadeout);
				if !instance_exists(obj_pizzaface) && global.laps >= 2
					scr_pf_pieces();
			}
		}
	}
}
