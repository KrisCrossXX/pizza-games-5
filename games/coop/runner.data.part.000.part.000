}
function scr_vigilante_throwing()
{
	hsp = Approach(hsp, 0, 1);
	if throwbuffer > 0
		throwbuffer--;
	else if sprite_index != spr_playerV_dynamitethrow
	{
		if (!scr_vigilante_throw_cow())
			state = states.walk;
