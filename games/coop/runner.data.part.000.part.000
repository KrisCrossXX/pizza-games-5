␀␀␀␀c␀␀function scr_player_ridecow()
{
	doublejump = false;
	hsp = 0;
	vsp = 0;
	movespeed = 0;
	if (!instance_exists(cowID))
	{
		if has_mort
		{
			state = states.mortjump;
			sprite_index = spr_fall;
		}
		else
		{
			state = states.jump;
			sprite_index = spr_fall;
