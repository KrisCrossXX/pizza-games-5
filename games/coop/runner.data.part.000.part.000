			with obj_vigilanteboss
				duel_buffer = duel_max + irandom(duel_random);
		}
	}
}
function parry()
{
	var prevparried = parried;
	SUPER_parry();
	if prevparried != parried
	{
		image_xscale *= -1;
		dmg = 100;
		spd = 30;
	}
}
