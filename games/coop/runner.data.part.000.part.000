switch state
{
	case states.arenaintro:
		with obj_player
		{
			state = states.actor;
			xscale = (x > (room_width / 2)) ? -1 : 1;
			image_blend = make_colour_hsv(0, 0, 255);
		}
		with par_boss
		{
			state = states.actor;
			x = xstart;
		}
		if playerx != 0
			playerx += 5;
		else if !flashed
		{
			flash = true;
			flashed = true;
			alarm[2] = 0.15 * room_speed;
		}
		if (bossx != (room_width - sprite_get_width(bossspr)))
			bossx -= 5;
		if vsy != 0
			vsy += 5;
		flamey -= 4;
		if intro_buffer > 0
			intro_buffer--;
		else if use_countdown
			state = states.arenaround;
		else
		{
			state = states.normal;
			with obj_player
			{
				if (object_index != obj_player2 || global.coop)
