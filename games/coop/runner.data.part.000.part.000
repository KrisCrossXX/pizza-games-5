			image_index = image_number - 1;
		var _step = false;
		var mv = 2;
		if ix >= 0 && ix < 12
		{
			hsp = xscale * mv;
			_step = true;
		}
		else if ix >= 15 && ix < 27
		{
			hsp = -xscale * mv;
			_step = true;
		}
		if steppybuffer > 0
			steppybuffer--;
