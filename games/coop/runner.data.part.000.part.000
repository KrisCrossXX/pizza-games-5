	command,
	traced,
	error
}

depth = -500;
DEBUG = debug;
if (parameter_count() > 2)
	DEBUG = true;
if !DEBUG
{
	var n = parameter_count();
	for (var i = 0; i < n; i++)
	{
		var s = parameter_string(i);
		if (s == "-debug" || s == "debug")
			DEBUG = true;
	}
}
if !DEBUG
	instance_destroy();
if DEBUG
{
	active = false;
	showoverlay = false;
	SET_GAME_SPEED = new DebugCommand("SETGAMESPEED", "Sets the game speed", "<int>", function(int)
	{
