		state = states.bombkick;
		pistolcooldown = 50;
		machslideAnim = false;
		landAnim = false;
		jumpAnim = false;
		crouchslideAnim = false;
		crouchAnim = false;
		stompAnim = false;
		windingAnim = 0;
		bombthrow = false;
		jumpstop = true;
		if (_state == states.mach2 || _state == states.mach3)
			state = 0;
	}
