	{
		pizzapepper = 0;
		a = 0;
		if sprite_index == spr_player_supersidejump
			sprite_index = spr_player_supersidejumpland;
		if (sprite_index == spr_superjump || sprite_index == spr_superspringplayer)
			sprite_index = spr_superjumpland;
		with obj_camera
		{
			shake_mag = 10;
