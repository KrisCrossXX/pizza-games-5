	{
		xscale = move;
		if movespeed < 8
			movespeed += 0.5;
		else if (floor(movespeed) == 8)
			movespeed = 6;
		if movespeed < 3
			image_speed = 0.35;
		else if movespeed > 3 && movespeed < 6
