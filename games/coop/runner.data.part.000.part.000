			vsp = -6;
			state = states.cheesepeplaunch;
			sprite_index = spr_cheesepepjumpstart;
			image_index = 0;
		}
		else
		{
			state = states.cheesepep;
			sprite_index = spr_cheesepepintro;
			image_index = 0;
		}
	}
}
