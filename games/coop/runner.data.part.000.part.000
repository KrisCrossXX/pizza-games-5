		var p = get_triangle_points(0, tsh / 2, 0, 300, 24);
		gpu_set_blendmode(bm_subtract);
		draw_triangle_color(0, tsh / 2, p[0], p[1], p[2], p[3], c_white, c_white, c_white, false);
		surface_reset_target();
