	{
		input_buffer_jump = 0;
		state = states.shotgunjump;
		sprite_index = spr_shotgunjump;
		image_index = 0;
		jumpstop = false;
		vsp = -11;
	}
	if grounded && key_down
	{
		state = states.shotguncrouch;
		sprite_index = spr_shotgungoduck;
		image_index = 0;
