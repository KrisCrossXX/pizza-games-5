			bg.vspeed = -6;
		}
		break;
	case 9:
		peppinopizza.x = irandom_range(-1, 1);
		peppinopizza.y = irandom_range(-1, 1);
		if _switch
		{
			scene++;
			with (instance_create(0, 0, obj_genericfade))
