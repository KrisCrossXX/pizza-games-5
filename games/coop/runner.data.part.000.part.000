	if (floor(image_index) == image_number - 1 && sprite_index == spr_knightpepland)
	{
		sprite_index = spr_knightpepidle;
		knightmomentum = 0;
	}
	if move != 0 && grounded
		xscale = move;
	if grounded
	{
		doublejump = false;
		if move != 0
		{
			if movespeed < 6
				movespeed += 0.5;
			else if movespeed == 6
