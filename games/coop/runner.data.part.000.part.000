		val = 90;
	global.input_controller_deadzone = val / 100;
	trace(val / 100);
	set_controller_config();
}).value = (global.input_controller_deadzone * 100);

add_option_slide(deadzones_menu, 2, "option_deadzone_h", function(val)
{
