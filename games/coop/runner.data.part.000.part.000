		break;
	case 10:
		if _switch && !obj_genericfade.fadein
		{
			instance_destroy(obj_introprop);
			peppino = instance_create(-130, 386, obj_playerprop);
			peppino.alarm[0] = 1;
			peppino.fake_hsp = 12;
