				vsp += grav;
		}
		else
		{
			depth = -99;
			x = Approach(x, obj_pizzafaceboss_p2.x, cbspeed);
			y = Approach(y, obj_pizzafaceboss_p2.y, cbspeed);
			cbspeed = Approach(cbspeed, 20, 1);
		}
		break;
}
