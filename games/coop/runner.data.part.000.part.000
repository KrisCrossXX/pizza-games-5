␀S␀␀function cutscene_move_actor(obj, xto, yto, amount)
{
	var _obj = obj;
	var xx = xto;
	var yy = yto;
	var interp = amount;
	var finish = false;
	with _obj
	{
		x = lerp(x, xx, interp);
		y = lerp(y, yy, interp);
		if (x > (xx - 6) && x < (xx + 6) && y > (yy - 6) && y < (yy + 6))
			finish = true;
	}
	if finish
		cutscene_end_action();
}
