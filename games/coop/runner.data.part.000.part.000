		{
			create_particle(x, y + 43, particle.cloudeffect, 0);
			steppybuffer = 12;
			fmod_event_one_shot_3d("event:/sfx/pep/step", x, y);
		}
		image_speed = 0.35;
	}
	else if key_down && hooked == 0
	{
		sprite_index = spr_ladderdown;
		vsp = 10;
		image_speed = -0.35;
	}
	else
	{
		sprite_index = spr_Ladder;
		vsp = 0;
	}
