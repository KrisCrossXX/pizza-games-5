␀␀␀:␀␀function scr_player_mortattack()
{
	image_speed = 0.45;
	hsp = movespeed;
	if !ispeppino
	{
		if (instance_exists(mortprojectileID) && instance_exists(mortprojectileID.target) && mortprojectileID.target.object_index == obj_morthook)
		{
			targethsp = Approach(targethsp, 0, 0.8);
			targetvsp = Approach(targetvsp, 0, 0.8);
			hsp = targethsp;
			vsp = targetvsp;
		}
		else
		{
			vsp -= 0.2;
			move = key_left + key_right;
			if move != 0
				movespeed = Approach(movespeed, move * 4, 0.1);
		}
		if floor(image_index) == image_number - 1
			image_index = image_number - 1;
	}
	if ((ispeppino && floor(image_index) == image_number - 1) || (!ispeppino && !instance_exists(mortprojectileID)))
	{
		if grounded && vsp > 0
		{
			state = states.mort;
			sprite_index = spr_playermortidle;
			landAnim = false;
		}
		else
		{
			state = states.mortjump;
			sprite_index = spr_playermortjump;
		}
	}
	if punch_afterimage > 0
		punch_afterimage--;
	else
	{
		punch_afterimage = 5;
		with (create_mach3effect(x, y, sprite_index, image_index, true))
			image_xscale = other.xscale;
	}
}
␀␀a␀␀function scr_enemy_pizzaheadjump()
{
	stompable = false;
	if (place_meeting(x, y, obj_solid))
		vsp = -12;
	if vsp < 0
	{
		use_collision = false;
		x += hsp;
		y += vsp;
		if vsp < 20
			vsp += grav;
	}
	else
		use_collision = true;
	sprite_index = stunfallspr;
	if grounded && vsp > 0
	{
		stompable = true;
		state = states.stun;
		stunned = 2;
	}
}
␀␀␀È␀␀function scr_player_gotoplayer()
{
	pogochargeactive = false;
	movespeed = 0;
	visible = false;
	if (!instance_exists(obj_coopplayerfollow))
	{
		playerid = (object_index == obj_player2) ? obj_player1 : obj_player2;
		var _dir = point_direction(x, y, playerid.x, playerid.y);
		hsp = lengthdir_x(16, _dir);
		vsp = lengthdir_y(16, _dir);
		var t = 16;
		repeat 8
			create_particle(x + irandom_range(-t, t), y + irandom_range(-t, t), particle.cloudeffect, 0);
		if (distance_to_object(playerid) < 16)
		{
			create_particle(x, y, particle.genericpoofeffect, 0);
			instance_create_unique(playerid.x, playerid.y, obj_coopplayerfollow);
		}
	}
	else
	{
		x = playerid.x;
		y = playerid.y;
		if key_jump2
		{
			xscale = playerid.xscale;
			state = states.normal;
			input_buffer_jump = 0;
			hurted = true;
			alarm[5] = 2;
			alarm[7] = 60;
			create_particle(x, y, particle.genericpoofeffect, 0);
			visible = true;
			instance_destroy(obj_coopplayerfollow);
		}
	}
}
