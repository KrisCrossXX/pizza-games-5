			peppino.image_speed = 0.5;
			pizzaface = instance_create(-130, 200, obj_introprop);
			pizzaface.sprite_index = spr_pizzaface;
			pizzaface.image_speed = 0.35;
			scene++;
			scenebuffer = 170;
