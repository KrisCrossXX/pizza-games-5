			layer_set_visible("Backgrounds_6", true);
		}
		break;
	case 11:
		peppino.x += 1.5;
		pizzaface.x += 2.5;
		pizzaface.y = Wave(pizzaface.ystart - 30, pizzaface.ystart + 30, 3, 10);
		if _switch
		{
			scene++;
			scenebuffer = 180;
			instance_destroy(obj_introprop);
			peppino = instance_create(-50, 100, obj_introprop);
